{
	"buildCommand": "pnpm build",
	"outputDirectory": "dist",
	"framework": "astro",
	"devCommand": "pnpm run dev",
	"installCommand": "pnpm install",
	"regions": ["iad1"],
	"redirects": [
		{
			"source": "/red-carpet",
			"destination": "/portraits",
			"permanent": true
		},
		{
			"source": "/red-carpet/:path*",
			"destination": "/portraits/:path*",
			"permanent": true
		}
	],
	"rewrites": [
		{
			"source": "/(.*)",
			"destination": "/$1"
		}
	],
	"headers": [
		{
			"source": "/photos/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		},
		{
			"source": "/(.*).jpg",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		},
		{
			"source": "/(.*).webp",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		}
	]
}
