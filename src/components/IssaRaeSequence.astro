---
import { Image } from 'astro:assets';
import PhotoSwipeLightbox from './PortfolioLightbox.astro';
import smile from '../assets/issa-rae-sequence/issa-rae_tiff_2026_04162.jpg';
import laugh from '../assets/issa-rae-sequence/issa-rae_tiff_2026_04163.jpg';
import headBack from '../assets/issa-rae-sequence/issa-rae_tiff_2026_04164.jpg';
import fullLaugh from '../assets/issa-rae-sequence/issa-rae_tiff_2026_04165.jpg';

const photos = [
	{ image: smile, alt: 'Issa Rae smiling at the Toronto International Film Festival in 2026' },
	{
		image: laugh,
		alt: 'Issa Rae beginning to laugh at the Toronto International Film Festival in 2026',
	},
	{
		image: headBack,
		alt: 'Issa Rae laughing with her head tilted back at the Toronto International Film Festival in 2026',
	},
	{
		image: fullLaugh,
		alt: 'Issa Rae laughing with her eyes closed at the Toronto International Film Festival in 2026',
	},
];
const caption =
	'Issa Rae at the Toronto International Film Festival world premiere of Babies in 2026.';
---

<figure class="portrait-sequence" id="issa-rae-sequence" aria-label="Issa Rae at TIFF 2026">
	<div
		class="sequence-strip"
		id="issa-rae-sequence-gallery"
		tabindex="0"
		aria-label="Four photographs of Issa Rae, from smile to laughter"
	>
		{
			photos.map(({ image, alt }) => (
				<a
					href={image.src}
					data-pswp-item="true"
					data-full-src={image.src}
					data-pswp-width={image.width}
					data-pswp-height={image.height}
					data-pswp-caption={caption}
					data-exhibition-thumb={image.src}
					data-exhibition-person="/red-carpet/issa-rae"
					data-exhibition-person-label="Issa Rae"
					aria-label={`${alt} — view full size`}
				>
					<Image
						src={image}
						alt={alt}
						widths={[400, 640, 960, 1440]}
						sizes="(max-width: 820px) 78vw, 25vw"
						format="webp"
						loading="lazy"
					/>
				</a>
			))
		}
	</div>
	<figcaption>
		<a href="/red-carpet/issa-rae"
			>Issa Rae at the Toronto International Film Festival premiere of Babies</a
		><span>Toronto International Film Festival · 2026</span>
	</figcaption>
</figure>

<PhotoSwipeLightbox
	gallerySelector="#issa-rae-sequence-gallery"
	childrenSelector="a[data-pswp-item]"
	options={{
		escKey: true,
		wheelToZoom: true,
		showHideAnimationType: 'zoom',
		mainClass: 'pswp--kinetic-editorial',
		bgOpacity: 0.28,
	}}
/>

<style>
	.portrait-sequence {
		margin: 0;
		padding: 0 clamp(12px, 2.1vw, 36px) clamp(70px, 8vw, 120px);
	}
	.sequence-strip {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: clamp(4px, 0.6vw, 10px);
	}
	.sequence-strip a {
		display: block;
		min-width: 0;
	}
	.sequence-strip img {
		display: block;
		width: 100%;
		height: auto;
	}
	.sequence-strip a:focus-visible,
	.sequence-strip:focus-visible {
		outline: 3px solid var(--portfolio-red);
		outline-offset: 4px;
	}
	figcaption {
		display: flex;
		justify-content: space-between;
		gap: 12px;
		margin-top: 16px;
		font-size: 12px;
		line-height: 1.5;
	}
	figcaption a {
		color: inherit;
		text-decoration: none;
	}
	figcaption a:hover,
	figcaption a:focus-visible {
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	figcaption span {
		color: var(--muted);
	}
	@media (max-width: 820px) {
		.sequence-strip {
			display: flex;
			overflow-x: auto;
			scroll-snap-type: x mandatory;
			gap: 8px;
			padding-bottom: 12px;
		}
		.sequence-strip a {
			flex: 0 0 82%;
			scroll-snap-align: start;
		}
		figcaption {
			flex-direction: column;
			gap: 2px;
			margin-top: 10px;
		}
	}
</style>
