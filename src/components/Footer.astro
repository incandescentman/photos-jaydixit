---
import siteConfig from '../../site.config.mts';
import SocialIcon from './SocialIcon.astro';

const year = new Date().getFullYear();
const owner = siteConfig.owner;
const socialLinks = siteConfig.socialLinks;
---

<footer class="site-footer">
	<div class="site-footer-inner">
		<p class="site-footer-copy">
			© {year}
			{owner}. All rights reserved.
		</p>

		<div class="site-footer-social" aria-label="Social links">
			{socialLinks.map((socialLink) => <SocialIcon socialLink={socialLink} frameSize={36} />)}
		</div>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: auto;
		padding: 3rem 0;
		background: var(--paper-deep);
		border-top: 1px solid var(--hairline);
	}

	.site-footer-inner {
		max-width: 80rem;
		margin: 0 auto;
		padding: 0 2rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
	}

	.site-footer-copy {
		margin: 0;
		font-family: var(--sans);
		font-size: 0.78rem;
		font-weight: 500;
		letter-spacing: 0.04em;
		color: var(--muted);
	}

	.site-footer-social {
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}

	@media (max-width: 640px) {
		.site-footer {
			padding: 2.5rem 0;
		}

		.site-footer-inner {
			flex-direction: column;
			justify-content: center;
			text-align: center;
			padding: 0 1.25rem;
		}
	}
</style>
