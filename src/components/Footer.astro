---
import { ArrowUpRight } from '@lucide/astro';
import siteConfig from '../../site.config.mts';
import SiteLinks from './SiteLinks.astro';

const year = new Date().getFullYear();
const owner = siteConfig.owner;
const instagram = siteConfig.socialLinks.find((link) => link.name === 'Instagram');
---

<footer class="site-footer">
	<div class="site-footer-inner">
		<SiteLinks />
		<div class="site-footer-utility">
			<p class="site-footer-copy">
				© {year}
				{owner}. All rights reserved.
			</p>
			{
				instagram && (
					<a class="site-footer-instagram" href={instagram.url}>
						Instagram <ArrowUpRight size={14} strokeWidth={1.5} aria-hidden="true" />
					</a>
				)
			}
		</div>
	</div>
</footer>

<style>
	.site-footer {
		--muted: #756e64;
		margin-top: auto;
		padding: 3rem 0;
		background: var(--paper-deep);
		border-top: 1px solid var(--hairline);
	}

	.site-footer-inner {
		max-width: 80rem;
		margin: 0 auto;
		padding: 0 2rem;
	}

	.site-footer-utility {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 1.5rem;
		padding-top: 1.25rem;
	}

	.site-footer-copy {
		margin: 0;
		font-family: var(--sans);
		font-size: 0.78rem;
		font-weight: 500;
		letter-spacing: 0.04em;
		color: var(--muted);
	}

	.site-footer-instagram {
		display: inline-flex;
		align-items: center;
		gap: 0.2rem;
		font-family: var(--sans);
		font-size: 0.78rem;
		color: var(--muted);
		text-decoration: none;
	}
	.site-footer-instagram:hover {
		color: var(--portfolio-red);
	}
	.site-footer-instagram:focus-visible {
		outline: 2px solid var(--portfolio-red);
		outline-offset: 4px;
	}

	@media (max-width: 640px) {
		.site-footer {
			padding: 2.5rem 0;
		}

		.site-footer-inner {
			padding: 0 1.25rem;
		}
		.site-footer-utility {
			flex-wrap: wrap;
			justify-content: center;
			text-align: center;
		}
	}
</style>
