---
import { Image, getImage } from 'astro:assets';
import PhotoSwipeLightbox from './PhotoSwipeLightbox.astro';
import type { Image as ImageType } from '../data/galleryData';

interface Props {
	images: ImageType[];
}

const { images } = Astro.props;
const imagesWithLightbox = await Promise.all(
	images.map(async (image) => {
		const lightboxWidth = Math.min(image.src.width, 3000);
		const lightboxImage = await getImage({
			src: image.src,
			width: lightboxWidth,
			inferSize: true,
		});

		return {
			...image,
			lightboxHref: lightboxImage.src,
			lightboxWidth: image.src.width,
			lightboxHeight: image.src.height,
			lightboxCaption: image.description || image.title,
		};
	}),
);
---

<section id="photo-grid" class="relative w-full mx-auto overflow-hidden">
	{
		imagesWithLightbox.map((image) => (
			<a
				href={image.lightboxHref}
				class="photo-item portfolio-lightbox absolute transition-transform hover:scale-[1.02] hover:z-10"
				data-pswp-item="true"
				data-pswp-width={image.lightboxWidth}
				data-pswp-height={image.lightboxHeight}
				data-pswp-caption={image.lightboxCaption}
				data-cropped="true"
			>
				<Image
					src={image.src}
					quality={90}
					format="webp"
					width={image.src.width}
					height={image.src.height}
					class="w-full h-full object-cover rounded-sm shadow-sm hover:shadow-lg transition-shadow"
					alt={image.title}
				/>
			</a>
		))
	}
</section>

<PhotoSwipeLightbox gallerySelector="#photo-grid" childrenSelector="a[data-pswp-item]" />

<script>
	import '../scripts/photo-grid';
</script>
