---
const publications = [
	'The New York Times',
	'Rolling Stone',
	'The Washington Post',
	'Wired',
	'Harvard Business Review',
	'Psychology Today',
];

const institutions = ['Wikipedia', 'WikiPortraits', 'Yale', 'OpenAI', 'TIFF', 'The Nobel Prize'];
---

<section class="py-24 bg-[#faf8f4]">
	<div class="max-w-7xl mx-auto px-6">
		<div class="max-w-3xl mx-auto text-center mb-14">
			<p class="text-xs uppercase tracking-[0.26em] text-neutral-500 font-semibold mb-3">
				Recognition
			</p>
			<h2 class="text-4xl md:text-5xl font-bold text-neutral-900 mb-5">
				Selected publications, institutions, and festivals
			</h2>
			<p class="text-lg text-neutral-700 leading-relaxed font-sans">
				My work spans photography, writing, teaching, and AI education.
			</p>
		</div>

		<div class="grid gap-8 lg:grid-cols-2">
			<section
				class="rounded-[2rem] border border-neutral-200 bg-white p-8 shadow-[0_25px_60px_-40px_rgba(15,23,42,0.45)]"
			>
				<h3 class="text-2xl font-bold text-neutral-900 mb-2">Featured In</h3>
				<p class="text-sm uppercase tracking-[0.18em] text-neutral-500 font-semibold mb-6">
					Writing and editorial work
				</p>
				<ul class="space-y-3 text-lg text-neutral-700 font-sans">
					{
						publications.map((item) => (
							<li class="border-b border-neutral-100 pb-3 last:border-b-0 last:pb-0">{item}</li>
						))
					}
				</ul>
			</section>

			<section
				class="rounded-[2rem] border border-neutral-200 bg-white p-8 shadow-[0_25px_60px_-40px_rgba(15,23,42,0.45)]"
			>
				<h3 class="text-2xl font-bold text-neutral-900 mb-2">Where The Work Shows Up</h3>
				<p class="text-sm uppercase tracking-[0.18em] text-neutral-500 font-semibold mb-6">
					Photography, teaching, and public-facing projects
				</p>
				<ul class="space-y-3 text-lg text-neutral-700 font-sans">
					{
						institutions.map((item) => (
							<li class="border-b border-neutral-100 pb-3 last:border-b-0 last:pb-0">{item}</li>
						))
					}
				</ul>
			</section>
		</div>
	</div>
</section>
