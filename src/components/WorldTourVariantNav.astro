---
import { routeVariants } from '../data/worldTourVariants';

interface Props {
	active?: string;
}

const { active } = Astro.props;
---

<nav class="variant-switcher" aria-label="Around the World design variants">
	<a class="variant-home" href="/around-the-world/variants">Concepts</a>
	{
		routeVariants.map((variant) => (
			<a
				href={variant.path}
				class:list={{ 'is-active': active === variant.id }}
				aria-current={active === variant.id ? 'page' : undefined}
			>
				<span>{variant.number}</span>
				{variant.shortName}
			</a>
		))
	}
</nav>

<style>
	.variant-switcher {
		position: fixed;
		z-index: 46;
		right: 1rem;
		bottom: 1rem;
		display: flex;
		max-width: calc(100vw - 2rem);
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 999px;
		backdrop-filter: blur(18px);
		background: rgba(10, 10, 10, 0.84);
		box-shadow: 0 12px 36px rgba(0, 0, 0, 0.24);
		overflow-x: auto;
		padding: 0.28rem;
		scrollbar-width: none;
	}

	.variant-switcher::-webkit-scrollbar {
		display: none;
	}

	.variant-switcher a {
		display: inline-flex;
		flex: 0 0 auto;
		gap: 0.35rem;
		align-items: center;
		padding: 0.55rem 0.72rem;
		border-radius: 999px;
		color: rgba(255, 255, 255, 0.66);
		font-family: var(--sans);
		font-size: 0.64rem;
		font-weight: 600;
		letter-spacing: 0.09em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.variant-switcher a:hover,
	.variant-switcher a:focus-visible,
	.variant-switcher a.is-active {
		background: rgba(255, 255, 255, 0.12);
		color: #fff;
	}

	.variant-switcher span {
		color: #d5ad64;
		font-variant-numeric: tabular-nums;
	}

	.variant-switcher .variant-home {
		padding-inline: 0.85rem;
		background: #f3eee5;
		color: #161412;
	}

	@media (max-width: 620px) {
		.variant-switcher {
			right: 0.5rem;
			bottom: 0.5rem;
			left: 0.5rem;
			max-width: none;
		}

		.variant-switcher a {
			padding-inline: 0.65rem;
		}
	}
</style>
