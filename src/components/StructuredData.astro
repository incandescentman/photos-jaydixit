---
type JsonLdRecord = Record<string, unknown>;
type JsonLd = JsonLdRecord | JsonLdRecord[];

const { data } = Astro.props as { data?: JsonLd | null };

const items = Array.isArray(data) ? data : data ? [data] : [];

function serialize(item: JsonLdRecord) {
	return JSON.stringify(item).replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026');
}
---

{
	items.map((item) => <script type="application/ld+json" set:html={serialize(item)} />)
}
