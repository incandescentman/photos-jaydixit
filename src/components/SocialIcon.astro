---
import { Globe } from '@lucide/astro';

type SocialLink = {
	name: string;
	url: string;
};

type Props = {
	socialLink: SocialLink;
	size?: number;
	frameSize?: number;
};

const { socialLink, size = 18, frameSize = 34 } = Astro.props as Props;
const iconName = socialLink.name.toLowerCase();
const customStyle = `--social-icon-size: ${size}px; --social-icon-frame: ${frameSize}px;`;
---

<a
	href={socialLink.url}
	target="_blank"
	rel="noopener noreferrer"
	class="social-icon"
	style={customStyle}
	aria-label={socialLink.name}
	title={socialLink.name}
>
	{
		iconName === 'twitter' && (
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<path
					fill="currentColor"
					d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.66l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25h6.83l4.713 6.231 5.447-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z"
				/>
			</svg>
		)
	}
	{
		iconName === 'linkedin' && (
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<path
					fill="currentColor"
					d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286ZM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065Zm1.782 13.019H3.555V9h3.564v11.452ZM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0Z"
				/>
			</svg>
		)
	}
	{
		iconName === 'instagram' && (
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<rect
					x="2.5"
					y="2.5"
					width="19"
					height="19"
					rx="5.2"
					fill="none"
					stroke="currentColor"
					stroke-width="1.9"
				/>
				<circle cx="12" cy="12" r="4.1" fill="none" stroke="currentColor" stroke-width="1.9" />
				<circle cx="17.6" cy="6.4" r="1.25" fill="currentColor" />
			</svg>
		)
	}
	{
		!['twitter', 'linkedin', 'instagram'].includes(iconName) && (
			<Globe size={size} aria-hidden="true" />
		)
	}
</a>

<style>
	.social-icon {
		width: var(--social-icon-frame);
		height: var(--social-icon-frame);
		border-radius: 999px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		color: var(--muted);
		text-decoration: none;
		transition:
			color 0.2s ease,
			background-color 0.2s ease;
	}

	.social-icon:hover {
		color: var(--ink);
		background: rgba(150, 119, 63, 0.08);
	}

	.social-icon svg {
		width: var(--social-icon-size);
		height: var(--social-icon-size);
		flex-shrink: 0;
	}
</style>
