---
import vanessaBeforeImg from '../assets/images/wikiportraits/vanessa-kirby-before-2018.jpg';
import vanessaAfterImg from '../assets/images/wikiportraits/vanessa-kirby_tiff_2024.jpg';
---

<figure class="wikiportraits-feature-hero">
	<div class="wikiportraits-feature-hero-grid">
		<div class="wikiportraits-feature-panel">
			<div class="wikiportraits-feature-frame">
				<img
					class="wikiportraits-feature-img wikiportraits-feature-img--before"
					src={vanessaBeforeImg.src}
					alt="Vanessa Kirby’s 2018 Wikipedia portrait"
					loading="eager"
					decoding="async"
				/>
			</div>
			<div class="wikiportraits-feature-meta">
				<strong>Before</strong>
				<span>Wikipedia portrait, 2018</span>
			</div>
		</div>

		<div class="wikiportraits-feature-arrow" aria-hidden="true">→</div>

		<div class="wikiportraits-feature-panel">
			<div class="wikiportraits-feature-frame">
				<img
					class="wikiportraits-feature-img wikiportraits-feature-img--after"
					src={vanessaAfterImg.src}
					alt="Vanessa Kirby - Wikipedia photo by Jay Dixit"
					loading="eager"
					decoding="async"
				/>
			</div>
			<div class="wikiportraits-feature-meta">
				<strong>After</strong>
				<span>Vanessa Kirby - Wikipedia photo by Jay Dixit</span>
			</div>
		</div>
	</div>
</figure>

<style>
	.wikiportraits-feature-hero {
		margin: 0;
		min-width: 0;
	}

	.wikiportraits-feature-hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		gap: clamp(0.75rem, 1.2vw, 1.5rem);
		align-items: start;
	}

	.wikiportraits-feature-panel {
		display: grid;
		gap: 0.9rem;
		min-width: 0;
	}

	.wikiportraits-feature-frame {
		aspect-ratio: 3 / 4;
		overflow: hidden;
		background: #e8e1d5;
		box-shadow: 0 24px 48px -32px rgba(42, 32, 23, 0.42);
	}

	.wikiportraits-feature-frame :global(.portfolio-lightbox) {
		display: block;
		width: 100%;
		height: 100%;
	}

	.wikiportraits-feature-img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.wikiportraits-feature-img--before {
		object-position: center 20%;
	}

	.wikiportraits-feature-img--after {
		object-position: center top;
	}

	.wikiportraits-feature-arrow {
		display: grid;
		place-items: center;
		align-self: center;
		width: clamp(2.5rem, 3vw, 3.25rem);
		height: clamp(2.5rem, 3vw, 3.25rem);
		border: 1px solid #cfc6b3;
		border-radius: 50%;
		background: var(--paper);
		color: #c0261f;
		font-family: var(--serif);
		font-size: clamp(1.5rem, 2vw, 2rem);
		line-height: 1;
		box-shadow: 0 8px 24px rgba(41, 37, 36, 0.08);
	}

	.wikiportraits-feature-meta {
		display: grid;
		gap: 0.3rem;
		font-family: var(--serif);
		font-size: clamp(1rem, 1.1vw, 1.2rem);
		line-height: 1.35;
		color: #5c554c;
	}

	.wikiportraits-feature-meta strong {
		font-family: var(--sans);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: #27221c;
	}

	@media (max-width: 700px) {
		.wikiportraits-feature-hero-grid {
			grid-template-columns: 1fr;
			gap: 1rem;
		}

		.wikiportraits-feature-arrow {
			justify-self: center;
			transform: rotate(90deg);
		}
	}
</style>
