---
import { ExternalLink, Menu, X } from '@lucide/astro';
import SocialIcon from './SocialIcon.astro';

const menuItems = [
	{ name: 'Why I Shoot', link: `/about` },
	{ name: 'Portraits', link: `/portraits` },
	{ name: 'Red Carpets Around the World', link: `/red-carpets` },
	{ name: 'Before & After', link: `/before-after` },
	{ name: 'Why WikiPortraits', link: `/blog/wikiportraits-story`, active: 'exact' },
	{ name: 'Contact', link: `/contact` },
	{ name: 'jaydixit.com', link: 'https://jaydixit.com' },
];

const socialLinks = [
	{ name: 'Twitter', url: 'https://twitter.com/jaydixit' },
	{ name: 'LinkedIn', url: 'https://linkedin.com/in/jaydixit' },
	{ name: 'Instagram', url: 'https://instagram.com/jaydixit' },
];

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
type MenuItem = (typeof menuItems)[number];

function isExternal(link: string) {
	return link.startsWith('http');
}

function isActive(item: MenuItem) {
	if (isExternal(item.link)) return false;
	const normalizedLink = item.link.replace(/\/+$/, '') || '/';
	if (normalizedLink === '/') return currentPath === '/';
	if (item.active === 'exact') return currentPath === normalizedLink;
	return currentPath === normalizedLink || currentPath.startsWith(`${normalizedLink}/`);
}
---

<nav
	data-critical-nav
	aria-label="Primary navigation"
	x-data="{ isOpen: false, scrolled: false }"
	@scroll.window="scrolled = window.scrollY > 20"
	:class="scrolled ? 'nav--scrolled' : ''"
	class="site-nav"
>
	<div data-critical-nav-inner class="site-nav-inner">
		<div data-critical-brand class="site-nav-brand">
			<button
				type="button"
				class="site-nav-logo-button"
				@click="$dispatch('open-logo-modal')"
				aria-label="View logo full size"
			>
				<img src="/logo-nav.webp" alt="Jay Dixit Photos logo" class="site-nav-logo" />
			</button>
			<a href="/" class="site-nav-wordmark">Jay Dixit Photos</a>
		</div>

		<div class="site-nav-menu">
			{
				menuItems.map((item) => (
					<a
						href={item.link}
						class:list={[
							'site-nav-link',
							{
								'is-active': isActive(item),
								'site-nav-link--ext': isExternal(item.link),
							},
						]}
						target={isExternal(item.link) ? '_blank' : undefined}
						rel={isExternal(item.link) ? 'noopener noreferrer' : undefined}
						aria-current={isActive(item) ? 'page' : undefined}
					>
						{item.name}
						{isExternal(item.link) && (
							<span class="site-nav-ext-arrow" aria-hidden="true">
								<ExternalLink size={12} strokeWidth={1.8} />
							</span>
						)}
					</a>
				))
			}

			<div class="site-nav-social" aria-label="Social links">
				{socialLinks.map((social) => <SocialIcon socialLink={social} />)}
			</div>
		</div>

		<button
			type="button"
			@click="isOpen = !isOpen"
			class="site-nav-toggle"
			aria-label="Menu"
			aria-controls="site-nav-mobile-menu"
			:aria-expanded="isOpen.toString()"
		>
			<Menu x-show="!isOpen" size={26} strokeWidth={1.8} aria-hidden="true" />
			<X x-show="isOpen" size={26} strokeWidth={1.8} aria-hidden="true" style="display: none;" />
		</button>
	</div>

	<div
		id="site-nav-mobile-menu"
		x-show="isOpen"
		x-transition:enter="transition ease-out duration-300"
		x-transition:enter-start="opacity-0 -translate-y-2"
		x-transition:enter-end="opacity-100 translate-y-0"
		x-transition:leave="transition ease-in duration-200"
		x-transition:leave-start="opacity-100 translate-y-0"
		x-transition:leave-end="opacity-0 -translate-y-2"
		class="site-nav-mobile"
		style="display: none;"
	>
		<div class="site-nav-mobile-inner">
			{
				menuItems.map((item) => (
					<a
						href={item.link}
						class:list={['site-nav-mobile-link', { 'is-active': isActive(item) }]}
						@click="isOpen = false"
						target={isExternal(item.link) ? '_blank' : undefined}
						rel={isExternal(item.link) ? 'noopener noreferrer' : undefined}
						aria-current={isActive(item) ? 'page' : undefined}
					>
						{item.name}
					</a>
				))
			}

			<div class="site-nav-mobile-social" aria-label="Social links">
				{socialLinks.map((social) => <SocialIcon socialLink={social} frameSize={40} />)}
			</div>
		</div>
	</div>
</nav>

<div
	x-data="{ logoModalOpen: false }"
	@open-logo-modal.window="logoModalOpen = true"
	@keydown.escape.window="logoModalOpen = false"
	x-show="logoModalOpen"
	x-transition:enter="transition ease-out duration-300"
	x-transition:enter-start="opacity-0"
	x-transition:enter-end="opacity-100"
	x-transition:leave="transition ease-in duration-200"
	x-transition:leave-start="opacity-100"
	x-transition:leave-end="opacity-0"
	class="site-logo-modal"
	style="display: none;"
>
	<div @click="logoModalOpen = false" class="site-logo-modal-backdrop"></div>
	<div class="site-logo-modal-content">
		<img src="/logo-large.webp" alt="Jay Dixit Photos logo" />
		<button
			type="button"
			@click="logoModalOpen = false"
			class="site-logo-modal-close"
			aria-label="Close logo preview"
		>
			<X size={30} strokeWidth={1.8} aria-hidden="true" />
		</button>
	</div>
</div>

<script>
	import Alpine from 'alpinejs';

	window.Alpine = Alpine;
	Alpine.start();
</script>

<style is:global>
	/* Single source of truth for how much top padding pages need to clear the
	   fixed nav. Keep in sync with .site-nav sizing below: ~132px tall on
	   desktop (88px logo + 2×1.35rem padding), ~120px at ≤640px (76px logo). */
	:root {
		--nav-clearance: 10.5rem;
	}
	@media (max-width: 640px) {
		:root {
			--nav-clearance: 9.5rem;
		}
	}
</style>

<style>
	.site-nav {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		z-index: 50;
		padding: 1.35rem 0;
		background: var(--paper);
		border-bottom: 1px solid var(--hairline);
		font-family: var(--sans);
		transition:
			padding 0.4s ease,
			background-color 0.4s ease,
			box-shadow 0.4s ease;
	}

	.site-nav.nav--scrolled {
		padding: 0.7rem 0;
		background: var(--paper);
		box-shadow: 0 1px 3px rgba(26, 23, 20, 0.05);
	}

	.site-nav-inner {
		max-width: 80rem;
		margin: 0 auto;
		padding: 0 2rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.75rem;
	}

	.site-nav-brand {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		flex-shrink: 0;
	}

	.site-nav-logo-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		border: 0;
		background: transparent;
		color: inherit;
		cursor: pointer;
	}

	.site-nav-logo {
		width: 88px;
		height: 88px;
		object-fit: contain;
		border-radius: 6px;
		transition:
			transform 0.3s ease,
			width 0.4s ease,
			height 0.4s ease;
	}

	.site-nav-logo-button:hover .site-nav-logo,
	.site-nav-logo-button:focus-visible .site-nav-logo {
		transform: scale(1.05);
	}

	.nav--scrolled .site-nav-logo {
		width: 76px;
		height: 76px;
	}

	.site-nav-wordmark {
		font-family: var(--serif);
		font-weight: 500;
		font-size: 2.35rem;
		line-height: 1;
		letter-spacing: 0;
		color: var(--ink);
		text-decoration: none;
		white-space: nowrap;
		transition:
			color 0.2s ease,
			font-size 0.4s ease;
	}

	.site-nav-wordmark:hover {
		color: var(--accent);
	}

	.nav--scrolled .site-nav-wordmark {
		font-size: 2.05rem;
	}

	.site-nav-menu {
		display: flex;
		align-items: center;
		gap: 1.15rem;
	}

	.site-nav-link {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.2rem;
		font-family: var(--sans);
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
		text-decoration: none;
		white-space: nowrap;
		padding-bottom: 2px;
		border-bottom: 1px solid transparent;
		transition:
			color 0.2s ease,
			border-color 0.2s ease;
	}

	.site-nav-link:hover {
		color: var(--ink);
	}

	.site-nav-link.is-active {
		color: var(--accent);
		border-bottom-color: #c9b792;
	}

	.site-nav-link--ext {
		color: var(--ink);
	}

	.site-nav-ext-arrow {
		display: inline-flex;
		align-items: center;
		opacity: 0.7;
	}

	.site-nav-social {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		margin-left: 0.25rem;
		padding-left: 1rem;
		border-left: 1px solid var(--hairline);
	}

	.site-nav-toggle {
		display: none;
		align-items: center;
		justify-content: center;
		width: 42px;
		height: 42px;
		padding: 0;
		border: none;
		background: transparent;
		color: var(--ink);
		cursor: pointer;
	}

	.site-nav-toggle svg {
		width: 26px;
		height: 26px;
	}

	.site-nav-mobile {
		position: absolute;
		top: 100%;
		left: 0;
		width: 100%;
		background: var(--paper);
		border-top: 1px solid var(--hairline);
		box-shadow: 0 20px 40px -24px rgba(26, 23, 20, 0.35);
	}

	.site-nav-mobile-inner {
		display: flex;
		flex-direction: column;
		padding: 1rem 1.5rem 1.5rem;
	}

	.site-nav-mobile-link {
		padding: 0.85rem 0.25rem;
		font-family: var(--sans);
		font-size: 0.88rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
		text-decoration: none;
		border-bottom: 1px solid rgba(235, 230, 220, 0.65);
	}

	.site-nav-mobile-link:hover {
		color: var(--ink);
	}

	.site-nav-mobile-link.is-active {
		color: var(--accent);
	}

	.site-nav-mobile-social {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding-top: 1.25rem;
	}

	.site-logo-modal {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1rem;
	}

	.site-logo-modal-backdrop {
		position: absolute;
		inset: 0;
		background: rgba(15, 13, 11, 0.82);
		backdrop-filter: blur(4px);
		-webkit-backdrop-filter: blur(4px);
	}

	.site-logo-modal-content {
		position: relative;
		max-width: 40rem;
		width: 100%;
	}

	.site-logo-modal-content img {
		width: 100%;
		height: auto;
		border-radius: 12px;
		box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.6);
	}

	.site-logo-modal-close {
		position: absolute;
		top: -3rem;
		right: 0;
		border: none;
		background: transparent;
		color: #fff;
		cursor: pointer;
		transition: color 0.2s ease;
	}

	.site-logo-modal-close:hover {
		color: #cfc8bb;
	}

	.site-logo-modal-close svg {
		width: 30px;
		height: 30px;
	}

	@media (max-width: 1199px) {
		.site-nav-menu {
			display: none;
		}

		.site-nav-toggle {
			display: inline-flex;
		}
	}

	@media (max-width: 640px) {
		.site-nav {
			padding: 0.95rem 0;
		}

		.site-nav-inner {
			padding: 0 1rem;
			gap: 1rem;
		}

		.site-nav-logo {
			width: 76px;
			height: 76px;
		}

		.site-nav-wordmark {
			font-size: 1.68rem;
		}
	}

	@media (min-width: 1200px) and (max-width: 1399px) {
		.site-nav-inner {
			gap: 1rem;
		}

		.site-nav-menu {
			gap: 0.75rem;
		}

		.site-nav-link {
			font-size: 0.72rem;
			letter-spacing: 0.055em;
		}

		.site-nav-social {
			margin-left: 0;
			padding-left: 0.65rem;
		}
	}

	@media (min-width: 1200px) and (max-width: 1319px) {
		.site-nav-inner {
			padding: 0 1rem;
			gap: 0.7rem;
		}

		.site-nav-logo {
			width: 76px;
			height: 76px;
		}

		.site-nav-wordmark {
			font-size: 1.85rem;
		}

		.site-nav-menu {
			gap: 0.55rem;
		}

		.site-nav-link {
			font-size: 0.68rem;
			letter-spacing: 0.035em;
		}

		.site-nav-social {
			display: none;
		}
	}

	@media (min-width: 1200px) {
		.site-nav-mobile {
			display: none !important;
		}
	}
</style>
