---
const menuItems = [
	{ name: 'Why I Photograph', link: `/about` },
	{ name: 'Red Carpet Photos', link: `/red-carpet` },
	{ name: 'Before & After', link: `/before-after` },
	{ name: 'The Story of WikiPortraits', link: `/blog/wikiportraits-story` },
	{ name: 'Contact', link: `/contact` },
	{ name: 'jaydixit.com', link: 'https://jaydixit.com' },
];

const socialLinks = [
	{ name: 'Twitter', url: 'https://twitter.com/jaydixit' },
	{ name: 'LinkedIn', url: 'https://linkedin.com/in/jaydixit' },
	{ name: 'Instagram', url: 'https://instagram.com/jaydixit' },
];

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';

function isExternal(link: string) {
	return link.startsWith('http');
}

function isActive(link: string) {
	if (isExternal(link)) return false;
	const normalizedLink = link.replace(/\/+$/, '') || '/';
	if (normalizedLink === '/') return currentPath === '/';
	return currentPath === normalizedLink || currentPath.startsWith(`${normalizedLink}/`);
}
---

<nav
	data-critical-nav
	aria-label="Primary navigation"
	x-data="{ isOpen: false, scrolled: false }"
	@scroll.window="scrolled = window.scrollY > 20"
	:class="scrolled ? 'nav--scrolled' : ''"
	class="site-nav"
>
	<div data-critical-nav-inner class="site-nav-inner">
		<div data-critical-brand class="site-nav-brand">
			<button
				type="button"
				class="site-nav-logo-button"
				@click="$dispatch('open-logo-modal')"
				aria-label="Open Jay Dixit Photos logo"
			>
				<img src="/logo.png" alt="Jay Dixit Photos logo" class="site-nav-logo" />
			</button>
			<a href="/" class="site-nav-wordmark">Jay Dixit Photos</a>
		</div>

		<div class="site-nav-menu">
			{
				menuItems.map((item) => (
					<a
						href={item.link}
						class:list={[
							'site-nav-link',
							{
								'is-active': isActive(item.link),
								'site-nav-link--ext': isExternal(item.link),
							},
						]}
						target={isExternal(item.link) ? '_blank' : undefined}
						rel={isExternal(item.link) ? 'noopener noreferrer' : undefined}
						aria-current={isActive(item.link) ? 'page' : undefined}
					>
						{item.name}
						{isExternal(item.link) && (
							<span class="site-nav-ext-arrow" aria-hidden="true">
								&#8599;
							</span>
						)}
					</a>
				))
			}

			<div class="site-nav-social" aria-label="Social links">
				{
					socialLinks.map((social) => (
						<a
							href={social.url}
							target="_blank"
							rel="noopener noreferrer"
							title={social.name}
							aria-label={social.name}
						>
							{social.name === 'Twitter' && (
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path
										fill="currentColor"
										d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.66l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25h6.83l4.713 6.231 5.447-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z"
									/>
								</svg>
							)}
							{social.name === 'LinkedIn' && (
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path
										fill="currentColor"
										d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286ZM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065Zm1.782 13.019H3.555V9h3.564v11.452ZM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0Z"
									/>
								</svg>
							)}
							{social.name === 'Instagram' && (
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<rect
										x="2.5"
										y="2.5"
										width="19"
										height="19"
										rx="5.2"
										fill="none"
										stroke="currentColor"
										stroke-width="1.9"
									/>
									<circle
										cx="12"
										cy="12"
										r="4.1"
										fill="none"
										stroke="currentColor"
										stroke-width="1.9"
									/>
									<circle cx="17.6" cy="6.4" r="1.25" fill="currentColor" />
								</svg>
							)}
						</a>
					))
				}
			</div>
		</div>

		<button
			type="button"
			@click="isOpen = !isOpen"
			class="site-nav-toggle"
			aria-label="Menu"
			aria-controls="site-nav-mobile-menu"
			:aria-expanded="isOpen.toString()"
		>
			<svg
				x-show="!isOpen"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				aria-hidden="true"
			>
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="1.8"
					d="M4 7h16M4 12h16M4 17h16"></path>
			</svg>
			<svg
				x-show="isOpen"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				aria-hidden="true"
				style="display: none;"
			>
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="1.8"
					d="M6 18 18 6M6 6l12 12"></path>
			</svg>
		</button>
	</div>

	<div
		id="site-nav-mobile-menu"
		x-show="isOpen"
		x-transition:enter="transition ease-out duration-300"
		x-transition:enter-start="opacity-0 -translate-y-2"
		x-transition:enter-end="opacity-100 translate-y-0"
		x-transition:leave="transition ease-in duration-200"
		x-transition:leave-start="opacity-100 translate-y-0"
		x-transition:leave-end="opacity-0 -translate-y-2"
		class="site-nav-mobile"
		style="display: none;"
	>
		<div class="site-nav-mobile-inner">
			{
				menuItems.map((item) => (
					<a
						href={item.link}
						class:list={['site-nav-mobile-link', { 'is-active': isActive(item.link) }]}
						@click="isOpen = false"
						target={isExternal(item.link) ? '_blank' : undefined}
						rel={isExternal(item.link) ? 'noopener noreferrer' : undefined}
						aria-current={isActive(item.link) ? 'page' : undefined}
					>
						{item.name}
					</a>
				))
			}

			<div class="site-nav-mobile-social" aria-label="Social links">
				{
					socialLinks.map((social) => (
						<a
							href={social.url}
							target="_blank"
							rel="noopener noreferrer"
							title={social.name}
							aria-label={social.name}
						>
							{social.name === 'Twitter' && (
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path
										fill="currentColor"
										d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.66l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25h6.83l4.713 6.231 5.447-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z"
									/>
								</svg>
							)}
							{social.name === 'LinkedIn' && (
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path
										fill="currentColor"
										d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286ZM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065Zm1.782 13.019H3.555V9h3.564v11.452ZM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0Z"
									/>
								</svg>
							)}
							{social.name === 'Instagram' && (
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<rect
										x="2.5"
										y="2.5"
										width="19"
										height="19"
										rx="5.2"
										fill="none"
										stroke="currentColor"
										stroke-width="1.9"
									/>
									<circle
										cx="12"
										cy="12"
										r="4.1"
										fill="none"
										stroke="currentColor"
										stroke-width="1.9"
									/>
									<circle cx="17.6" cy="6.4" r="1.25" fill="currentColor" />
								</svg>
							)}
						</a>
					))
				}
			</div>
		</div>
	</div>
</nav>

<div
	x-data="{ logoModalOpen: false }"
	@open-logo-modal.window="logoModalOpen = true"
	@keydown.escape.window="logoModalOpen = false"
	x-show="logoModalOpen"
	x-transition:enter="transition ease-out duration-300"
	x-transition:enter-start="opacity-0"
	x-transition:enter-end="opacity-100"
	x-transition:leave="transition ease-in duration-200"
	x-transition:leave-start="opacity-100"
	x-transition:leave-end="opacity-0"
	class="site-logo-modal"
	style="display: none;"
>
	<div @click="logoModalOpen = false" class="site-logo-modal-backdrop"></div>
	<div class="site-logo-modal-content">
		<img src="/logo.png" alt="Jay Dixit Photos logo" />
		<button
			type="button"
			@click="logoModalOpen = false"
			class="site-logo-modal-close"
			aria-label="Close logo preview"
		>
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="1.8"
					d="M6 18 18 6M6 6l12 12"></path>
			</svg>
		</button>
	</div>
</div>

<style>
	.site-nav {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		z-index: 50;
		padding: 1.35rem 0;
		background: rgba(250, 249, 246, 0.82);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		border-bottom: 1px solid rgba(235, 230, 220, 0.72);
		font-family: var(--sans);
		transition:
			padding 0.4s ease,
			background-color 0.4s ease,
			box-shadow 0.4s ease;
	}

	.site-nav.nav--scrolled {
		padding: 0.7rem 0;
		background: rgba(250, 249, 246, 0.94);
		box-shadow: 0 1px 3px rgba(26, 23, 20, 0.05);
	}

	.site-nav-inner {
		max-width: 80rem;
		margin: 0 auto;
		padding: 0 2rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.75rem;
	}

	.site-nav-brand {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		flex-shrink: 0;
	}

	.site-nav-logo-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		border: 0;
		background: transparent;
		color: inherit;
		cursor: pointer;
	}

	.site-nav-logo {
		width: 44px;
		height: 44px;
		object-fit: contain;
		border-radius: 6px;
		transition:
			transform 0.3s ease,
			width 0.4s ease,
			height 0.4s ease;
	}

	.site-nav-logo-button:hover .site-nav-logo,
	.site-nav-logo-button:focus-visible .site-nav-logo {
		transform: scale(1.05);
	}

	.site-nav-logo-button:focus-visible,
	.site-nav-toggle:focus-visible,
	.site-logo-modal-close:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 4px;
	}

	.nav--scrolled .site-nav-logo {
		width: 38px;
		height: 38px;
	}

	.site-nav-wordmark {
		font-family: var(--serif);
		font-weight: 400;
		font-size: 1.45rem;
		line-height: 1;
		letter-spacing: 0;
		color: var(--ink);
		text-decoration: none;
		white-space: nowrap;
		transition:
			color 0.2s ease,
			font-size 0.4s ease;
	}

	.site-nav-wordmark:hover {
		color: var(--accent);
	}

	.nav--scrolled .site-nav-wordmark {
		font-size: 1.3rem;
	}

	.site-nav-menu {
		display: flex;
		align-items: center;
		gap: 1.15rem;
	}

	.site-nav-link {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.2rem;
		font-family: var(--sans);
		font-size: 0.82rem;
		font-weight: 500;
		letter-spacing: 0;
		color: var(--muted);
		text-decoration: none;
		white-space: nowrap;
		padding-bottom: 2px;
		border-bottom: 1px solid transparent;
		transition:
			color 0.2s ease,
			border-color 0.2s ease;
	}

	.site-nav-link:hover {
		color: var(--ink);
	}

	.site-nav-link.is-active {
		color: var(--accent);
		border-bottom-color: #c9b792;
	}

	.site-nav-link--ext {
		color: var(--ink);
	}

	.site-nav-ext-arrow {
		font-size: 0.72rem;
		opacity: 0.7;
	}

	.site-nav-social {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		margin-left: 0.25rem;
		padding-left: 1rem;
		border-left: 1px solid var(--hairline);
	}

	.site-nav-social a,
	.site-nav-mobile-social a {
		width: 34px;
		height: 34px;
		border-radius: 999px;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--muted);
		transition:
			color 0.2s ease,
			background-color 0.2s ease;
	}

	.site-nav-social a:hover,
	.site-nav-mobile-social a:hover {
		color: var(--ink);
		background: rgba(150, 119, 63, 0.08);
	}

	.site-nav-social svg,
	.site-nav-mobile-social svg {
		width: 17px;
		height: 17px;
	}

	.site-nav-toggle {
		display: none;
		align-items: center;
		justify-content: center;
		width: 42px;
		height: 42px;
		padding: 0;
		border: none;
		background: transparent;
		color: var(--ink);
		cursor: pointer;
	}

	.site-nav-toggle svg {
		width: 26px;
		height: 26px;
	}

	.site-nav-mobile {
		position: absolute;
		top: 100%;
		left: 0;
		width: 100%;
		background: var(--paper);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		border-top: 1px solid var(--hairline);
		box-shadow: 0 20px 40px -24px rgba(26, 23, 20, 0.35);
	}

	.site-nav-mobile-inner {
		display: flex;
		flex-direction: column;
		padding: 1rem 1.5rem 1.5rem;
	}

	.site-nav-mobile-link {
		padding: 0.85rem 0.25rem;
		font-family: var(--sans);
		font-size: 1.05rem;
		font-weight: 500;
		color: var(--muted);
		text-decoration: none;
		border-bottom: 1px solid rgba(235, 230, 220, 0.65);
	}

	.site-nav-mobile-link:hover {
		color: var(--ink);
	}

	.site-nav-mobile-link.is-active {
		color: var(--accent);
	}

	.site-nav-mobile-social {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding-top: 1.25rem;
	}

	.site-nav-mobile-social a {
		width: 40px;
		height: 40px;
	}

	.site-nav-mobile-social svg {
		width: 19px;
		height: 19px;
	}

	.site-logo-modal {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1rem;
	}

	.site-logo-modal-backdrop {
		position: absolute;
		inset: 0;
		background: rgba(15, 13, 11, 0.82);
		backdrop-filter: blur(4px);
		-webkit-backdrop-filter: blur(4px);
	}

	.site-logo-modal-content {
		position: relative;
		max-width: 40rem;
		width: 100%;
	}

	.site-logo-modal-content img {
		width: 100%;
		height: auto;
		border-radius: 12px;
		box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.6);
	}

	.site-logo-modal-close {
		position: absolute;
		top: -3rem;
		right: 0;
		border: none;
		background: transparent;
		color: #fff;
		cursor: pointer;
		transition: color 0.2s ease;
	}

	.site-logo-modal-close:hover {
		color: #cfc8bb;
	}

	.site-logo-modal-close svg {
		width: 30px;
		height: 30px;
	}

	@media (max-width: 1199px) {
		.site-nav-menu {
			display: none;
		}

		.site-nav-toggle {
			display: inline-flex;
		}
	}

	@media (max-width: 640px) {
		.site-nav {
			padding: 0.95rem 0;
		}

		.site-nav-inner {
			padding: 0 1rem;
			gap: 1rem;
		}

		.site-nav-logo {
			width: 38px;
			height: 38px;
		}

		.site-nav-wordmark {
			font-size: 1.28rem;
		}
	}

	@media (min-width: 1200px) {
		.site-nav-mobile {
			display: none !important;
		}
	}
</style>
