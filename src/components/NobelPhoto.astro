---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	photo: {
		src: ImageMetadata;
		full: {
			src: string;
			attributes: { width: number; height: number };
		};
		alt: string;
		caption: string;
		commons?: string;
	};
	eager?: boolean;
	className?: string;
}

const { photo, eager = false, className = '' } = Astro.props;
---

<figure class:list={['nobel-photo', className]}>
	<a
		href={photo.full.src}
		data-nobel-photo
		data-pswp-width={photo.full.attributes.width}
		data-pswp-height={photo.full.attributes.height}
		data-pswp-caption={`${photo.caption} — Photograph by Jay Dixit`}
		aria-label={`Open larger photograph: ${photo.caption}`}
	>
		<Image
			src={photo.src}
			alt={photo.alt}
			widths={[480, 720, 960, 1280, 1800]}
			sizes="(max-width: 760px) 100vw, 50vw"
			loading={eager ? 'eager' : 'lazy'}
			fetchpriority={eager ? 'high' : undefined}
		/>
	</a>
	<figcaption>
		<span>{photo.caption}</span>
		{
			photo.commons && (
				<a href={photo.commons} target="_blank" rel="noopener noreferrer">
					Wikimedia Commons ↗
				</a>
			)
		}
	</figcaption>
</figure>
