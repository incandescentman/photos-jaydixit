---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';

interface Props {
	photo: {
		src: ImageMetadata;
		full: {
			src: string;
			attributes: { width: number; height: number };
		};
		alt: string;
		caption: string;
		creatorName?: string;
		commons?: string;
		subjects?: { href: string; label: string }[];
	};
	eager?: boolean;
	className?: string;
}

const { photo, eager = false, className = '' } = Astro.props;
const thumbnail = await getImage({ src: photo.src, width: 160, format: 'webp' });
const creatorName = photo.creatorName || 'Jay Dixit';
const lightboxCaption = photo.caption.includes(`Photo by ${creatorName}`)
	? photo.caption
	: `${photo.caption} — Photograph by ${creatorName}`;
---

<figure class:list={['nobel-photo', className]}>
	<a
		href={photo.full.src}
		data-nobel-photo
		data-exhibition-thumb={thumbnail.src}
		data-exhibition-gallery="/gallery/events/nobel-prizes-2024/"
		data-exhibition-gallery-label="Nobel Prizes 2024"
		data-exhibition-commons={photo.commons}
		data-exhibition-subjects={JSON.stringify(photo.subjects ?? [])}
		data-pswp-width={photo.full.attributes.width}
		data-pswp-height={photo.full.attributes.height}
		data-pswp-caption={lightboxCaption}
		aria-label={`Open larger photograph: ${photo.caption}`}
	>
		<Image
			src={photo.src}
			alt={photo.alt}
			width={1800}
			widths={[480, 720, 960, 1280, 1800]}
			sizes="(max-width: 760px) 100vw, 50vw"
			loading={eager ? 'eager' : 'lazy'}
			fetchpriority={eager ? 'high' : undefined}
		/>
	</a>
	<figcaption>
		<span>{photo.caption}</span>
		{
			photo.commons && (
				<a href={photo.commons} target="_blank" rel="noopener noreferrer">
					Wikimedia Commons ↗
				</a>
			)
		}
	</figcaption>
</figure>
