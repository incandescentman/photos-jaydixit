---
import { getCollection, type CollectionEntry } from 'astro:content';
import { smartQuotes } from '@jaydixit/astro-utils';
import { cldUrl, cldSrcset, cldSizes } from '../lib/cloudinary';

type BlogEntry = CollectionEntry<'blog'>;

interface Props {
	currentSlug: string;
	currentTags?: string[];
}

const { currentSlug, currentTags = [] } = Astro.props as Props;

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const normalizedCurrentTags = currentTags.map((tag) => tag.toLowerCase());

function getPublishTime(post: BlogEntry) {
	return (post.data.publishDate ?? post.data.updateDate ?? new Date(0)).valueOf();
}

const relatedPosts = allPosts
	.filter((post) => post.id !== currentSlug)
	.map((post) => {
		const sharedTags = (post.data.tags ?? []).filter((tag) =>
			normalizedCurrentTags.includes(tag.toLowerCase()),
		);
		return {
			post,
			sharedTags,
			score: sharedTags.length,
			publishTime: getPublishTime(post),
		};
	})
	.sort((a, b) => {
		if (b.score !== a.score) return b.score - a.score;
		return b.publishTime - a.publishTime;
	})
	.slice(0, 3);

const hasRelatedPosts = relatedPosts.length > 0;
---

{
	hasRelatedPosts && (
		<section class="mt-24 border-t border-slate-200 pt-14">
			<div class="mb-10 flex items-center justify-between gap-4">
				<div>
					<p class="text-xs uppercase tracking-[0.28em] text-slate-400">Continue Reading</p>
					<h2 class="mt-3 text-3xl font-semibold tracking-tight text-slate-900">Related essays</h2>
				</div>
				<a href="/blog" class="text-sm font-medium text-slate-600 hover:text-slate-900">
					View all essays
				</a>
			</div>

			<div class="grid gap-8 lg:grid-cols-3">
				{
					relatedPosts.map(({ post, sharedTags }) => {
						const publishDate = post.data.publishDate ?? post.data.updateDate;
						const formattedDate = publishDate
							? publishDate.toLocaleDateString('en-US', {
									month: 'short',
									day: 'numeric',
									year: 'numeric',
								})
							: null;
						const heroImage = post.data.imagePublicId ? cldUrl(post.data.imagePublicId, 1200) : (post.data.image ?? null);
						const heroSrcset = post.data.imagePublicId ? cldSrcset(post.data.imagePublicId) : undefined;
						const excerpt = post.data.excerpt ? smartQuotes(post.data.excerpt) : null;

						return (
							<article class="group overflow-hidden rounded-[2rem] border border-black/5 bg-white shadow-[0_20px_50px_-35px_rgba(15,23,42,0.45)] transition hover:-translate-y-1">
								<a href={`/blog/${post.id}/`} class="block no-underline">
									{heroImage && (
										<figure class="aspect-[4/3] overflow-hidden bg-slate-100">
											<img
												src={heroImage}
												srcset={heroSrcset}
												sizes={cldSizes('(max-width: 1024px) 100vw, 33vw')}
												alt={post.data.imageAlt ?? post.data.title}
												loading="lazy"
												decoding="async"
												class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.02]"
											/>
										</figure>
									)}

									<div class="p-6">
										{formattedDate && (
											<p class="text-xs uppercase tracking-[0.22em] text-slate-400">{formattedDate}</p>
										)}
										<h3 class="mt-3 text-2xl font-semibold tracking-tight text-slate-900">
											{post.data.title}
										</h3>
										{excerpt && (
											<p class="mt-3 text-[15px] leading-relaxed text-slate-600">{excerpt}</p>
										)}
										{sharedTags.length > 0 && (
											<p class="mt-4 text-xs uppercase tracking-[0.2em] text-slate-500">
												Shared tags: {sharedTags.join(', ')}
											</p>
										)}
									</div>
								</a>
							</article>
						);
					})
				}
			</div>
		</section>
	)
}
