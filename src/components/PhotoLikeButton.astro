---
const { photoId, className = "" } = Astro.props;
---

<button
  class={`like-button ${className}`}
  data-photo-id={photoId}
  data-initial-count="0"
>
  <svg class="heart w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
  </svg>
  <span class="like-count ml-1 text-sm">0</span>
</button>

<style>
.like-button {
  @apply flex items-center px-3 py-1.5 bg-white bg-opacity-90 hover:bg-opacity-100
         border border-gray-200 rounded-full transition-all duration-200
         hover:scale-105 active:scale-95 backdrop-blur-sm;
}

.like-button:hover {
  @apply shadow-md;
}

.like-button.liked {
  @apply bg-red-500 text-white border-red-500;
}

.like-button.liked .heart {
  @apply animate-pulse;
}
</style>

<script>
// Initialize all like buttons on the page
function initLikeButtons() {
  const buttons = document.querySelectorAll<HTMLButtonElement>('.like-button[data-photo-id]');

  buttons.forEach(button => {
    if (button.dataset.initialized) return;
    button.dataset.initialized = 'true';

    const photoId = button.dataset.photoId;
    const likeCountEl = button.querySelector('.like-count');
    if (!photoId || !likeCountEl) return;

    let isLiked = false;
    let currentCount = 0;

    // Load from localStorage
    const localLikes = JSON.parse(localStorage.getItem('photoLikes') || '{}');
    const photoData = localLikes[photoId] || { count: 0, liked: false };
    currentCount = photoData.count;
    isLiked = photoData.liked;
    updateUI();

    button.addEventListener('click', (e) => {
      e.stopPropagation();
      e.preventDefault();

      isLiked = !isLiked;
      currentCount += isLiked ? 1 : -1;
      currentCount = Math.max(0, currentCount);

      updateUI();
      saveLikeStatus();

      // Visual feedback
      button.classList.add('animate-bounce');
      setTimeout(() => button.classList.remove('animate-bounce'), 300);
    });

    function updateUI() {
      likeCountEl.textContent = String(currentCount);
      button.classList.toggle('liked', isLiked);
    }

    function saveLikeStatus() {
      const localLikes = JSON.parse(localStorage.getItem('photoLikes') || '{}');
      localLikes[photoId] = { count: currentCount, liked: isLiked };
      localStorage.setItem('photoLikes', JSON.stringify(localLikes));
    }
  });
}

// Run on DOM ready and after any dynamic content loads
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initLikeButtons);
} else {
  initLikeButtons();
}
</script>
