---
import '../styles/global.css';
import '../styles/photoswipe-custom.css';
import siteConfig from '../../site.config.mts';
import Footer from '../components/Footer.astro';
import NavBar from '../components/NavBar.astro';
import StructuredData from '../components/StructuredData.astro';
import {
	normalizeDateValue,
	normalizeKeywords,
	resolveCanonicalUrl,
	resolveOgImage,
} from '../lib/seo';

type JsonLd = Record<string, unknown> | Array<Record<string, unknown>>;
type LayoutProps = {
	frontmatter?: Record<string, unknown>;
	title?: string;
	description?: string;
	canonical?: string;
	image?: string;
	imageAlt?: string;
	ogType?: string;
	noindex?: boolean;
	twitterCard?: string;
	structuredData?: JsonLd;
	publishedTime?: string | Date;
	modifiedTime?: string | Date;
	keywords?: string[] | string;
	showChrome?: boolean;
	useArnoPro?: boolean;
};

const owner = siteConfig.owner;
const favicon = siteConfig.favicon;
const base = import.meta.env.BASE_URL;
const siteUrl = Astro.site?.origin ?? siteConfig.siteUrl ?? 'https://photos.jaydixit.com';
const props = Astro.props as LayoutProps;
const frontmatter = props.frontmatter ?? {};

const pageTitleSource =
	props.title ?? (typeof frontmatter.title === 'string' ? frontmatter.title : undefined);
const pageTitle = pageTitleSource ? `${pageTitleSource} — ${owner}` : owner;
const pageDescription =
	props.description ??
	(typeof frontmatter.description === 'string' ? frontmatter.description : undefined);
const canonicalSource =
	props.canonical ??
	(typeof frontmatter.canonical === 'string' ? frontmatter.canonical : undefined);
const canonicalUrl = resolveCanonicalUrl(canonicalSource, siteUrl, Astro.url.pathname);

const rawImage =
	props.image ?? (typeof frontmatter.image === 'string' ? frontmatter.image : undefined);
const ogImage = resolveOgImage(rawImage, siteUrl, '/og-card.png');
const ogImageAlt =
	props.imageAlt ??
	(typeof frontmatter.imageAlt === 'string' ? frontmatter.imageAlt : undefined) ??
	`${owner} — Red Carpet & Portrait Photographer, WikiPortraits · Wikipedia`;
const ogType =
	props.ogType ?? (typeof frontmatter.ogType === 'string' ? frontmatter.ogType : 'website');
const twitterCard =
	props.twitterCard ??
	(typeof frontmatter.twitterCard === 'string' ? frontmatter.twitterCard : 'summary_large_image');
const twitterHandle = siteConfig.twitterHandle;
const noindex =
	props.noindex ?? (typeof frontmatter.noindex === 'boolean' ? frontmatter.noindex : false);
const keywords = normalizeKeywords(
	props.keywords ?? (frontmatter.keywords as string[] | string | undefined),
);
const publishedTime = normalizeDateValue(
	props.publishedTime ?? (frontmatter.publishDate as string | Date | undefined),
);
const modifiedTime = normalizeDateValue(
	props.modifiedTime ??
		(frontmatter.updateDate as string | Date | undefined) ??
		(frontmatter.publishDate as string | Date | undefined),
);
const structuredData = props.structuredData ?? (frontmatter.structuredData as JsonLd | undefined);
const showChrome = props.showChrome ?? true;
const arnoProRoutes = new Set(['/', '/about', '/before-and-after', '/nobel-2024', '/red-carpets']);
const normalizedPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const useArnoPro =
	props.useArnoPro ??
	(arnoProRoutes.has(normalizedPath) ||
		(normalizedPath.startsWith('/blog/') && normalizedPath !== '/blog'));

const websiteStructuredData = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: siteConfig.title,
	url: siteUrl,
	description: pageDescription ?? `${owner} photography portfolio`,
	publisher: {
		'@type': 'Person',
		name: owner,
	},
};

const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const gaBootstrapScript = gaMeasurementId
	? `
window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${gaMeasurementId}', {
  anonymize_ip: true
});`
	: null;
---

<html lang="en" class="h-full">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<link rel="icon" type="image/x-icon" href={`${base}${favicon}`} />
		<link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32x32.png`} />
		<link rel="icon" type="image/png" sizes="16x16" href={`${base}favicon-16x16.png`} />
		<link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
		<link rel="manifest" href={`${base}site.webmanifest`} />
		<meta name="theme-color" content="#FAF6EF" />

		{useArnoPro && <link rel="preconnect" href="https://use.typekit.net" crossorigin />}
		{useArnoPro && <link rel="stylesheet" href="https://use.typekit.net/mvc8kcq.css" />}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="preconnect" href="https://res.cloudinary.com" />
		<link
			href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;1,6..72,300&display=swap"
			rel="stylesheet"
		/>

		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="author" content={owner} />
		{pageDescription && <meta name="description" content={pageDescription} />}
		{keywords && <meta name="keywords" content={keywords} />}
		<link rel="canonical" href={canonicalUrl} />
		<link
			rel="alternate"
			type="application/rss+xml"
			title={`${owner} RSS Feed`}
			href={new URL('/feed.xml', siteUrl).toString()}
		/>
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content={siteConfig.title} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:title" content={pageTitle} />
		{pageDescription && <meta property="og:description" content={pageDescription} />}
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:alt" content={ogImageAlt} />
		{
			publishedTime && ogType === 'article' && (
				<meta property="article:published_time" content={publishedTime} />
			)
		}
		{
			modifiedTime && ogType === 'article' && (
				<meta property="article:modified_time" content={modifiedTime} />
			)
		}
		<meta name="twitter:card" content={twitterCard} />
		<meta name="twitter:title" content={pageTitle} />
		{pageDescription && <meta name="twitter:description" content={pageDescription} />}
		<meta name="twitter:url" content={canonicalUrl} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={ogImageAlt} />
		{twitterHandle && <meta name="twitter:site" content={twitterHandle} />}
		{twitterHandle && <meta name="twitter:creator" content={twitterHandle} />}
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<StructuredData data={websiteStructuredData} />
		<StructuredData data={structuredData} />
		{
			gaMeasurementId && (
				<script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`} />
			)
		}
		{gaBootstrapScript && <script is:inline set:html={gaBootstrapScript} />}
		<slot name="head" />
	</head>
	<body
		class:list={{ 'reading-face-arno': useArnoPro }}
		data-reading-face={useArnoPro ? 'arno' : undefined}
	>
		{
			showChrome ? (
				<>
					<NavBar />
					<main>
						<slot />
					</main>
					<Footer />
				</>
			) : (
				<slot />
			)
		}
	</body>
</html>
