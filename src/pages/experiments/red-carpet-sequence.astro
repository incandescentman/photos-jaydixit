---
export const prerender = true;

import { Image } from 'astro:assets';
import { comparisons } from '../../data/beforeAfter';
import '../../styles/global.css';

const comparisonSequence = [
	'Jason Bateman',
	'Vanessa Kirby',
	'Jeremy Strong',
	'John Hopfield',
	"Conan O'Brien",
	'Sydney Sweeney',
];

const sequencedComparisons = comparisonSequence.map((name) => {
	const comparison = comparisons.find((candidate) => candidate.name === name);
	if (!comparison) throw new Error(`Missing Before & After comparison for ${name}`);
	return comparison;
});
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Before &amp; After — Jay Dixit Photos</title>
		<meta
			name="description"
			content="Wikipedia portrait upgrades: see the difference professional photography makes"
		/>
		<meta name="robots" content="noindex, nofollow" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;1,6..72,300;1,6..72,400&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<header class="sequence-nav">
			<a class="wordmark" href="/">
				<img class="brand-seal" src="/brand/red-carpet-seal.svg" alt="" width="32" height="32" />
				<span>Jay Dixit Photos</span>
			</a>
			<nav aria-label="Experiment navigation">
				<a href="/red-carpet">Red Carpet</a>
				<a href="/before-after">Before &amp; After</a>
				<a href="/experiments">All experiments</a>
			</nav>
		</header>

		<main>
			<section class="finale" aria-labelledby="finale-title">
				<p class="kicker">The public portrait</p>
				<div class="finale-intro">
					<h1 id="finale-title">Before &amp; After</h1>
					<p class="finale-standfirst">
						Wikipedia deserves better photographs. As a red-carpet photographer for Wikipedia, I
						replace low-quality or outdated portraits with professional images I shoot at film
						festivals and cultural events.
					</p>
				</div>
				<div class="comparison-list">
					{
						sequencedComparisons.map((comparison, index) => (
							<article class="comparison-card">
								<header class="comparison-header">
									<span class="comparison-index">{String(index + 1).padStart(2, '0')}</span>
									<div>
										<h3>{comparison.name}</h3>
										<p>{comparison.event}</p>
									</div>
									<a
										class="editorial-link"
										href={comparison.article}
										target="_blank"
										rel="noopener noreferrer"
									>
										View on Wikipedia <span aria-hidden="true">↗</span>
									</a>
								</header>

								<div class="comparison-pair">
									<figure class="comparison-panel">
										<div class="comparison-frame">
											<Image
												class="comparison-image"
												src={comparison.beforeImage}
												alt={`${comparison.name} — previous Wikipedia photograph`}
												widths={[500, 800, 1200]}
												sizes="(max-width: 700px) 94vw, 41vw"
												style={`object-position:${comparison.beforePos}`}
												loading="lazy"
											/>
											<span class="comparison-label">Before</span>
										</div>
										<figcaption class="comparison-caption">
											<b>Before</b>
											<span>{comparison.beforeSource}</span>
										</figcaption>
									</figure>

									<div class="comparison-transition" aria-hidden="true">
										<img
											class="transition-arrow"
											src="/experiments/red-carpet-direction-arrow.png"
											alt=""
											width="508"
											height="512"
										/>
									</div>

									<figure class="comparison-panel">
										<div class="comparison-frame">
											<Image
												class="comparison-image"
												src={comparison.afterImage}
												alt={`${comparison.name} — photograph by Jay Dixit`}
												widths={[500, 800, 1200]}
												sizes="(max-width: 700px) 94vw, 41vw"
												style={`object-position:${comparison.afterPos}`}
												loading="lazy"
											/>
											<span class="comparison-label">After</span>
										</div>
										<figcaption class="comparison-caption">
											<b>After</b>
											<span>{comparison.afterSource}</span>
										</figcaption>
									</figure>
								</div>
							</article>
						))
					}
				</div>
				<div class="finale-actions">
					<a class="primary-action" href="/red-carpet">Explore Red Carpet</a>
				</div>
				<a class="experiment-return" href="/experiments">← Compare every homepage experiment</a>
			</section>
		</main>

		<script>
			import { gsap } from 'gsap';
			import { ScrollTrigger } from 'gsap/ScrollTrigger';

			gsap.registerPlugin(ScrollTrigger);

			const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

			if (!reducedMotion.matches) {
				const context = gsap.context(() => {
					gsap
						.timeline()
						.from('.sequence-nav', { y: -24, opacity: 0, duration: 0.7, ease: 'power3.out' })
						.from('.kicker', { y: 18, opacity: 0, duration: 0.5 }, '-=0.3')
						.from('#finale-title', {
							yPercent: 16,
							opacity: 0,
							duration: 1,
							ease: 'power4.out',
						})
						.from('.finale-standfirst', { y: 18, opacity: 0, duration: 0.65 }, '-=0.55');

					document.querySelectorAll('.comparison-card').forEach((card) => {
						gsap.from(card, {
							scrollTrigger: {
								trigger: card,
								start: 'top 86%',
								once: true,
							},
							y: 56,
							opacity: 0,
							duration: 0.9,
							ease: 'power3.out',
						});
					});
				});

				window.addEventListener('pagehide', () => context.revert(), { once: true });
			}
		</script>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		scroll-behavior: smooth;
		background: #f2eee5;
	}

	:global(body) {
		--ink: #16120f;
		--paper: #f2eee5;
		--red: #991f27;
		--gold: #96773f;
		--rule: rgb(22 18 15 / 22%);
		margin: 0;
		min-width: 320px;
		overflow-x: clip;
		background:
			linear-gradient(90deg, transparent 49.95%, rgb(22 18 15 / 5%) 50%, transparent 50.05%),
			var(--paper);
		color: var(--ink);
		font-family: 'Karla', system-ui, sans-serif;
	}

	.sequence-nav {
		position: absolute;
		z-index: 20;
		top: 0;
		left: 0;
		display: flex;
		justify-content: space-between;
		align-items: center;
		width: 100%;
		padding: 1.5rem clamp(1.25rem, 4vw, 4.5rem);
		border-bottom: 1px solid var(--rule);
	}

	.sequence-nav a {
		color: inherit;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.13em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.sequence-nav nav {
		display: flex;
		gap: clamp(1rem, 3vw, 2.8rem);
	}

	.sequence-nav a:hover,
	.sequence-nav a:focus-visible {
		color: var(--gold);
		outline-offset: 0.35rem;
	}

	.wordmark {
		display: inline-flex;
		gap: 0.65rem;
		align-items: center;
		font-family: 'Cormorant Garamond', Georgia, serif;
		font-size: 1rem !important;
		letter-spacing: 0.02em !important;
		text-transform: none !important;
	}

	.brand-seal {
		display: block;
		flex: none;
		width: 2rem;
		height: 2rem;
		transition: transform 220ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
	}

	.wordmark:hover .brand-seal,
	.wordmark:focus-visible .brand-seal {
		transform: rotate(-4deg) scale(1.06);
	}

	.kicker {
		margin: 0 0 1.25rem;
		color: var(--gold);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.finale {
		position: relative;
		min-height: 100svh;
		padding: clamp(9rem, 14vw, 13rem) clamp(1.25rem, 7vw, 8rem) 3rem;
		background: radial-gradient(circle at 10% 20%, rgb(153 31 39 / 8%), transparent 30rem), #fbf8f1;
	}

	.finale-intro {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) minmax(22rem, 0.5fr);
		gap: clamp(2rem, 6vw, 8rem);
		align-items: end;
		margin-bottom: clamp(3rem, 8vw, 7rem);
	}

	.finale h1 {
		margin: 0;
		font-family: 'Cormorant Garamond', Georgia, serif;
		font-size: clamp(4rem, 10vw, 10rem);
		font-weight: 500;
		letter-spacing: -0.06em;
		line-height: 0.82;
	}

	.finale-standfirst {
		max-width: 34rem;
		margin: 0 0 0.35rem;
		color: rgb(22 18 15 / 68%);
		font-family: 'Cormorant Garamond', Georgia, serif;
		font-size: clamp(1.2rem, 1.8vw, 1.55rem);
		font-weight: 400;
		line-height: 1.45;
	}

	.comparison-list {
		display: grid;
		gap: clamp(4rem, 9vw, 8rem);
	}

	.comparison-card {
		display: grid;
		gap: 1.25rem;
	}

	.comparison-header {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		gap: clamp(1rem, 3vw, 2rem);
		align-items: end;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--ink);
	}

	.comparison-index {
		color: var(--accent);
		font-family: var(--serif);
		font-size: 3.25rem;
		font-weight: 300;
		letter-spacing: -0.02em;
		line-height: 0.8;
		opacity: 0.55;
	}

	.comparison-header h3 {
		margin: 0;
		font-family: 'Cormorant Garamond', Georgia, serif;
		font-size: clamp(2rem, 4.5vw, 4rem);
		font-weight: 500;
		letter-spacing: -0.04em;
		line-height: 0.9;
	}

	.comparison-header p {
		margin: 0.875rem 0 0;
		color: var(--muted);
		font-family: var(--sans);
		font-size: 0.78rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.comparison-header a {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding-bottom: 0.375rem;
		border-bottom: 1px solid transparent;
		color: var(--accent);
		font-family: var(--sans);
		font-size: 0.81rem;
		font-weight: 400;
		letter-spacing: 0.04em;
		text-decoration: none;
		text-decoration-thickness: 1px;
		text-underline-offset: 2px;
		white-space: nowrap;
	}

	.comparison-header a:hover,
	.comparison-header a:focus-visible {
		color: #6f552a;
		text-decoration: underline;
	}

	.comparison-pair {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		gap: clamp(0.75rem, 2vw, 2rem);
		align-items: start;
		width: 90%;
		margin-inline: auto;
	}

	.comparison-panel {
		display: grid;
		gap: 0.8rem;
		margin: 0;
	}

	.comparison-transition {
		display: grid;
		justify-items: center;
		align-self: center;
		width: clamp(5rem, 7vw, 7rem);
		color: var(--red);
	}

	.transition-arrow {
		display: block;
		width: clamp(3.5rem, 5vw, 4.75rem);
		height: auto;
		filter: drop-shadow(0 0.4rem 1rem rgb(54 31 25 / 14%));
	}

	.comparison-frame {
		position: relative;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		background: #ddd7cc;
		box-shadow: 0 2rem 7rem rgb(54 31 25 / 14%);
	}

	:global(.comparison-image) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.comparison-label {
		position: absolute;
		top: 1rem;
		left: 1rem;
		padding: 0.55rem 0.7rem;
		background: rgb(251 248 241 / 88%);
		color: var(--ink);
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		pointer-events: none;
		text-transform: uppercase;
		backdrop-filter: blur(8px);
	}

	.comparison-caption {
		display: flex;
		gap: 0.65rem;
		color: rgb(22 18 15 / 62%);
		font-size: 0.72rem;
		line-height: 1.4;
	}

	.comparison-caption b {
		color: var(--ink);
		font-size: 0.64rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.finale-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 2rem;
		align-items: center;
		margin: clamp(3rem, 7vw, 6rem) 0;
	}

	.finale-actions a,
	.experiment-return {
		color: inherit;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.primary-action {
		padding: 1rem 1.35rem;
		background: var(--red);
		color: white !important;
	}

	.finale-actions a:hover,
	.finale-actions a:focus-visible,
	.experiment-return:hover,
	.experiment-return:focus-visible {
		text-decoration: underline;
		text-underline-offset: 0.35rem;
	}

	.experiment-return {
		display: inline-block;
		margin-top: 3rem;
		color: rgb(22 18 15 / 58%);
	}

	@media (max-width: 700px) {
		.sequence-nav nav a:not(:last-child) {
			display: none;
		}

		.finale h1 {
			font-size: clamp(4rem, 20vw, 7rem);
			line-height: 0.8;
		}

		.finale-intro {
			grid-template-columns: 1fr;
			gap: 1.75rem;
		}

		.finale {
			padding-right: 1rem;
			padding-left: 1rem;
		}

		.comparison-header {
			grid-template-columns: auto minmax(0, 1fr);
		}

		.comparison-header > a {
			grid-column: 2;
			justify-self: start;
		}

		.comparison-pair {
			grid-template-columns: 1fr;
			gap: 1.25rem;
			width: 100%;
		}

		.comparison-transition {
			justify-self: center;
			width: 5.5rem;
			margin-block: 0.4rem;
		}

		.transition-arrow {
			width: 4rem;
			transform: rotate(90deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		:global(html) {
			scroll-behavior: auto;
		}

		:global(*),
		:global(*::before),
		:global(*::after) {
			scroll-behavior: auto !important;
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
		}
	}
</style>
