---
export const prerender = true;

import { images } from '../../data/homepage-images.js';
import siteConfig from '../../../site.config.mts';
import '../../styles/global.css';

const CLOUD = 'dszpm7yps';
const imageUrl = (image, width = 1000) => {
	const publicId =
		image.cloudinaryPublicId ?? `highlights/${image.filename.replace(/\.[^.]+$/, '')}`;
	return `https://res.cloudinary.com/${CLOUD}/image/upload/f_auto,q_auto,w_${width}/${publicId}`;
};
const fileLabel = (image) => image.filename.replace(/\.[^.]+$/, '');
const selected = [images[13], images[7], images[15], images[13]];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Contact Sheet / Public Record — {siteConfig.owner}</title>
		<meta
			name="description"
			content="An experimental contact-sheet homepage for Jay Dixit's Wikipedia portraits."
		/>
		<meta name="robots" content="noindex, nofollow" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://res.cloudinary.com" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<main class="record">
			<header class="record-header">
				<a href="/" class="record-mark">Jay Dixit / Wikipedia Portraits</a>
				<nav aria-label="Primary navigation">
					<a class="active" href="/gallery">Work</a><a href="/about">Impact</a><a href="/about"
						>About</a
					>
				</nav>
			</header>

			<section class="record-hero" aria-labelledby="record-title">
				<div class="record-copy">
					<p class="record-eyebrow">Photographs in the public record</p>
					<h1 id="record-title">
						<span>Portraits</span><span>made to</span><span>be seen.</span>
					</h1>
					<p class="record-lede">
						Red carpet portraits, freely licensed for Wikipedia and the commons.
					</p>
					<a class="record-cta" href="/gallery"
						>Explore the archive <span aria-hidden="true">→</span></a
					>

					<dl class="record-stats">
						<div><dt>Wikipedia views</dt><dd>10M+</dd></div>
						<div><dt>License</dt><dd>Open</dd></div>
						<div><dt>Status</dt><dd>Updating</dd></div>
					</dl>
				</div>

				<div class="contact-sheet" aria-label="Selected portraits">
					<span class="sheet-axis axis-left" aria-hidden="true">Color portrait / archive</span>
					<span class="sheet-axis axis-right" aria-hidden="true">Detail / color</span>
					<span class="sheet-cross cross-left" aria-hidden="true"></span>
					<span class="sheet-cross cross-right" aria-hidden="true"></span>

					<figure class="frame frame-main">
						<div class="frame-meta" aria-hidden="true">
							<span>JD—Archive / 001–004</span><b>001</b>
						</div>
						<div class="frame-media">
							<span class="crop tl" aria-hidden="true"></span><span
								class="crop br"
								aria-hidden="true"></span>
							<img src={imageUrl(selected[0], 1200)} alt={selected[0].caption} loading="eager" />
						</div>
						<figcaption>
							<strong>{fileLabel(selected[0])}</strong>
							<span>{selected[0].caption}</span>
						</figcaption>
					</figure>

					<div class="frame-stack">
						{
							selected.slice(1, 3).map((photo, index) => (
								<figure class="frame">
									<div class="frame-meta" aria-hidden="true">
										<span>JD / Portrait</span>
										<b>00{index + 2}</b>
									</div>
									<div class="frame-media">
										<span class="crop tl" aria-hidden="true" />
										<span class="crop br" aria-hidden="true" />
										<img src={imageUrl(photo, 760)} alt={photo.caption} loading="eager" />
									</div>
									<figcaption>
										<strong>{fileLabel(photo)}</strong>
										<span>{photo.caption}</span>
									</figcaption>
								</figure>
							))
						}
					</div>

					<figure class="frame frame-detail">
						<div class="frame-meta" aria-hidden="true">
							<span>Detail</span><b>004</b>
						</div>
						<div class="frame-media">
							<span class="crop tl" aria-hidden="true"></span><span
								class="crop br"
								aria-hidden="true"></span>
							<img
								class="detail-image"
								src={imageUrl(selected[3], 900)}
								alt={`${selected[3].caption}, detail crop`}
								loading="eager"
							/>
						</div>
						<figcaption>
							<strong>{fileLabel(selected[3])}</strong><span>Detail</span>
						</figcaption>
					</figure>
				</div>
			</section>

			<a class="record-return" href="/">← Current photography homepage</a>
		</main>
	</body>
</html>

<style is:global>
	:root {
		--record-black: #07090c;
		--record-panel: #0d1117;
		--record-white: #f3f0e9;
		--record-gray: #8d949e;
		--record-blue: #2872ff;
		--record-rule: #292e36;
	}

	* {
		box-sizing: border-box;
	}

	html {
		background: var(--record-black);
	}

	body {
		margin: 0;
		min-width: 320px;
		background:
			radial-gradient(circle at 75% 35%, rgba(34, 68, 122, 0.06), transparent 28rem),
			var(--record-black);
		color: var(--record-white);
		font-family: 'Instrument Sans', system-ui, sans-serif;
	}

	.record {
		width: min(100%, 1600px);
		min-height: 100svh;
		margin: 0 auto;
		padding: 0 28px 28px;
	}

	.record-header {
		height: 68px;
		border-bottom: 1px solid var(--record-rule);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 30px;
	}

	.record-mark {
		color: var(--record-white);
		font-size: 13px;
		font-weight: 800;
		letter-spacing: 0.06em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.record-header nav {
		display: flex;
		gap: 54px;
	}

	.record-header nav a {
		position: relative;
		color: var(--record-white);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.record-header nav a::after {
		position: absolute;
		right: 100%;
		bottom: -9px;
		left: 0;
		height: 1px;
		background: var(--record-blue);
		content: '';
		transition: right 0.2s ease;
	}

	.record-header nav a.active::after,
	.record-header nav a:hover::after,
	.record-header nav a:focus-visible::after {
		right: 0;
	}

	.record-hero {
		min-height: calc(100svh - 68px);
		display: grid;
		grid-template-columns: minmax(410px, 0.74fr) minmax(760px, 1.26fr);
		gap: clamp(44px, 4.5vw, 76px);
		align-items: start;
		padding: 38px 12px 30px;
	}

	.record-copy {
		align-self: start;
		padding-top: 25px;
	}

	.record-eyebrow {
		margin: 0 0 30px;
		color: var(--record-blue);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.25em;
		text-transform: uppercase;
	}

	#record-title {
		max-width: 570px;
		margin: 0;
		font-family: 'Instrument Sans', system-ui, sans-serif;
		font-size: clamp(70px, 5.9vw, 94px);
		font-weight: 800;
		letter-spacing: -0.068em;
		line-height: 0.9;
	}

	#record-title span {
		display: block;
		white-space: nowrap;
	}

	.record-lede {
		max-width: 470px;
		margin: 28px 0 0;
		color: #c5c8cd;
		font-size: clamp(17px, 1.35vw, 21px);
		line-height: 1.42;
	}

	.record-cta {
		min-width: 290px;
		display: inline-flex;
		align-items: center;
		justify-content: space-between;
		gap: 34px;
		margin-top: 30px;
		padding: 20px 24px;
		background: var(--record-blue);
		color: white;
		font-size: 11px;
		font-weight: 750;
		letter-spacing: 0.15em;
		text-decoration: none;
		text-transform: uppercase;
		transition: background 0.2s ease;
	}

	.record-cta:hover,
	.record-cta:focus-visible {
		background: #165ee8;
	}

	.record-cta span {
		font-size: 23px;
		transition: transform 0.2s ease;
	}

	.record-cta:hover span,
	.record-cta:focus-visible span {
		transform: translateX(5px);
	}

	.record-stats {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		margin: 40px 0 0;
		border-top: 1px solid var(--record-rule);
	}

	.record-stats div {
		min-height: 90px;
		display: flex;
		padding: 14px 14px 10px;
		border-left: 1px solid var(--record-rule);
		flex-direction: column;
	}

	.record-stats div:first-child {
		border-left: 0;
	}

	.record-stats dt {
		order: 2;
		margin-top: 8px;
		color: var(--record-gray);
		font-size: 7px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.record-stats dd {
		order: 1;
		margin: 0;
		color: var(--record-white);
		font-size: clamp(22px, 2vw, 31px);
		font-weight: 750;
		letter-spacing: -0.035em;
		line-height: 1;
	}

	.record-stats div:first-child dd::first-letter {
		color: var(--record-blue);
	}

	.contact-sheet {
		position: relative;
		min-width: 0;
		display: grid;
		grid-template-columns: minmax(400px, 1.55fr) minmax(220px, 0.9fr) minmax(72px, 0.28fr);
		gap: 15px;
		align-items: start;
		margin-top: 0;
	}

	.frame {
		position: relative;
		min-width: 0;
		margin: 0;
	}

	.frame-meta {
		height: 20px;
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		color: var(--record-blue);
		font-size: 8px;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.frame-meta b {
		font-weight: 650;
	}

	.frame-media {
		position: relative;
		overflow: hidden;
		border: 1px solid #3b424c;
		background: var(--record-panel);
	}

	.frame img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: none;
		transition: filter 0.22s ease;
	}

	.frame:hover img {
		filter: saturate(1.05) contrast(1.03);
	}

	.frame-main .frame-media,
	.frame-detail .frame-media {
		height: clamp(540px, 68.5vh, 640px);
	}

	.frame-main img {
		object-position: center 18%;
	}

	.frame-stack {
		display: grid;
		gap: 16px;
	}

	.frame-stack .frame-media {
		height: clamp(225px, 28.5vh, 260px);
	}

	.frame-stack img {
		object-position: center 20%;
	}

	.frame-detail .detail-image {
		object-position: 47% 22%;
		filter: brightness(1.12) saturate(1.04);
		transform: scale(1.65);
		transform-origin: 47% 22%;
	}

	.frame figcaption {
		min-height: 49px;
		display: grid;
		gap: 5px;
		padding: 9px 6px 0;
		color: var(--record-gray);
		font-size: 7px;
		line-height: 1.25;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.frame figcaption strong {
		overflow: hidden;
		color: var(--record-blue);
		font-weight: 600;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.frame-detail figcaption {
		text-align: center;
	}

	.crop {
		position: absolute;
		z-index: 3;
		width: 17px;
		height: 17px;
		pointer-events: none;
	}

	.crop.tl {
		top: 9px;
		left: 9px;
		border-top: 1px solid var(--record-blue);
		border-left: 1px solid var(--record-blue);
	}

	.crop.br {
		right: 9px;
		bottom: 9px;
		border-right: 1px solid var(--record-blue);
		border-bottom: 1px solid var(--record-blue);
	}

	.sheet-axis {
		position: absolute;
		z-index: 4;
		color: var(--record-blue);
		font-size: 8px;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		writing-mode: vertical-rl;
	}

	.axis-left {
		top: 176px;
		left: -22px;
		transform: rotate(180deg);
	}

	.axis-right {
		right: -19px;
		bottom: 108px;
	}

	.sheet-cross {
		position: absolute;
		bottom: -1px;
		width: 17px;
		height: 17px;
	}

	.sheet-cross::before,
	.sheet-cross::after {
		position: absolute;
		background: var(--record-blue);
		content: '';
	}

	.sheet-cross::before {
		top: 8px;
		width: 17px;
		height: 1px;
	}

	.sheet-cross::after {
		left: 8px;
		width: 1px;
		height: 17px;
	}

	.cross-left {
		left: -4px;
	}

	.cross-right {
		right: -4px;
	}

	.record-return {
		display: inline-block;
		margin-left: 12px;
		color: var(--record-gray);
		font-size: 8px;
		letter-spacing: 0.13em;
		text-transform: uppercase;
		text-underline-offset: 4px;
	}

	@media (max-width: 1240px) {
		.record-hero {
			grid-template-columns: minmax(380px, 0.72fr) minmax(650px, 1.28fr);
			gap: 34px;
		}

		#record-title {
			font-size: clamp(66px, 6.2vw, 82px);
		}

		.contact-sheet {
			grid-template-columns: minmax(350px, 1.5fr) minmax(205px, 0.88fr) 70px;
		}
	}

	@media (max-width: 1040px) {
		.record {
			padding-inline: 22px;
		}

		.record-hero {
			min-height: auto;
			grid-template-columns: 1fr;
			gap: 58px;
			padding-block: 48px;
		}

		.record-copy {
			max-width: 680px;
		}

		#record-title {
			font-size: clamp(72px, 9vw, 98px);
		}

		.contact-sheet {
			grid-template-columns: minmax(0, 1.5fr) minmax(230px, 0.85fr) 82px;
		}
	}

	@media (max-width: 700px) {
		.record {
			padding-inline: 17px;
		}

		.record-header {
			height: auto;
			min-height: 88px;
			align-items: flex-start;
			padding-block: 18px;
			flex-direction: column;
			gap: 14px;
		}

		.record-mark {
			font-size: 11px;
		}

		.record-header nav {
			gap: 30px;
		}

		.record-hero {
			gap: 44px;
			padding: 36px 0 28px;
		}

		.record-eyebrow {
			margin-bottom: 26px;
			font-size: 9px;
			letter-spacing: 0.2em;
		}

		#record-title {
			font-size: clamp(61px, 18vw, 82px);
			line-height: 0.88;
		}

		.record-lede {
			margin-top: 25px;
			font-size: 18px;
		}

		.record-cta {
			width: min(100%, 310px);
			min-width: 0;
		}

		.record-stats div {
			min-height: 84px;
			padding-inline: 9px;
		}

		.record-stats dd {
			font-size: 20px;
		}

		.contact-sheet {
			grid-template-columns: 1fr;
			gap: 19px;
			margin-top: 10px;
		}

		.frame-main .frame-media {
			height: min(68vh, 610px);
		}

		.frame-stack {
			grid-template-columns: 1fr 1fr;
			gap: 12px;
		}

		.frame-stack .frame-media {
			height: 38vh;
			min-height: 260px;
		}

		.frame-detail,
		.sheet-axis,
		.sheet-cross {
			display: none;
		}

		.frame figcaption {
			min-height: 56px;
			white-space: normal;
		}

		.record-return {
			margin: 24px 0 0;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.record-copy {
			animation: copy-in 0.5s ease-out both;
		}

		.frame {
			animation: frame-in 0.52s ease-out both;
		}

		.frame-stack .frame:nth-child(1) {
			animation-delay: 0.06s;
		}

		.frame-stack .frame:nth-child(2) {
			animation-delay: 0.12s;
		}

		@keyframes copy-in {
			from {
				opacity: 0;
				transform: translateY(12px);
			}
			to {
				opacity: 1;
				transform: none;
			}
		}

		@keyframes frame-in {
			from {
				opacity: 0;
				transform: translateY(10px);
			}
			to {
				opacity: 1;
				transform: none;
			}
		}
	}
</style>
