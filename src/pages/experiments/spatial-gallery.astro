---
export const prerender = true;

import { images } from '../../data/homepage-images.js';
import siteConfig from '../../../site.config.mts';
import '../../styles/global.css';

const CLOUD = 'dszpm7yps';

const selectedIndexes = [2, 8, 9, 11, 18, 22, 23, 25, 31, 32, 33, 0];
const selected = selectedIndexes.map((index) => images[index]).filter(Boolean);

const publicIdFor = (image) =>
	image.cloudinaryPublicId ?? `highlights/${image.filename.replace(/\.[^.]+$/, '')}`;

const imageUrl = (image, width = 1200) =>
	`https://res.cloudinary.com/${CLOUD}/image/upload/f_auto,q_auto,w_${width}/${publicIdFor(image)}`;

const imageSrcset = (image, widths = [480, 720, 960, 1440]) =>
	widths.map((width) => `${imageUrl(image, width)} ${width}w`).join(', ');
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Spatial Gallery — {siteConfig.owner}</title>
		<meta
			name="description"
			content="An experimental spatial homepage for Jay Dixit’s red carpet photography."
		/>
		<meta name="robots" content="noindex, nofollow" />
		<meta name="theme-color" content="#f5f0e7" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://res.cloudinary.com" />
	</head>
	<body>
		<main class="spatial-page">
			<section class="spatial-hero" aria-labelledby="spatial-title">
				<div class="spatial-stage" data-spatial-stage aria-hidden="true">
					<div class="spatial-canvas" data-spatial-canvas></div>
					<div class="fallback-field" data-spatial-fallback>
						{
							selected.slice(0, 8).map((photo, index) => (
								<figure class={`fallback-plane fallback-plane-${index + 1}`}>
									<img src={imageUrl(photo, 720)} alt="" loading={index < 4 ? 'eager' : 'lazy'} />
								</figure>
							))
						}
					</div>
					<div class="spatial-grain"></div>
				</div>

				<header class="spatial-header">
					<a class="spatial-wordmark" href="/">Jay Dixit Photos</a>
					<nav aria-label="Primary navigation">
						<a href="/gallery">Galleries</a>
						<a href="/red-carpet">People</a>
						<a href="/about">About</a>
					</nav>
				</header>

				<div class="spatial-copy">
					<p class="spatial-kicker" data-hero-reveal>Red carpet portraits / public record</p>
					<h1 id="spatial-title" data-hero-reveal>
						Jay Dixit — Red Carpet Photography for Wikipedia
					</h1>
					<p class="spatial-lede" data-hero-reveal>
						I photograph actors, directors, and public figures at film festivals and premieres, then
						release the portraits under a free license so their Wikipedia articles can finally have
						great photos.
					</p>
					<a class="spatial-primary-link" href="/before-and-after" data-hero-reveal>
						<span>See the Before &amp; After</span>
						<svg viewBox="0 0 48 18" aria-hidden="true">
							<path d="M1 9h43M37 2l7 7-7 7"></path>
						</svg>
					</a>
				</div>

				<a class="scroll-cue" href="#selected-work" aria-label="Scroll to selected work">
					<span>Selected work</span>
					<i aria-hidden="true"></i>
				</a>

				<p class="spatial-index" aria-hidden="true">
					<span>Spatial study</span>
					<span>1—12</span>
				</p>
			</section>

			<section class="selected-work" id="selected-work" aria-labelledby="selected-work-title">
				<header class="section-heading">
					<p>Portraits from the archive</p>
					<h2 id="selected-work-title">Selected work</h2>
					<span aria-hidden="true">12 photographs</span>
				</header>

				<div class="portrait-grid">
					{
						selected.map((photo, index) => (
							<article class="portrait-card" data-gallery-card>
								<a
									href={imageUrl(photo, 2400)}
									target="_blank"
									rel="noreferrer"
									aria-label={`View ${photo.caption} at full size`}
								>
									<figure>
										<div class="portrait-media">
											<img
												src={imageUrl(photo, 960)}
												srcset={imageSrcset(photo)}
												sizes="(max-width: 700px) 92vw, (max-width: 1100px) 46vw, 31vw"
												alt={photo.caption}
												width="960"
												height={photo.size === 'landscape' ? '640' : '1280'}
												loading={index < 2 ? 'eager' : 'lazy'}
												decoding="async"
												data-spatial-src={imageUrl(photo, 960)}
											/>
											<span class="view-label">View photograph ↗</span>
										</div>
										<figcaption>
											<span>{index + 1}</span>
											<strong>{photo.caption}</strong>
										</figcaption>
									</figure>
								</a>
							</article>
						))
					}
				</div>
			</section>

			<section class="archive-cta" aria-labelledby="archive-cta-title">
				<p>Continue through the archive</p>
				<h2 id="archive-cta-title">Explore the archive</h2>
				<div class="archive-links">
					<a href="/gallery"><span>Browse all galleries</span><b aria-hidden="true">↗</b></a>
					<a href="/red-carpet"><span>Find a person</span><b aria-hidden="true">↗</b></a>
					<a href="/before-and-after"
						><span>See the Wikipedia impact</span><b aria-hidden="true">↗</b></a
					>
				</div>
			</section>

			<footer class="spatial-footer">
				<a href="/">← Return to the current photography homepage</a>
				<p>Experimental spatial gallery</p>
			</footer>
		</main>

		<script>
			import '../../scripts/experiments/spatialGallery';
		</script>
	</body>
</html>

<style is:global>
	:root {
		--spatial-paper: #f5f0e7;
		--spatial-paper-bright: #fffdf8;
		--spatial-ink: #171614;
		--spatial-muted: #756e64;
		--spatial-accent: #9b3d31;
		--spatial-line: rgb(23 22 20 / 20%);
		color-scheme: light;
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
		background: var(--spatial-paper);
	}

	body {
		margin: 0;
		min-width: 320px;
		overflow-x: clip;
		background: var(--spatial-paper);
		color: var(--spatial-ink);
		font-family: 'Karla', system-ui, sans-serif;
	}

	a {
		color: inherit;
	}

	a:focus-visible {
		border-radius: 2px;
		outline: 2px solid var(--spatial-accent);
		outline-offset: 5px;
	}

	.spatial-page {
		overflow: clip;
	}

	.spatial-hero {
		position: relative;
		isolation: isolate;
		min-height: 100svh;
		overflow: hidden;
		background:
			radial-gradient(circle at 72% 32%, rgb(255 255 255 / 84%), transparent 36rem),
			linear-gradient(135deg, #f8f4ed 0%, #eee7dc 100%);
	}

	.spatial-stage,
	.spatial-canvas,
	.fallback-field,
	.spatial-grain {
		position: absolute;
		inset: 0;
	}

	.spatial-stage {
		z-index: -1;
	}

	.spatial-canvas {
		opacity: 0;
		transition: opacity 700ms ease;
	}

	.spatial-canvas canvas {
		display: block;
		width: 100%;
		height: 100%;
	}

	.spatial-ready .spatial-canvas {
		opacity: 1;
	}

	.spatial-ready .fallback-field {
		opacity: 0;
		visibility: hidden;
	}

	.fallback-field {
		transition:
			opacity 500ms ease,
			visibility 500ms;
	}

	.fallback-plane {
		position: absolute;
		overflow: hidden;
		margin: 0;
		padding: 7px;
		background: var(--spatial-paper-bright);
		box-shadow: 0 22px 70px rgb(68 53 33 / 15%);
	}

	.fallback-plane img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.fallback-plane-1 {
		top: 10%;
		right: 8%;
		width: clamp(170px, 17vw, 300px);
		aspect-ratio: 0.76;
		transform: rotate(3deg);
	}

	.fallback-plane-2 {
		top: 50%;
		right: 27%;
		width: clamp(130px, 13vw, 230px);
		aspect-ratio: 0.68;
		transform: rotate(-5deg);
	}

	.fallback-plane-3 {
		right: -3%;
		bottom: -6%;
		width: clamp(240px, 25vw, 430px);
		aspect-ratio: 1.5;
		transform: rotate(-2deg);
	}

	.fallback-plane-4 {
		top: -8%;
		left: 29%;
		width: clamp(150px, 15vw, 270px);
		aspect-ratio: 0.68;
		transform: rotate(-4deg);
	}

	.fallback-plane-5 {
		bottom: -13%;
		left: -4%;
		width: clamp(190px, 20vw, 360px);
		aspect-ratio: 0.72;
		transform: rotate(5deg);
	}

	.fallback-plane-6 {
		top: 43%;
		right: -5%;
		width: clamp(120px, 12vw, 210px);
		aspect-ratio: 0.67;
		transform: rotate(5deg);
	}

	.fallback-plane-7 {
		top: 7%;
		left: -4%;
		width: clamp(110px, 11vw, 200px);
		aspect-ratio: 0.67;
		transform: rotate(-3deg);
	}

	.fallback-plane-8 {
		right: 41%;
		bottom: -22%;
		width: clamp(160px, 17vw, 300px);
		aspect-ratio: 0.8;
		transform: rotate(4deg);
	}

	.spatial-grain {
		pointer-events: none;
		opacity: 0.22;
		background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.72' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.14'/%3E%3C/svg%3E");
		mix-blend-mode: multiply;
	}

	.spatial-header {
		position: absolute;
		z-index: 4;
		top: 0;
		left: 0;
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		padding: 1.65rem clamp(1.25rem, 4vw, 4.5rem);
		border-bottom: 1px solid var(--spatial-line);
	}

	.spatial-wordmark,
	.spatial-header nav a,
	.spatial-kicker,
	.scroll-cue,
	.spatial-index,
	.section-heading p,
	.section-heading > span,
	.archive-cta > p,
	.spatial-footer {
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.17em;
		text-transform: uppercase;
	}

	.spatial-wordmark {
		text-decoration: none;
	}

	.spatial-header nav {
		display: flex;
		gap: clamp(1.1rem, 3vw, 3.4rem);
	}

	.spatial-header nav a {
		position: relative;
		text-decoration: none;
	}

	.spatial-header nav a::after {
		position: absolute;
		right: 100%;
		bottom: -0.35rem;
		left: 0;
		height: 1px;
		background: currentColor;
		content: '';
		transition: right 220ms ease;
	}

	.spatial-header nav a:hover::after,
	.spatial-header nav a:focus-visible::after {
		right: 0;
	}

	.spatial-copy {
		position: absolute;
		z-index: 3;
		top: 50%;
		left: clamp(1.25rem, 6vw, 7rem);
		width: min(49rem, 55vw);
		padding: clamp(1rem, 2.2vw, 2rem);
		transform: translateY(-47%);
		background: linear-gradient(
			100deg,
			rgb(245 240 231 / 94%) 45%,
			rgb(245 240 231 / 72%) 78%,
			transparent
		);
	}

	.spatial-kicker {
		margin: 0 0 1.3rem;
		color: var(--spatial-accent);
	}

	.spatial-copy h1 {
		max-width: 46rem;
		margin: 0;
		font-family: 'Cormorant Garamond', Georgia, serif;
		font-size: clamp(3.7rem, 7.5vw, 8.5rem);
		font-weight: 500;
		letter-spacing: -0.06em;
		line-height: 0.79;
		text-wrap: balance;
	}

	.spatial-lede {
		max-width: 39rem;
		margin: clamp(1.5rem, 3vw, 2.5rem) 0 0;
		color: #4c4740;
		font-size: clamp(1rem, 1.45vw, 1.28rem);
		line-height: 1.48;
	}

	.spatial-primary-link {
		display: inline-flex;
		gap: 1.2rem;
		align-items: center;
		margin-top: 1.9rem;
		padding-bottom: 0.42rem;
		border-bottom: 1px solid var(--spatial-ink);
		font-size: 0.73rem;
		font-weight: 700;
		letter-spacing: 0.13em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.spatial-primary-link svg {
		width: 2.6rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.2;
		transition: transform 220ms ease;
	}

	.spatial-primary-link:hover svg,
	.spatial-primary-link:focus-visible svg {
		transform: translateX(0.35rem);
	}

	.scroll-cue {
		position: absolute;
		z-index: 4;
		bottom: 2rem;
		left: 50%;
		display: grid;
		gap: 0.8rem;
		justify-items: center;
		text-decoration: none;
		transform: translateX(-50%);
	}

	.scroll-cue i {
		display: block;
		width: 1px;
		height: 2.5rem;
		overflow: hidden;
		background: var(--spatial-line);
	}

	.scroll-cue i::after {
		display: block;
		width: 100%;
		height: 45%;
		background: var(--spatial-ink);
		content: '';
		animation: scroll-pulse 1.8s ease-in-out infinite;
	}

	.spatial-index {
		position: absolute;
		z-index: 3;
		right: clamp(1.25rem, 4vw, 4.5rem);
		bottom: 2rem;
		display: flex;
		gap: 1.2rem;
		margin: 0;
		writing-mode: vertical-rl;
	}

	@keyframes scroll-pulse {
		from {
			transform: translateY(-120%);
		}
		to {
			transform: translateY(250%);
		}
	}

	.selected-work {
		position: relative;
		padding: clamp(5rem, 10vw, 10rem) clamp(1rem, 4vw, 4.5rem);
		background: #fbf8f2;
	}

	.section-heading {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: end;
		margin-bottom: clamp(3rem, 6vw, 6rem);
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--spatial-line);
	}

	.section-heading p,
	.section-heading h2,
	.section-heading > span {
		margin: 0;
	}

	.section-heading h2 {
		font-family: 'Cormorant Garamond', Georgia, serif;
		font-size: clamp(3.2rem, 7vw, 7.5rem);
		font-weight: 500;
		letter-spacing: -0.055em;
		line-height: 0.8;
	}

	.section-heading > span {
		justify-self: end;
		color: var(--spatial-muted);
	}

	.portrait-grid {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		gap: clamp(1rem, 2vw, 2rem);
		align-items: start;
	}

	.portrait-card {
		grid-column: span 4;
		margin-bottom: clamp(2.5rem, 5vw, 6rem);
	}

	.portrait-card:nth-child(6n + 2),
	.portrait-card:nth-child(6n + 5) {
		grid-column: span 5;
	}

	.portrait-card:nth-child(6n + 3) {
		grid-column: 10 / span 3;
		margin-top: 8rem;
	}

	.portrait-card:nth-child(6n + 4) {
		grid-column: 2 / span 3;
		margin-top: 4rem;
	}

	.portrait-card a,
	.portrait-card figure {
		display: block;
		margin: 0;
		text-decoration: none;
	}

	.portrait-media {
		position: relative;
		overflow: hidden;
		background: #e7dfd3;
	}

	.portrait-media::after {
		position: absolute;
		inset: 0;
		border: 1px solid rgb(255 255 255 / 35%);
		content: '';
		pointer-events: none;
	}

	.portrait-card img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 3 / 4;
		object-fit: cover;
		transition:
			transform 700ms cubic-bezier(0.2, 0.72, 0.2, 1),
			filter 500ms ease;
	}

	.portrait-card:nth-child(3n + 2) img {
		aspect-ratio: 4 / 5;
	}

	.portrait-card:nth-child(4n) img {
		aspect-ratio: 1 / 1.18;
	}

	.view-label {
		position: absolute;
		right: 0.8rem;
		bottom: 0.8rem;
		padding: 0.55rem 0.72rem;
		background: rgb(255 253 248 / 92%);
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.11em;
		opacity: 0;
		text-transform: uppercase;
		transform: translateY(0.4rem);
		transition:
			opacity 220ms ease,
			transform 220ms ease;
	}

	.portrait-card a:hover img,
	.portrait-card a:focus-visible img {
		filter: saturate(1.06) contrast(1.02);
		transform: scale(1.025);
	}

	.portrait-card a:hover .view-label,
	.portrait-card a:focus-visible .view-label {
		opacity: 1;
		transform: translateY(0);
	}

	.portrait-card figcaption {
		display: grid;
		grid-template-columns: 2rem 1fr;
		gap: 0.65rem;
		align-items: start;
		padding-top: 0.8rem;
		border-top: 1px solid var(--spatial-line);
	}

	.portrait-card figcaption span {
		color: var(--spatial-accent);
		font-size: 0.64rem;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	.portrait-card figcaption strong {
		font-family: 'Karla', system-ui, sans-serif;
		font-size: clamp(0.78rem, 1vw, 0.93rem);
		font-weight: 500;
		line-height: 1.35;
	}

	.archive-cta {
		padding: clamp(5rem, 11vw, 11rem) clamp(1rem, 8vw, 9rem);
		background: var(--spatial-ink);
		color: #f7f1e7;
	}

	.archive-cta > p {
		margin: 0 0 2rem;
		color: #c8bfb2;
	}

	.archive-cta h2 {
		max-width: 72rem;
		margin: 0;
		font-family: 'Cormorant Garamond', Georgia, serif;
		font-size: clamp(3.4rem, 8vw, 8.5rem);
		font-weight: 400;
		letter-spacing: -0.055em;
		line-height: 0.87;
		text-wrap: balance;
	}

	.archive-links {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		margin-top: clamp(4rem, 8vw, 8rem);
		border-top: 1px solid rgb(255 255 255 / 25%);
	}

	.archive-links a {
		display: flex;
		justify-content: space-between;
		padding: 1.6rem 1.2rem 1.6rem 0;
		border-right: 1px solid rgb(255 255 255 / 25%);
		font-size: 0.76rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-decoration: none;
		text-transform: uppercase;
		transition:
			padding 220ms ease,
			color 220ms ease;
	}

	.archive-links a + a {
		padding-left: 1.2rem;
	}

	.archive-links a:last-child {
		border-right: 0;
	}

	.archive-links a:hover,
	.archive-links a:focus-visible {
		padding-right: 0.5rem;
		color: #d9a99d;
	}

	.spatial-footer {
		display: flex;
		justify-content: space-between;
		padding: 1.5rem clamp(1rem, 4vw, 4.5rem);
		background: var(--spatial-paper);
	}

	.spatial-footer a {
		text-decoration: none;
	}

	.spatial-footer p {
		margin: 0;
		color: var(--spatial-muted);
	}

	@media (max-width: 900px) {
		.spatial-header nav {
			display: none;
		}

		.spatial-copy {
			top: 48%;
			width: min(88vw, 42rem);
			background: rgb(245 240 231 / 82%);
			backdrop-filter: blur(8px);
		}

		.spatial-copy h1 {
			font-size: clamp(3.25rem, 12vw, 6rem);
		}

		.fallback-plane-2,
		.fallback-plane-4,
		.fallback-plane-6,
		.fallback-plane-7,
		.fallback-plane-8 {
			display: none;
		}

		.fallback-plane-1 {
			top: 8%;
			right: -6%;
			width: 42vw;
		}

		.fallback-plane-3 {
			right: -12%;
			bottom: -3%;
			width: 70vw;
		}

		.fallback-plane-5 {
			bottom: -8%;
			left: -18%;
			width: 48vw;
		}

		.section-heading {
			grid-template-columns: 1fr auto;
		}

		.section-heading p {
			display: none;
		}

		.portrait-card,
		.portrait-card:nth-child(n) {
			grid-column: span 6;
			margin-top: 0;
		}

		.archive-links {
			grid-template-columns: 1fr;
		}

		.archive-links a,
		.archive-links a + a {
			padding-right: 0;
			padding-left: 0;
			border-right: 0;
			border-bottom: 1px solid rgb(255 255 255 / 25%);
		}
	}

	@media (max-width: 620px) {
		.spatial-header {
			padding-block: 1.2rem;
		}

		.spatial-copy {
			top: 46%;
			left: 1rem;
			width: calc(100% - 2rem);
			padding: 1.25rem;
			transform: translateY(-46%);
		}

		.spatial-kicker {
			margin-bottom: 1rem;
			font-size: 0.59rem;
		}

		.spatial-copy h1 {
