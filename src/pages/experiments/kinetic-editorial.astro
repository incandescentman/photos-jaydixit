---
export const prerender = true;

import { images } from '../../data/homepage-images.js';
import { cldSizes, cldSrcset, cldUrl } from '../../lib/cloudinary';
import siteConfig from '../../../site.config.mts';

type HomepageImage = {
	filename: string;
	size: 'portrait' | 'landscape' | 'xlportrait';
	caption: string;
	cloudinaryPublicId?: string;
};

const publicIdFor = (image: HomepageImage) =>
	image.cloudinaryPublicId ?? `highlights/${image.filename.replace(/\.[^.]+$/, '')}`;

const imageData = (index: number) => {
	const image = images[index] as HomepageImage;
	const publicId = publicIdFor(image);
	return {
		...image,
		publicId,
		src: cldUrl(publicId, 1000),
		srcset: cldSrcset(publicId, [480, 760, 1000, 1400, 1800]),
		sizes: cldSizes('(max-width: 720px) 88vw, (max-width: 1100px) 44vw, 30vw'),
	};
};

const heroPhotos = [2, 0, 9, 22, 8, 3].map(imageData);
const wallPhotos = [2, 0, 9, 22, 8, 3, 18, 10, 24, 19, 5, 25, 32, 11, 31, 17, 33].map(imageData);
const wallLayouts = [
	'wall-feature',
	'wall-portrait',
	'wall-landscape',
	'wall-portrait',
	'wall-tall',
	'wall-portrait',
	'wall-tall',
	'wall-landscape',
	'wall-feature',
	'wall-portrait',
	'wall-portrait',
	'wall-tall',
	'wall-landscape',
	'wall-portrait',
	'wall-portrait',
	'wall-tall',
	'wall-landscape',
];

const title = 'Jay Dixit — Red Carpet Photography for Wikipedia';
const description =
	'I photograph actors, directors, and public figures at film festivals and premieres, then release the portraits under a free license so their Wikipedia articles can finally have great photos.';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Kinetic Editorial — {siteConfig.owner}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="theme-color" content="#f4efe5" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://res.cloudinary.com" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Newsreader:opsz,wght@6..72,300;6..72,400;6..72,500&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<div class="reading-progress" aria-hidden="true"><span></span></div>

		<header class="site-header" data-header>
			<a class="site-mark" href="/" aria-label="Jay Dixit Photos, current homepage">
				<span>Jay Dixit</span>
				<small>Photos</small>
			</a>
			<nav aria-label="Primary navigation">
				<a href="/red-carpet">Red Carpet</a>
				<a href="/gallery">Galleries</a>
				<a href="/before-after">Before &amp; After</a>
				<a href="/about">About</a>
			</nav>
			<a class="header-contact" href="/contact">Contact <span aria-hidden="true">↗</span></a>
		</header>

		<main id="main-content">
			<section class="hero" aria-labelledby="hero-title" data-hero>
				<canvas class="atmosphere" data-atmosphere aria-hidden="true"></canvas>
				<div class="hero-orbit" aria-hidden="true"></div>
				<div class="hero-grid">
					<div class="hero-copy">
						<p class="eyebrow" data-reveal>Red Carpet Photography for Wikipedia</p>
						<h1 id="hero-title" aria-label={title}>
							<span class="title-line" aria-hidden="true"><span>Jay Dixit —</span></span>
							<span class="title-line title-line-emphasis" aria-hidden="true"
								><span>Red Carpet</span></span
							>
							<span class="title-line" aria-hidden="true"><span>Photography</span></span>
							<span class="title-line title-line-final" aria-hidden="true"
								><span>for Wikipedia</span></span
							>
						</h1>
						<p class="hero-lede" data-reveal>{description}</p>
						<div class="hero-actions" data-reveal>
							<a class="primary-link" href="/before-after">
								<span>See the Before &amp; After</span>
								<svg viewBox="0 0 48 20" aria-hidden="true">
									<path d="M1 10h44M37 2l8 8-8 8"></path>
								</svg>
							</a>
							<a class="text-link" href="#selected-portraits">Selected portraits</a>
						</div>
					</div>

					<div class="hero-stage" aria-label="Selected portrait photographs" data-hero-stage>
						{
							heroPhotos.map((photo, index) => (
								<figure
									class={`hero-photo hero-photo-${index + 1}`}
									data-hero-photo
									data-depth={(index + 1) * 0.12}
								>
									<img
										src={photo.src}
										srcset={photo.srcset}
										sizes="(max-width: 720px) 48vw, (max-width: 1100px) 28vw, 19vw"
										alt={photo.caption}
										width={photo.size === 'landscape' ? 1200 : 800}
										height={photo.size === 'landscape' ? 800 : 1200}
										loading={index < 3 ? 'eager' : 'lazy'}
										fetchpriority={index === 0 ? 'high' : undefined}
										decoding="async"
									/>
									<figcaption>
										<span>{String(index + 1).padStart(2, '0')}</span>
										<strong>{photo.caption}</strong>
									</figcaption>
								</figure>
							))
						}
					</div>
				</div>

				<div class="hero-footer" data-reveal>
					<span>Selected portraits</span>
					<a href="#selected-portraits">Scroll to explore <i aria-hidden="true">↓</i></a>
				</div>
			</section>

			<section class="editorial-bridge" aria-label="Portfolio introduction">
				<div class="bridge-rule" aria-hidden="true"></div>
				<p class="bridge-index">01 / 02</p>
				<p class="bridge-copy">{description}</p>
				<a class="bridge-link" href="/before-after">
					See the Before &amp; After <span aria-hidden="true">→</span>
				</a>
			</section>

			<section class="portrait-section" id="selected-portraits" aria-labelledby="portraits-title">
				<header class="section-header">
					<p>Selected portraits</p>
					<h2 id="portraits-title">The photo wall</h2>
					<a href="/gallery">View all galleries <span aria-hidden="true">↗</span></a>
				</header>

				<div class="photo-wall" data-photo-wall>
					{
						wallPhotos.map((photo, index) => (
							<article
								class={`wall-card ${wallLayouts[index]}`}
								data-wall-card
								style={`--card-index: ${index}`}
							>
								<a href="/gallery" aria-label={`${photo.caption} — view galleries`}>
									<div class="wall-media" data-tilt>
										<img
											src={photo.src}
											srcset={photo.srcset}
											sizes={photo.sizes}
											alt={photo.caption}
											width={photo.size === 'landscape' ? 1200 : 800}
											height={photo.size === 'landscape' ? 800 : 1200}
											loading={index < 3 ? 'eager' : 'lazy'}
											decoding="async"
										/>
										<span class="wall-number" aria-hidden="true">
											{String(index + 1).padStart(2, '0')}
										</span>
										<span class="wall-arrow" aria-hidden="true">
											↗
										</span>
									</div>
									<p>{photo.caption}</p>
								</a>
							</article>
						))
					}
				</div>
			</section>

			<section class="closing-panel" aria-labelledby="closing-title">
				<p class="closing-index">02 / 02</p>
				<h2 id="closing-title">Jay Dixit <em>Photos</em></h2>
				<div class="closing-links">
					<a href="/red-carpet">Red Carpet <span aria-hidden="true">↗</span></a>
					<a href="/gallery">Galleries <span aria-hidden="true">↗</span></a>
					<a href="/before-after">Before &amp; After <span aria-hidden="true">↗</span></a>
					<a href="/contact">Contact <span aria-hidden="true">↗</span></a>
				</div>
			</section>
		</main>

		<footer class="experiment-footer">
			<a href="/">← Current photography homepage</a>
			<a href="/experiments">All experiments</a>
			<span>© {new Date().getFullYear()} {siteConfig.owner}</span>
		</footer>

		<script>
			import { initKineticEditorial } from '../../scripts/experiments/kineticEditorial';

			initKineticEditorial();
		</script>
	</body>
</html>

<style is:global>
	:root {
		--paper: #f4efe5;
		--paper-bright: #fbf8f1;
		--ink: #171713;
		--muted: #756e64;
		--accent: #a43f2e;
		--accent-soft: #d9ad91;
		--rule: rgba(23, 23, 19, 0.22);
		--serif: 'Newsreader', 'Iowan Old Style', 'Baskerville', 'Times New Roman', serif;
		--sans: 'Instrument Sans', 'Helvetica Neue', Arial, sans-serif;
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
		background: var(--paper);
	}

	body {
		margin: 0;
		min-width: 320px;
		overflow-x: clip;
		background:
			linear-gradient(rgba(23, 23, 19, 0.025) 1px, transparent 1px),
			linear-gradient(90deg, rgba(23, 23, 19, 0.018) 1px, transparent 1px), var(--paper);
		background-size:
			100% 8px,
			8px 100%;
		color: var(--ink);
		font-family: var(--sans);
		-webkit-font-smoothing: antialiased;
	}

	body::after {
		position: fixed;
		z-index: 100;
		inset: 0;
		pointer-events: none;
		content: '';
		opacity: 0.17;
		background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.18'/%3E%3C/svg%3E");
		mix-blend-mode: multiply;
	}

	a {
		color: inherit;
	}

	.skip-link {
		position: fixed;
		z-index: 1000;
		top: 12px;
		left: 12px;
		padding: 10px 14px;
		background: var(--ink);
		color: var(--paper-bright);
		font-size: 12px;
		font-weight: 600;
		text-decoration: none;
		transform: translateY(-150%);
		transition: transform 180ms ease;
	}

	.skip-link:focus {
		transform: translateY(0);
	}

	.reading-progress {
		position: fixed;
		z-index: 80;
		top: 0;
		right: 0;
		width: 3px;
		height: 100vh;
		background: rgba(23, 23, 19, 0.08);
		pointer-events: none;
	}

	.reading-progress span {
		display: block;
		width: 100%;
		height: 100%;
		background: var(--accent);
		transform: scaleY(0);
		transform-origin: top;
	}

	.site-header {
		position: absolute;
		z-index: 50;
		top: 0;
		right: 0;
		left: 0;
		display: grid;
		grid-template-columns: minmax(160px, 1fr) auto minmax(160px, 1fr);
		align-items: center;
		min-height: 82px;
		margin: 0 clamp(20px, 3.2vw, 60px);
		border-bottom: 1px solid var(--rule);
	}

	.site-mark {
		display: inline-flex;
		align-items: baseline;
		gap: 8px;
		width: max-content;
		text-decoration: none;
	}

	.site-mark span {
		font-family: var(--serif);
		font-size: 23px;
		font-weight: 500;
		letter-spacing: -0.035em;
	}

	.site-mark small {
		color: var(--accent);
		font-size: 9px;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.site-header nav {
		display: flex;
		align-items: center;
		gap: clamp(20px, 2.6vw, 44px);
	}

	.site-header nav a,
	.header-contact {
		position: relative;
		font-size: 10px;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.site-header nav a::after,
	.header-contact::after {
		position: absolute;
		right: 100%;
		bottom: -7px;
		left: 0;
		height: 1px;
		background: var(--accent);
		content: '';
		transition: right 220ms ease;
	}

	.site-header nav a:hover::after,
	.site-header nav a:focus-visible::after,
	.header-contact:hover::after,
	.header-contact:focus-visible::after {
		right: 0;
	}

	.header-contact {
		justify-self: end;
	}

	.header-contact span {
		color: var(--accent);
	}

	.hero {
		position: relative;
		isolation: isolate;
		min-height: max(820px, 100svh);
		overflow: hidden;
		background:
			radial-gradient(
				circle at var(--pointer-x, 73%) var(--pointer-y, 30%),
				#fffdf6 0,
				transparent 34%
			),
			linear-gradient(120deg, var(--paper-bright) 0%, var(--paper) 54%, #e9dfcf 100%);
	}

	.atmosphere,
	.hero-orbit {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}

	.atmosphere {
		z-index: -1;
		opacity: 0.72;
	}

	.hero-orbit {
		z-index: -2;
		top: 14%;
		right: -13vw;
		bottom: auto;
		left: auto;
		width: min(52vw, 820px);
		height: min(52vw, 820px);
		border: 1px solid rgba(164, 63, 46, 0.17);
		border-radius: 50%;
	}

	.hero-orbit::before,
	.hero-orbit::after {
		position: absolute;
		inset: 9%;
		border: 1px solid rgba(164, 63, 46, 0.1);
		border-radius: inherit;
		content: '';
	}

	.hero-orbit::after {
		inset: 22%;
	}

	.hero-grid {
		display: grid;
		grid-template-columns: minmax(520px, 0.98fr) minmax(520px, 1.02fr);
		align-items: center;
		gap: clamp(30px, 4vw, 80px);
		width: min(100%, 1780px);
		min-height: max(820px, 100svh);
		margin: 0 auto;
		padding: 124px clamp(20px, 5vw, 94px) 90px;
	}

	.hero-copy {
		position: relative;
		z-index: 5;
		align-self: center;
		max-width: 800px;
	}

	.eyebrow {
		display: flex;
		align-items: center;
		gap: 14px;
		margin: 0 0 clamp(22px, 3.4vh, 38px);
		color: var(--accent);
		font-size: 10px;
		font-weight: 600;
		letter-spacing: 0.23em;
		text-transform: uppercase;
	}

	.eyebrow::before {
		width: 42px;
		border-top: 1px solid currentColor;
		content: '';
	}

	h1 {
		margin: 0;
		font-family: var(--serif);
		font-size: clamp(65px, 6.7vw, 126px);
		font-weight: 300;
		letter-spacing: -0.069em;
		line-height: 0.76;
	}

	.title-line {
		display: block;
		overflow: hidden;
		padding: 0.07em 0.08em 0.07em 0;
	}

	.title-line > span {
		display: block;
		will-change: transform;
	}

	.title-line-emphasis {
		color: var(--accent);
		font-style: italic;
	}

	.title-line-final {
		margin-left: clamp(40px, 8vw, 150px);
		font-size: 0.78em;
		font-style: italic;
	}

	.hero-lede {
		max-width: 570px;
		margin: clamp(28px, 4vh, 50px) 0 0;
		padding-left: clamp(38px, 7vw, 112px);
		font-family: var(--serif);
		font-size: clamp(19px, 1.45vw, 26px);
		font-weight: 300;
		line-height: 1.42;
	}

	.hero-actions {
		display: flex;
		align-items: center;
		gap: 32px;
		margin: 34px 0 0;
		padding-left: clamp(38px, 7vw, 112px);
	}

	.primary-link {
		display: inline-flex;
		align-items: center;
		gap: 18px;
		padding: 13px 0;
		border-bottom: 1px solid var(--ink);
		font-size: 10px;
		font-weight: 600;
		letter-spacing: 0.13em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.primary-link svg {
		width: 45px;
		overflow: visible;
		fill: none;
		stroke: var(--accent);
		stroke-width: 1.3;
		transition: transform 240ms ease;
	}

	.primary-link:hover svg,
	.primary-link:focus-visible svg {
		transform: translateX(7px);
	}

	.text-link {
		color: var(--muted);
		font-family: var(--serif);
		font-size: 15px;
		font-style: italic;
		text-underline-offset: 4px;
	}

	.hero-stage {
		position: relative;
		z-index: 2;
		height: min(72vh, 750px);
		min-height: 570px;
		perspective: 1200px;
	}

	.hero-photo {
		position: absolute;
		margin: 0;
		box-shadow: 0 24px 80px rgba(53, 39, 25, 0.17);
		background: #d8d0c4;
		will-change: transform;
	}

	.hero-photo::before {
		position: absolute;
		z-index: 2;
		inset: 8px;
		border: 1px solid rgba(255, 255, 255, 0.42);
		content: '';
		pointer-events: none;
	}

	.hero-photo img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: saturate(0.92) contrast(1.02);
	}

	.hero-photo figcaption {
		position: absolute;
		z-index: 3;
		right: 0;
		bottom: 0;
		left: 0;
		display: flex;
		align-items: flex-end;
		gap: 10px;
		padding: 34px 12px 11px;
		background: linear-gradient(transparent, rgba(18, 16, 13, 0.78));
		color: white;
		opacity: 0;
		transform: translateY(8px);
		transition:
			opacity 240ms ease,
			transform 240ms ease;
	}

	.hero-photo:hover figcaption {
		opacity: 1;
		transform: translateY(0);
	}

	.hero-photo figcaption span {
		color: var(--accent-soft);
		font-size: 9px;
		font-weight: 600;
		letter-spacing: 0.15em;
	}

	.hero-photo figcaption strong {
		font-size: 10px;
		font-weight: 500;
		line-height: 1.25;
	}

	.hero-photo-1 {
		z-index: 6;
		top: 7%;
		left: 15%;
		width: 44%;
		height: 74%;
		transform: rotate(-1.5deg);
	}

	.hero-photo-2 {
		z-index: 4;
		top: -1%;
		right: 2%;
		width: 32%;
		height: 50%;
		transform: rotate(3deg);
	}

	.hero-photo-3 {
		z-index: 5;
		right: -4%;
		bottom: 2%;
		width: 45%;
		height: 38%;
		transform: rotate(-2deg);
	}

	.hero-photo-4 {
		z-index: 3;
		bottom: -4%;
		left: 8%;
		width: 29%;
		height: 48%;
		transform: rotate(3.4deg);
	}

	.hero-photo-5 {
		z-index: 2;
		top: 2%;
		left: -6%;
		width: 27%;
		height: 43%;
		transform: rotate(-5deg);
	}

	.hero-photo-6 {
		z-index: 1;
		right: 13%;
		bottom: -9%;
		width: 24%;
		height: 38%;
		transform: rotate(5deg);
	}

	.hero-footer {
		position: absolute;
		z-index: 6;
		right: clamp(20px, 3.2vw, 60px);
		bottom: 24px;
		left: clamp(20px, 3.2vw, 60px);
		display: flex;
		justify-content: space-between;
		color: var(--muted);
		font-size: 9px;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.hero-footer a {
		text-decoration: none;
	}

	.hero-footer i {
		display: inline-block;
		margin-left: 10px;
		color: var(--accent);
		font-family: var(--serif);
		font-size: 16px;
		font-style: normal;
		animation: float-arrow 1.8s ease-in-out infinite;
	}

	@keyframes float-arrow {
		50% {
			transform: translateY(6px);
		}
	}

	.editorial-bridge {
		display: grid;
		grid-template-columns: minmax(70px, 0.4fr) 0.3fr minmax(460px, 1.4fr) 0.55fr;
		gap: 28px;
		align-items: start;
		width: min(100%, 1600px);
		margin: 0 auto;
		padding: clamp(90px, 13vw, 210px) clamp(20px, 5vw, 80px);
	}

	.bridge-rule {
		width: 100%;
		margin-top: 12px;
		border-top: 1px solid var(--accent);
	}

	.bridge-index {
		margin: 0;
		color: var(--accent);
		font-size: 10px;
		font-weight: 600;
		letter-spacing: 0.15em;
	}

	.bridge-copy {
		margin: -0.16em 0 0;
		font-family: var(--serif);
		font-size: clamp(37px, 4.2vw, 72px);
		font-weight: 300;
		letter-spacing: -0.043em;
		line-height: 1;
	}

	.bridge-link {
		justify-self: end;
		margin-top: 8px;
		font-size: 10px;
		font-weight: 600;
		letter-spacing: 0.11em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.bridge-link span {
		display: inline-block;
		margin-left: 8px;
		color: var(--accent);
		transition: transform 200ms ease;
