---
export const prerender = true;

import { images } from '../../data/homepage-images.js';
import { cldSizes, cldSrcset, cldUrl } from '../../lib/cloudinary';
import PhotoSwipeLightbox from '../../components/PhotoSwipeLightbox.astro';
import siteConfig from '../../../site.config.mts';

type HomepageImage = {
	filename: string;
	size: 'portrait' | 'landscape' | 'xlportrait';
	caption: string;
	cloudinaryPublicId?: string;
};

const publicIdFor = (image: HomepageImage) =>
	image.cloudinaryPublicId ?? `highlights/${image.filename.replace(/\.[^.]+$/, '')}`;

const imageData = (index: number) => {
	const image = images[index] as HomepageImage;
	const publicId = publicIdFor(image);
	return {
		...image,
		publicId,
		src: cldUrl(publicId, 1000),
		srcset: cldSrcset(publicId, [480, 760, 1000, 1400, 1800]),
		fullSrc: cldUrl(publicId, 2400),
		lightboxSrcset: cldSrcset(publicId, [1000, 1600, 2000, 2400]),
		sizes: cldSizes('(max-width: 720px) 88vw, (max-width: 1100px) 44vw, 30vw'),
	};
};

const heroPrintLayout = [
	{ photo: imageData(2), x: 49, y: 3, width: 29, rotation: -2.6, z: 5 },
	{ photo: imageData(9), x: 72, y: 10, width: 27, rotation: 3.1, z: 3 },
	{ photo: imageData(22), x: 81, y: 41, width: 18, rotation: -3.7, z: 6 },
	{ photo: imageData(31), x: 58, y: 51, width: 22, rotation: 2.2, z: 7 },
	{ photo: imageData(25), x: 38, y: 9, width: 18, rotation: -4.4, z: 2 },
	{ photo: imageData(11), x: 31, y: 47, width: 18, rotation: 3.5, z: 4 },
	{ photo: imageData(0), x: 76, y: 74, width: 19, rotation: 1.7, z: 2 },
];
const wallPhotos = [2, 0, 9, 22, 8, 3, 18, 10, 24, 19, 5, 25, 32, 11, 31, 17, 33].map(imageData);
const wallLayouts = [
	'wall-feature',
	'wall-portrait',
	'wall-landscape',
	'wall-portrait',
	'wall-tall',
	'wall-portrait',
	'wall-tall',
	'wall-landscape',
	'wall-feature',
	'wall-portrait',
	'wall-portrait',
	'wall-tall',
	'wall-landscape',
	'wall-portrait',
	'wall-portrait',
	'wall-tall',
	'wall-landscape',
];

const title = 'Jay Dixit — Red Carpet Photography for Wikipedia';
const description =
	'As a photographer for WikiPortraits, I take pictures of actors, writers, and scientists at film festivals and cultural events around the world, then release the images under a free license for use on Wikipedia.';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Kinetic Editorial — {siteConfig.owner}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="theme-color" content="#f4efe5" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://res.cloudinary.com" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Newsreader:opsz,wght@6..72,300;6..72,400;6..72,500&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<div class="reading-progress" aria-hidden="true"><span></span></div>

		<header class="site-header" data-header>
			<a class="site-mark" href="/" aria-label="Jay Dixit Photos, current homepage">
				<img src="/brand/red-carpet-seal.svg" alt="" width="72" height="72" />
				<span>Jay Dixit</span>
				<small>Photos</small>
			</a>
			<nav aria-label="Primary navigation">
				<a href="/red-carpet">Red Carpet</a>
				<a href="/gallery">Galleries</a>
				<a href="/before-after">Before &amp; After</a>
				<a href="/about">About</a>
			</nav>
			<a class="header-contact" href="/contact">Contact <span aria-hidden="true">↗</span></a>
		</header>

		<main id="main-content">
			<section class="hero" aria-labelledby="hero-title" data-hero>
				<canvas class="atmosphere" data-atmosphere aria-hidden="true"></canvas>
				<div class="hero-orbit" aria-hidden="true"></div>
				<div class="hero-grid">
					<div class="hero-copy">
						<p class="eyebrow" data-reveal>Red Carpet Photography for Wikipedia</p>
						<h1 id="hero-title" aria-label={title}>
							<span class="title-line" aria-hidden="true"><span>Jay Dixit —</span></span>
							<span class="title-line title-line-emphasis" aria-hidden="true"
								><span>Red Carpet</span></span
							>
							<span class="title-line" aria-hidden="true"><span>Photography</span></span>
							<span class="title-line title-line-final" aria-hidden="true"
								><span>for Wikipedia</span></span
							>
						</h1>
						<p class="hero-lede" data-reveal>{description}</p>
						<div class="hero-actions" data-reveal>
							<a class="primary-link" href="/before-after">
								<span>See the Before &amp; After</span>
								<svg viewBox="0 0 48 20" aria-hidden="true">
									<path d="M1 10h44M37 2l8 8-8 8"></path>
								</svg>
							</a>
							<a class="text-link" href="#selected-portraits">Selected portraits</a>
						</div>
					</div>

					<div
						id="hero-print-gallery"
						class="hero-stage"
						aria-label="Selected portrait prints"
						data-hero-stage
					>
						<div class="darkroom-line darkroom-line-one" aria-hidden="true"></div>
						<div class="darkroom-line darkroom-line-two" aria-hidden="true"></div>
						{
							heroPrintLayout.map(({ photo, x, y, width, rotation, z }, index) => (
								<a
									class="hero-print"
									data-hero-photo
									data-depth={(index + 1) * 0.12}
									data-tilt
									data-pswp-item="true"
									data-full-src={photo.fullSrc}
									data-pswp-srcset={photo.lightboxSrcset}
									data-pswp-caption={photo.caption}
									data-cropped="true"
									href={photo.fullSrc}
									style={`--print-x:${x}%;--print-y:${y}%;--print-width:${width}%;--print-rotation:${rotation}deg;--print-z:${z}`}
									aria-label={`${photo.caption} — view full size`}
								>
									<span class="clothespin" aria-hidden="true" />
									<img
										src={photo.src}
										srcset={photo.srcset}
										sizes="(max-width: 820px) 47vw, 29vw"
										alt={photo.caption}
										width={index === 1 ? 1200 : 800}
										height={index === 1 ? 800 : 1200}
										loading={index < 3 ? 'eager' : 'lazy'}
										fetchpriority={index === 0 ? 'high' : undefined}
										decoding="async"
									/>
									<span class="print-caption">
										<strong>{photo.caption}</strong>
										<small>View full size</small>
									</span>
								</a>
							))
						}
					</div>
				</div>

				<div class="hero-footer" data-reveal>
					<span>Selected portraits</span>
					<a href="#selected-portraits">Scroll to explore <i aria-hidden="true">↓</i></a>
				</div>
			</section>

			<section class="editorial-bridge" aria-label="Portfolio introduction">
				<div class="bridge-rule" aria-hidden="true"></div>
				<p class="bridge-index">01 / 02</p>
				<p class="bridge-copy">{description}</p>
				<a class="bridge-link" href="/before-after">
					See the Before &amp; After <span aria-hidden="true">→</span>
				</a>
			</section>

			<section class="portrait-section" id="selected-portraits" aria-labelledby="portraits-title">
				<header class="section-header">
					<p>Selected portraits</p>
					<h2 id="portraits-title">The photo wall</h2>
					<a href="/gallery">View all galleries <span aria-hidden="true">↗</span></a>
				</header>

				<div class="photo-wall" data-photo-wall>
					{
						wallPhotos.map((photo, index) => (
							<article
								class={`wall-card ${wallLayouts[index]}`}
								data-wall-card
								style={`--card-index: ${index}`}
							>
								<a href="/gallery" aria-label={`${photo.caption} — view galleries`}>
									<div class="wall-media" data-tilt>
										<img
											src={photo.src}
											srcset={photo.srcset}
											sizes={photo.sizes}
											alt={photo.caption}
											width={photo.size === 'landscape' ? 1200 : 800}
											height={photo.size === 'landscape' ? 800 : 1200}
											loading={index < 3 ? 'eager' : 'lazy'}
											decoding="async"
										/>
										<span class="wall-number" aria-hidden="true">
											{String(index + 1).padStart(2, '0')}
										</span>
										<span class="wall-arrow" aria-hidden="true">
											↗
										</span>
									</div>
									<p>{photo.caption}</p>
								</a>
							</article>
						))
					}
				</div>
			</section>

			<section class="closing-panel" aria-labelledby="closing-title">
				<p class="closing-index">02 / 02</p>
				<h2 id="closing-title">Jay Dixit <em>Photos</em></h2>
				<div class="closing-links">
					<a href="/red-carpet">Red Carpet <span aria-hidden="true">↗</span></a>
					<a href="/gallery">Galleries <span aria-hidden="true">↗</span></a>
					<a href="/before-after">Before &amp; After <span aria-hidden="true">↗</span></a>
					<a href="/contact">Contact <span aria-hidden="true">↗</span></a>
				</div>
			</section>
		</main>

		<PhotoSwipeLightbox
			gallerySelector="#hero-print-gallery"
			childrenSelector="a[data-pswp-item]"
			options={{
				wheelToZoom: true,
				padding: { top: 20, bottom: 80, left: 20, right: 20 },
				showHideAnimationType: 'zoom',
				showAnimationDuration: 650,
				easing: 'cubic-bezier(0.4, 0, 0.2, 1)',
				mainClass: 'pswp--kinetic-editorial',
				bgOpacity: 0.28,
			}}
		/>

		<footer class="experiment-footer">
			<a href="/">← Current photography homepage</a>
			<a href="/experiments">All experiments</a>
			<span>© {new Date().getFullYear()} {siteConfig.owner}</span>
		</footer>

		<script>
			import { initKineticEditorial } from '../../scripts/experiments/kineticEditorial';

			initKineticEditorial();
		</script>
	</body>
</html>

<style is:global>
	:root {
		--paper: #f4efe5;
		--paper-bright: #fbf8f1;
		--ink: #171713;
		--muted: #756e64;
		--accent: #a43f2e;
		--accent-soft: #d9ad91;
		--rule: rgba(23, 23, 19, 0.22);
		--serif: 'Newsreader', 'Iowan Old Style', 'Baskerville', 'Times New Roman', serif;
		--sans: 'Instrument Sans', 'Helvetica Neue', Arial, sans-serif;
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
		overflow-x: clip;
		background: var(--paper);
	}

	body {
		margin: 0;
		min-width: 320px;
		overflow-x: clip;
		background:
			linear-gradient(rgba(23, 23, 19, 0.025) 1px, transparent 1px),
			linear-gradient(90deg, rgba(23, 23, 19, 0.018) 1px, transparent 1px), var(--paper);
		background-size:
			100% 8px,
			8px 100%;
		color: var(--ink);
		font-family: var(--sans);
		-webkit-font-smoothing: antialiased;
	}

	body::after {
		position: fixed;
		z-index: 100;
		inset: 0;
		pointer-events: none;
		content: '';
		opacity: 0.17;
		background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.18'/%3E%3C/svg%3E");
		mix-blend-mode: multiply;
	}

	.pswp.pswp--kinetic-editorial {
		--pswp-bg: var(--paper);
		--pswp-placeholder-bg: #ded5c8;
		--pswp-icon-color: #96773f;
		--pswp-icon-color-secondary: var(--paper-bright);
		--pswp-icon-stroke-color: var(--ink);
		--pswp-icon-stroke-width: 1.5px;
		--pswp-preloader-color: rgb(150 119 63 / 35%);
		--pswp-preloader-color-secondary: #96773f;
	}

	.pswp--kinetic-editorial .pswp__img {
		box-shadow:
			0 3px 10px rgb(23 23 19 / 20%),
			0 24px 70px rgb(23 23 19 / 30%);
	}

	.pswp--kinetic-editorial .pswp__counter {
		color: var(--ink);
		font-family: var(--sans);
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-shadow: 0 1px 0 var(--paper-bright);
	}

	.pswp--kinetic-editorial .pswp__button--close,
	.pswp--kinetic-editorial .pswp__button--zoom {
		width: 44px;
		height: 44px;
		margin: 8px 8px 0 0;
		border: 1px solid rgb(150 119 63 / 45%);
		border-radius: 50%;
		background: var(--paper-bright);
		box-shadow: 0 4px 18px rgb(23 23 19 / 12%);
	}

	.pswp--kinetic-editorial .pswp__button--close:hover,
	.pswp--kinetic-editorial .pswp__button--close:focus-visible,
	.pswp--kinetic-editorial .pswp__button--zoom:hover,
	.pswp--kinetic-editorial .pswp__button--zoom:focus-visible {
		border-color: #96773f;
		background: var(--paper-bright);
	}

	.pswp--kinetic-editorial .pswp__button--close .pswp__icn,
	.pswp--kinetic-editorial .pswp__button--zoom .pswp__icn {
		top: 5px;
		left: 5px;
	}

	.pswp--kinetic-editorial .pswp__button--arrow .pswp__icn {
		filter: drop-shadow(0 2px 5px rgb(23 23 19 / 22%));
	}

	.pswp--kinetic-editorial .pswp__button--arrow {
		top: calc(50% - 30px);
	}

	.pswp--kinetic-editorial .pswp__button--arrow--prev {
		left: max(12px, calc(35.5vw - 87px));
	}

	.pswp--kinetic-editorial .pswp__button--arrow--next {
		right: max(12px, calc(35.5vw - 87px));
	}

	.pswp--kinetic-editorial .pswp__custom--caption {
		right: auto !important;
		bottom: 22px !important;
		left: 50% !important;
		width: max-content !important;
		max-width: min(80vw, 720px) !important;
		padding: 10px 17px 11px !important;
		transform: translateX(-50%);
		border: 1px solid rgb(150 119 63 / 42%);
		background: var(--paper-bright) !important;
		box-shadow: 0 7px 26px rgb(23 23 19 / 16%);
		color: var(--ink) !important;
		font-family: var(--serif) !important;
		font-size: 16px !important;
		line-height: 1.35 !important;
	}

	.pswp--kinetic-editorial .pswp__custom--caption strong {
		color: var(--ink) !important;
	}

	.pswp--kinetic-editorial .pswp__custom--caption em {
		color: var(--muted) !important;
	}

	a {
		color: inherit;
	}

	.skip-link {
		position: fixed;
		z-index: 1000;
		top: 12px;
		left: 12px;
		padding: 10px 14px;
		background: var(--ink);
		color: var(--paper-bright);
		font-size: 12px;
		font-weight: 600;
		text-decoration: none;
		transform: translateY(-150%);
		transition: transform 180ms ease;
	}

	.skip-link:focus {
		transform: translateY(0);
	}

	.reading-progress {
		position: fixed;
		z-index: 80;
		top: 0;
		right: 0;
		width: 3px;
		height: 100vh;
		background: rgba(23, 23, 19, 0.08);
		pointer-events: none;
	}

	.reading-progress span {
		display: block;
		width: 100%;
		height: 100%;
		background: var(--accent);
		transform: scaleY(0);
		transform-origin: top;
	}

	.site-header {
		position: absolute;
		z-index: 50;
		top: 0;
		right: 0;
		left: 0;
		display: grid;
		grid-template-columns: minmax(160px, 1fr) auto minmax(160px, 1fr);
		align-items: center;
		min-height: 120px;
		margin: 0 clamp(20px, 3.2vw, 60px);
		border-bottom: 1px solid var(--rule);
	}

	.site-mark {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		width: max-content;
		text-decoration: none;
	}

	.site-mark img {
		display: block;
		flex: none;
		width: 72px;
		height: 72px;
		transition: transform 220ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
	}

	.site-mark:hover img,
	.site-mark:focus-visible img {
		transform: rotate(-4deg) scale(1.06);
	}

	.site-mark span {
		font-family: var(--serif);
		font-size: 2.35rem;
		font-weight: 500;
		line-height: 1;
		letter-spacing: -0.025em;
	}

	.site-mark small {
		color: var(--accent);
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.site-header nav {
		display: flex;
		align-items: center;
		gap: clamp(20px, 2.6vw, 44px);
	}

	.site-header nav a,
	.header-contact {
		position: relative;
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.site-header nav a::after,
	.header-contact::after {
		position: absolute;
		right: 100%;
		bottom: -7px;
		left: 0;
		height: 1px;
		background: var(--accent);
		content: '';
		transition: right 220ms ease;
	}

	.site-header nav a:hover::after,
	.site-header nav a:focus-visible::after,
	.header-contact:hover::after,
	.header-contact:focus-visible::after {
		right: 0;
	}

	.header-contact {
		justify-self: end;
	}

	.header-contact span {
		color: var(--accent);
	}

	.hero {
		position: relative;
		isolation: isolate;
		min-height: max(820px, 100svh);
		overflow: hidden;
		background:
			radial-gradient(
				circle at var(--pointer-x, 73%) var(--pointer-y, 30%),
				#fffdf6 0,
				transparent 34%
			),
			linear-gradient(120deg, var(--paper-bright) 0%, var(--paper) 54%, #e9dfcf 100%);
	}

	.atmosphere,
	.hero-orbit {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}

	.atmosphere {
		z-index: -1;
		opacity: 0.72;
	}

	.hero-orbit {
		z-index: -2;
		top: 14%;
		right: -13vw;
		bottom: auto;
		left: auto;
		width: min(52vw, 820px);
		height: min(52vw, 820px);
		border: 1px solid rgba(164, 63, 46, 0.17);
		border-radius: 50%;
	}

	.hero-orbit::before,
	.hero-orbit::after {
		position: absolute;
		inset: 9%;
		border: 1px solid rgba(164, 63, 46, 0.1);
		border-radius: inherit;
		content: '';
	}

	.hero-orbit::after {
		inset: 22%;
	}

	.hero-grid {
		display: block;
		width: 100%;
		min-height: max(820px, 100svh);
		margin: 0;
		padding: 154px clamp(20px, 2vw, 40px) 90px;
	}

	.hero-copy {
		position: relative;
		z-index: 10;
		align-self: center;
		width: min(34vw, 700px);
		max-width: none;
	}

	.eyebrow {
		display: flex;
		align-items: center;
		gap: 14px;
		margin: 0 0 clamp(22px, 3.4vh, 38px);
		color: var(--accent);
		font-size: 10px;
		font-weight: 600;
		letter-spacing: 0.23em;
		text-transform: uppercase;
	}

	.eyebrow::before {
		width: 42px;
		border-top: 1px solid currentColor;
		content: '';
	}

	h1 {
		margin: 0;
		font-family: var(--serif);
		font-size: clamp(62px, 5.65vw, 116px);
		font-weight: 300;
		letter-spacing: -0.069em;
		line-height: 0.76;
	}

	.title-line {
		display: block;
		overflow: hidden;
		margin-top: -0.09em;
		padding: 0.16em 0.08em 0.07em 0;
	}

	.title-line > span {
		display: block;
		will-change: transform;
	}

	.title-line-emphasis {
		color: var(--accent);
		font-style: italic;
	}

	.title-line-final {
		margin-left: clamp(36px, 5vw, 100px);
		font-size: 0.78em;
		font-style: italic;
	}

	.hero-lede {
		max-width: 520px;
		margin: clamp(28px, 4vh, 50px) 0 0;
		padding-left: clamp(24px, 2.5vw, 50px);
		font-family: var(--serif);
		font-size: clamp(19px, 1.45vw, 26px);
		font-weight: 300;
		line-height: 1.42;
	}

	.hero-actions {
		display: flex;
		align-items: center;
		gap: 32px;
		margin: 34px 0 0;
		padding-left: clamp(24px, 2.5vw, 50px);
	}

	.primary-link {
		display: inline-flex;
		align-items: center;
		gap: 18px;
		padding: 13px 0;
		border-bottom: 1px solid var(--ink);
		font-size: 10px;
		font-weight: 600;
		letter-spacing: 0.13em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.primary-link svg {
		width: 45px;
		overflow: visible;
