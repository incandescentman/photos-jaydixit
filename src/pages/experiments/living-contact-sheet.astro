---
export const prerender = true;

import { images } from '../../data/homepage-images.js';
import siteConfig from '../../../site.config.mts';

const CLOUDINARY_CLOUD = 'dszpm7yps';

const publicIdFor = (image: (typeof images)[number]) =>
	image.cloudinaryPublicId ?? `highlights/${image.filename.replace(/\.[^.]+$/, '')}`;

const imageUrl = (image: (typeof images)[number], width: number) =>
	`https://res.cloudinary.com/${CLOUDINARY_CLOUD}/image/upload/f_auto,q_auto,w_${width}/${publicIdFor(image)}`;

const imageSrcset = (image: (typeof images)[number], widths: number[]) =>
	widths.map((width) => `${imageUrl(image, width)} ${width}w`).join(', ');

const fullImageUrl = (image: (typeof images)[number]) =>
	`https://res.cloudinary.com/${CLOUDINARY_CLOUD}/image/upload/f_auto,q_auto/${publicIdFor(image)}`;

const heroLayout = [
	{ image: images[2], x: 50, y: 4, width: 29, rotation: -2.6, z: 5 },
	{ image: images[9], x: 68, y: 12, width: 27, rotation: 3.1, z: 3 },
	{ image: images[22], x: 77, y: 43, width: 18, rotation: -3.7, z: 6 },
	{ image: images[31], x: 56, y: 48, width: 22, rotation: 2.2, z: 7 },
	{ image: images[25], x: 43, y: 38, width: 18, rotation: -4.4, z: 2 },
	{ image: images[11], x: 31, y: 57, width: 18, rotation: 3.5, z: 4 },
	{ image: images[0], x: 74, y: 70, width: 19, rotation: 1.7, z: 2 },
];

const contactImages = [
	images[2],
	images[9],
	images[22],
	images[25],
	images[31],
	images[11],
	images[21],
	images[0],
	images[8],
	images[3],
	images[14],
	images[6],
	images[23],
	images[16],
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Living Contact Sheet — {siteConfig.owner}</title>
		<meta
			name="description"
			content="An interactive contact-sheet experiment for Jay Dixit’s red carpet photography."
		/>
		<meta name="robots" content="noindex, nofollow" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://res.cloudinary.com" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Newsreader:opsz,wght@6..72,300;6..72,400;6..72,500&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<div class="worktable-grain" aria-hidden="true"></div>

		<header class="desk-header">
			<a class="desk-wordmark" href="/">Jay Dixit <span>Photography</span></a>
			<nav aria-label="Primary navigation">
				<a href="/gallery">Galleries</a>
				<a href="/red-carpet">Red Carpet</a>
				<a href="/about">About</a>
			</nav>
			<p class="edition">Contact sheet <span aria-hidden="true">№</span> 01</p>
		</header>

		<main>
			<section class="hero" aria-labelledby="page-title">
				<div class="hero-copy">
					<p class="kicker"><span aria-hidden="true">●</span> Selected red carpet work</p>
					<h1 id="page-title">Jay Dixit — Red Carpet Photography for Wikipedia</h1>
					<p class="lede">
						I photograph actors, directors, and public figures at film festivals and premieres, then
						release the portraits under a free license so their Wikipedia articles can finally have
						great photos.
					</p>
					<a class="before-after-link" href="/before-after">
						<span>See the Before &amp; After →</span>
						<svg viewBox="0 0 96 16" aria-hidden="true">
							<path d="M0 8h90M83 1l7 7-7 7"></path>
						</svg>
					</a>
				</div>

				<div class="print-stage" aria-label="Selected portrait prints">
					<p class="stage-note note-top" aria-hidden="true">Selection / July 2026</p>
					<p class="stage-note note-side" aria-hidden="true">Freely licensed portraits</p>
					<div class="registration-mark reg-a" aria-hidden="true"></div>
					<div class="registration-mark reg-b" aria-hidden="true"></div>

					{
						heroLayout.map(({ image, x, y, width, rotation, z }, index) => (
							<a
								class="hero-print photo-link"
								href={fullImageUrl(image)}
								target="_blank"
								rel="noreferrer"
								data-lightbox
								data-caption={image.caption}
								data-full-src={fullImageUrl(image)}
								data-rest-rotation={rotation}
								data-print-index={index}
								style={`--print-x:${x}%;--print-y:${y}%;--print-width:${width}%;--print-rotation:${rotation}deg;--print-z:${z}`}
								aria-label={`View ${image.caption}`}
							>
								<span class="print-number" aria-hidden="true">
									{String(index + 1).padStart(2, '0')}
								</span>
								<span class="hero-image-wrap">
									<img
										src={imageUrl(image, index < 2 ? 1000 : 700)}
										srcset={imageSrcset(image, [500, 800, 1200])}
										sizes="(max-width: 760px) 78vw, 30vw"
										alt={image.caption}
										width={index === 1 ? 1200 : 800}
										height={index === 1 ? 800 : 1200}
										loading={index < 4 ? 'eager' : 'lazy'}
										fetchpriority={index < 2 ? 'high' : undefined}
										decoding="async"
									/>
								</span>
								<span class="print-caption">
									<strong>{image.caption}</strong>
									<small>View photograph</small>
								</span>
							</a>
						))
					}
				</div>

				<div class="scroll-cue" aria-hidden="true">
					<span></span>
					<p>Unroll the sheet</p>
				</div>
			</section>

			<section class="contact-section" aria-labelledby="contact-heading">
				<header class="contact-heading">
					<div>
						<p class="contact-index">JD / SELECTS / 01</p>
						<h2 id="contact-heading">The working selection</h2>
					</div>
					<p>
						Click any frame to inspect the full photograph.<br />
						Use arrow keys to move through the sheet.
					</p>
				</header>

				<div class="contact-grid">
					{
						contactImages.map((image, index) => (
							<article
								class:list={[
									'sheet-print',
									image.size === 'landscape' && 'sheet-print--landscape',
									index === 0 && 'sheet-print--lead',
								]}
								data-sheet-print
							>
								<a
									class="photo-link"
									href={fullImageUrl(image)}
									target="_blank"
									rel="noreferrer"
									data-lightbox
									data-caption={image.caption}
									data-full-src={fullImageUrl(image)}
									data-print-index={heroLayout.length + index}
									aria-label={`View ${image.caption}`}
								>
									<span class="sheet-code" aria-hidden="true">
										{String(index + 1).padStart(2, '0')} / {image.size === 'landscape' ? 'L' : 'P'}
									</span>
									<span class="sheet-image-wrap">
										<img
											src={imageUrl(image, index === 0 ? 1200 : 760)}
											srcset={imageSrcset(image, [480, 760, 1100])}
											sizes={
												index === 0
													? '(max-width: 760px) 100vw, 48vw'
													: '(max-width: 760px) 50vw, 24vw'
											}
											alt={image.caption}
											width={image.size === 'landscape' ? 1200 : 800}
											height={image.size === 'landscape' ? 800 : 1200}
											loading="lazy"
											decoding="async"
										/>
										<span class="inspect">
											<span>Inspect</span>
											<svg viewBox="0 0 24 24" aria-hidden="true">
												<path d="M5 19 19 5M9 5h10v10" />
											</svg>
										</span>
									</span>
									<span class="sheet-caption">{image.caption}</span>
								</a>
							</article>
						))
					}
				</div>

				<footer class="sheet-footer">
					<p>End of selection</p>
					<a href="/gallery">Continue to all galleries <span aria-hidden="true">↗</span></a>
					<a href="/">Return to current homepage</a>
				</footer>
			</section>
		</main>

		<dialog class="print-viewer" id="print-viewer" aria-labelledby="viewer-caption">
			<div class="viewer-shell">
				<header class="viewer-toolbar">
					<p><span class="viewer-position">01</span> / <span class="viewer-total">00</span></p>
					<button class="viewer-close" type="button" aria-label="Close photograph">
						<span>Close</span>
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="m5 5 14 14M19 5 5 19"></path>
						</svg>
					</button>
				</header>
				<div class="viewer-image-stage">
					<img class="viewer-image" src="" alt="" />
				</div>
				<footer class="viewer-footer">
					<p id="viewer-caption"></p>
					<div>
						<button class="viewer-previous" type="button" aria-label="Previous photograph">←</button
						>
						<button class="viewer-next" type="button" aria-label="Next photograph">→</button>
					</div>
				</footer>
			</div>
		</dialog>

		<script>
			import { gsap } from 'gsap';
			import { ScrollTrigger } from 'gsap/ScrollTrigger';

			gsap.registerPlugin(ScrollTrigger);

			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
			const heroPrints = Array.from(document.querySelectorAll<HTMLElement>('.hero-print'));
			const allPhotoLinks = Array.from(
				document.querySelectorAll<HTMLAnchorElement>('[data-lightbox]'),
			);

			if (!reduceMotion) {
				const intro = gsap.timeline({ defaults: { ease: 'power3.out' } });
				intro
					.from('.desk-header', { y: -24, opacity: 0, duration: 0.75 })
					.from('.hero-copy > *', { y: 38, opacity: 0, duration: 0.9, stagger: 0.08 }, '-=0.35')
					.from(
						heroPrints,
						{
							x: (index) => (index % 2 ? 130 : -100),
							y: (index) => (index < 3 ? -90 : 120),
							rotation: (index) => (index % 2 ? 12 : -14),
							scale: 0.88,
							opacity: 0,
							duration: 1.2,
							stagger: 0.07,
							ease: 'expo.out',
						},
						'-=0.75',
					)
					.from('.scroll-cue', { opacity: 0, y: 12, duration: 0.65 }, '-=0.3');

				gsap.from('.contact-heading > *', {
					scrollTrigger: {
						trigger: '.contact-heading',
						start: 'top 82%',
						once: true,
					},
					y: 34,
					opacity: 0,
					duration: 0.9,
					stagger: 0.12,
					ease: 'power3.out',
				});

				document.querySelectorAll<HTMLElement>('.sheet-print').forEach((print, index) => {
					gsap.from(print, {
						scrollTrigger: {
							trigger: print,
							start: 'top 92%',
							once: true,
						},
						y: 60,
						rotation: index % 2 ? 1.8 : -1.8,
						opacity: 0,
						duration: 0.85,
						delay: (index % 4) * 0.055,
						ease: 'power3.out',
					});
				});
			}

			if (finePointer && !reduceMotion) {
				heroPrints.forEach((print) => {
					const restRotation = Number(print.dataset.restRotation ?? 0);

					const lift = () => {
						gsap.to(print, {
							y: -14,
							rotation: 0,
							scale: 1.035,
							duration: 0.42,
							ease: 'power3.out',
							overwrite: 'auto',
						});
					};

					const settle = () => {
						gsap.to(print, {
							x: 0,
							y: 0,
							rotation: restRotation,
							scale: 1,
							duration: 0.65,
							ease: 'elastic.out(1, 0.55)',
							overwrite: 'auto',
						});
					};

					print.addEventListener('pointerenter', lift);
					print.addEventListener('focus', lift);
					print.addEventListener('pointerleave', settle);
					print.addEventListener('blur', settle);
					print.addEventListener('pointermove', (event) => {
						const bounds = print.getBoundingClientRect();
						const x = ((event.clientX - bounds.left) / bounds.width - 0.5) * 9;
						const y = ((event.clientY - bounds.top) / bounds.height - 0.5) * 7;
						gsap.to(print, {
							x,
							y: y - 14,
							duration: 0.3,
							ease: 'power2.out',
							overwrite: 'auto',
						});
					});
				});
			}

			const viewer = document.querySelector<HTMLDialogElement>('#print-viewer');
			const viewerImage = viewer?.querySelector<HTMLImageElement>('.viewer-image');
			const viewerCaption = viewer?.querySelector<HTMLElement>('#viewer-caption');
			const viewerPosition = viewer?.querySelector<HTMLElement>('.viewer-position');
			const viewerTotal = viewer?.querySelector<HTMLElement>('.viewer-total');
			const closeButton = viewer?.querySelector<HTMLButtonElement>('.viewer-close');
			const previousButton = viewer?.querySelector<HTMLButtonElement>('.viewer-previous');
			const nextButton = viewer?.querySelector<HTMLButtonElement>('.viewer-next');
			let currentIndex = 0;
			let lastOpener: HTMLAnchorElement | null = null;

			const showPhoto = (index: number, animate = true) => {
				if (!viewer || !viewerImage || !viewerCaption || !viewerPosition || !allPhotoLinks.length) {
					return;
				}

				currentIndex = (index + allPhotoLinks.length) % allPhotoLinks.length;
				const sourceLink = allPhotoLinks[currentIndex];
				const source = sourceLink.dataset.fullSrc ?? sourceLink.href;
				const caption = sourceLink.dataset.caption ?? '';

				const commitPhoto = () => {
					viewerImage.src = source;
					viewerImage.alt = caption;
					viewerCaption.textContent = caption;
					viewerPosition.textContent = String(currentIndex + 1).padStart(2, '0');

					if (animate && !reduceMotion) {
						gsap.fromTo(
							viewerImage,
							{ opacity: 0, scale: 0.975 },
							{ opacity: 1, scale: 1, duration: 0.4, ease: 'power2.out' },
						);
					} else {
						gsap.set(viewerImage, { opacity: 1, scale: 1 });
					}
				};

				if (animate && !reduceMotion && viewerImage.src) {
					gsap.to(viewerImage, {
						opacity: 0,
						scale: 0.985,
						duration: 0.16,
						ease: 'power1.in',
						onComplete: commitPhoto,
					});
				} else {
					commitPhoto();
				}
			};

			if (
				viewer &&
				viewerImage &&
				viewerTotal &&
				closeButton &&
				previousButton &&
				nextButton &&
				typeof viewer.showModal === 'function'
			) {
				viewerTotal.textContent = String(allPhotoLinks.length).padStart(2, '0');

				allPhotoLinks.forEach((link, index) => {
					link.addEventListener('click', (event) => {
						event.preventDefault();
						lastOpener = link;
						showPhoto(index, false);
						viewer.showModal();
						document.documentElement.dataset.viewerOpen = 'true';
						closeButton.focus();

						if (!reduceMotion) {
							gsap.fromTo(
								'.viewer-shell',
								{ opacity: 0, y: 18, scale: 0.985 },
								{ opacity: 1, y: 0, scale: 1, duration: 0.45, ease: 'power3.out' },
							);
						}
					});
				});

				closeButton.addEventListener('click', () => viewer.close());
				previousButton.addEventListener('click', () => showPhoto(currentIndex - 1));
				nextButton.addEventListener('click', () => showPhoto(currentIndex + 1));

				viewer.addEventListener('click', (event) => {
					if (event.target === viewer) viewer.close();
				});

				viewer.addEventListener('close', () => {
					delete document.documentElement.dataset.viewerOpen;
					viewerImage.removeAttribute('src');
					lastOpener?.focus();
				});

				viewer.addEventListener('keydown', (event) => {
					if (event.key === 'ArrowLeft') {
						event.preventDefault();
						showPhoto(currentIndex - 1);
					}
					if (event.key === 'ArrowRight') {
						event.preventDefault();
						showPhoto(currentIndex + 1);
					}
				});
			}
		</script>
	</body>
</html>

<style is:global>
	:root {
		--ivory: #eee9de;
		--paper: #f8f5ed;
		--paper-bright: #fffdf7;
		--ink: #1a1916;
		--muted: #777166;
		--rule: rgba(26, 25, 22, 0.22);
		--red: #a33a2b;
		--serif: 'Newsreader', 'Iowan Old Style', 'Baskerville', Georgia, serif;
		--sans: 'DM Sans', 'Helvetica Neue', Arial, sans-serif;
	}

	* {
		box-sizing: border-box;
	}

	html {
		background: var(--ivory);
		color: var(--ink);
		scroll-behavior: smooth;
	}

	html[data-viewer-open='true'] {
		overflow: hidden;
	}

	body {
		min-width: 320px;
		margin: 0;
		background:
			linear-gradient(
				90deg,
				rgba(255, 255, 255, 0.16),
				transparent 18%,
				transparent 82%,
				rgba(80, 61, 35, 0.03)
			),
			var(--ivory);
		font-family: var(--sans);
	}

	a,
	button {
		-webkit-tap-highlight-color: transparent;
	}

	a:focus-visible,
	button:focus-visible {
		outline: 2px solid var(--red);
		outline-offset: 5px;
	}

	.worktable-grain {
		position: fixed;
		z-index: 100;
		inset: 0;
		pointer-events: none;
		opacity: 0.24;
		background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 240 240' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.92' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.12'/%3E%3C/svg%3E");
		mix-blend-mode: multiply;
	}

	.desk-header {
		position: relative;
		z-index: 40;
		min-height: 70px;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 24px;
		padding: 0 clamp(22px, 3vw, 54px);
		border-bottom: 1px solid var(--rule);
	}

	.desk-wordmark {
		justify-self: start;
		color: var(--ink);
		font-family: var(--serif);
		font-size: 21px;
		letter-spacing: -0.025em;
		text-decoration: none;
	}

	.desk-wordmark span {
		color: var(--muted);
		font-family: var(--sans);
		font-size: 9px;
		font-weight: 500;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.desk-header nav {
		display: flex;
		gap: clamp(20px, 3vw, 48px);
	}

	.desk-header nav a,
	.edition {
		color: var(--ink);
		font-size: 9px;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.desk-header nav a {
		position: relative;
		padding-block: 10px;
	}

	.desk-header nav a::after {
		position: absolute;
		right: 100%;
		bottom: 4px;
		left: 0;
		height: 1px;
		background: var(--red);
		content: '';
		transition: right 0.25s ease;
	}

	.desk-header nav a:hover::after,
	.desk-header nav a:focus-visible::after {
		right: 0;
	}

	.edition {
		justify-self: end;
		margin: 0;
		color: var(--muted);
	}

	.edition span {
		color: var(--red);
	}

	.hero {
		position: relative;
		min-height: max(850px, calc(100svh - 70px));
		overflow: hidden;
		border-bottom: 1px solid var(--rule);
	}

	.hero-copy {
		position: absolute;
		z-index: 20;
		top: clamp(90px, 13vh, 140px);
		left: clamp(22px, 5.4vw, 104px);
		width: min(37vw, 620px);
	}

	.kicker {
		display: flex;
		align-items: center;
		gap: 10px;
		margin: 0 0 22px;
		color: var(--red);
		font-size: 9px;
		font-weight: 600;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	.kicker span {
		font-size: 7px;
	}

	.hero h1 {
		max-width: 590px;
		margin: 0;
		font-family: var(--serif);
		font-size: clamp(52px, 5.1vw, 92px);
		font-weight: 300;
		letter-spacing: -0.057em;
		line-height: 0.91;
		text-wrap: balance;
	}

	.lede {
		max-width: 510px;
		margin: 28px 0 0;
		color: #4d4942;
		font-family: var(--serif);
		font-size: clamp(18px, 1.35vw, 23px);
		font-weight: 300;
		letter-spacing: -0.015em;
		line-height: 1.42;
	}

	.before-after-link {
		width: min(100%, 360px);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		margin-top: 31px;
		padding-block: 13px;
		border-block: 1px solid var(--ink);
		color: var(--ink);
		font-size: 10px;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.before-after-link svg {
		width: 64px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1;
		transition: transform 0.3s ease;
	}

	.before-after-link:hover svg,
	.before-after-link:focus-visible svg {
		transform: translateX(7px);
	}

	.print-stage {
		position: absolute;
		z-index: 5;
		inset: 0;
	}

	.stage-note {
		position: absolute;
		z-index: 1;
		margin: 0;
		color: rgba(67, 61, 52, 0.52);
		font-size: 8px;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.note-top {
		top: 28px;
		left: 52%;
	}

	.note-side {
		right: 25px;
		bottom: 50px;
		writing-mode: vertical-rl;
	}

	.registration-mark {
		position: absolute;
		width: 22px;
		height: 22px;
