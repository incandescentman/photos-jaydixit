	.site-header {
		position: absolute;
		z-index: 50;
		top: 0;
		right: 0;
		left: 0;
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: clamp(36px, 4vw, 78px);
		align-items: center;
		min-height: 120px;
		margin: 0 clamp(20px, 3.2vw, 60px);
