---
export const prerender = true;

import { images } from '../data/homepage-images.js';
import rawImageMetadata from '../data/image-metadata.json';
import { cldSizes, cldSrcset, cldUrl } from '../lib/cloudinary';
import PhotoSwipeLightbox from '../components/PhotoSwipeLightbox.astro';
import siteConfig from '../../site.config.mts';
import MainLayout from '../layouts/MainLayout.astro';

type HomepageImage = {
	filename: string;
	size: 'portrait' | 'landscape' | 'xlportrait';
	caption: string;
	cloudinaryPublicId?: string;
};

type ImageDimensions = { width: number; height: number };
const imageMetadata = rawImageMetadata as Record<string, ImageDimensions>;

const publicIdFor = (image: HomepageImage) =>
	image.cloudinaryPublicId ?? `highlights/${image.filename.replace(/\.[^.]+$/, '')}`;

const imageData = (index: number) => {
	const image = images[index] as HomepageImage;
	const publicId = publicIdFor(image);
	const dimensions = imageMetadata[`highlights/${image.filename}`];
	const aspectRatio = dimensions
		? dimensions.width / dimensions.height
		: image.size === 'landscape'
			? 3 / 2
			: 2 / 3;
	const lightboxWidth = 2400;
	return {
		...image,
		publicId,
		src: cldUrl(publicId, 1000),
		srcset: cldSrcset(publicId, [480, 760, 1000, 1400, 1800]),
		fullSrc: cldUrl(publicId, 2400),
		lightboxSrcset: cldSrcset(publicId, [1000, 1600, 2000, 2400]),
		lightboxWidth,
		lightboxHeight: Math.round(lightboxWidth / aspectRatio),
		sizes: cldSizes('(max-width: 720px) 88vw, (max-width: 1100px) 44vw, 30vw'),
	};
};

const heroPrintLayout = [
	{ photo: imageData(22), x: 49, y: 7, width: 29, rotation: 0, z: 5 },
	{ photo: imageData(32), x: 72, y: 10, width: 27, rotation: 3.1, z: 3 },
	{ photo: imageData(4), x: 81, y: 41, width: 18, rotation: -3.7, z: 6 },
	{ photo: imageData(2), x: 58, y: 51, width: 22, rotation: 2.2, z: 9 },
	{ photo: imageData(21), x: 47, y: 64, width: 16, rotation: -1.7, z: 6 },
	{ photo: imageData(1), x: 31, y: 15, width: 18, rotation: -1, z: 2 },
	{ photo: imageData(34), x: 31, y: 47, width: 18, rotation: -2, z: 4 },
	{ photo: imageData(0), x: 78, y: 74, width: 19, rotation: 1.7, z: 8 },
];
const heroPublicIds = new Set(heroPrintLayout.map(({ photo }) => photo.publicId));
const mobilePreservedHiddenWallIds = new Set([imageData(8).publicId, imageData(31).publicId]);
const mobileWideWallPositions = new Set([3, 8, 11]);
let mobileWallPosition = 0;
const wallPhotos = [2, 0, 9, 22, 8, 3, 18, 10, 24, 19, 5, 25, 32, 11, 31, 17, 33].map(
	(imageIndex) => {
		const photo = imageData(imageIndex);
		const mobileDuplicate =
			heroPublicIds.has(photo.publicId) || mobilePreservedHiddenWallIds.has(photo.publicId);
		const mobilePosition = mobileDuplicate ? null : ++mobileWallPosition;

		return {
			...photo,
			mobileDuplicate,
			mobilePosition,
			mobileWide: mobilePosition !== null && mobileWideWallPositions.has(mobilePosition),
		};
	},
);
const wallLayouts = [
	'wall-feature',
	'wall-portrait',
	'wall-landscape',
	'wall-portrait',
	'wall-tall',
	'wall-portrait',
	'wall-tall',
	'wall-landscape',
	'wall-feature',
	'wall-portrait',
	'wall-portrait',
	'wall-tall',
	'wall-landscape',
	'wall-portrait',
	'wall-portrait',
	'wall-tall',
	'wall-landscape',
];

const wallImageSizes = (index: number, mobileWide: boolean) => {
	const layout = wallLayouts[index];
	const isWide = layout === 'wall-feature' || layout === 'wall-landscape';

	return cldSizes(
		`(max-width: 540px) ${mobileWide ? 'calc(100vw - 16px)' : 'calc((100vw - 24px) / 2)'}, (max-width: 820px) ${mobileWide ? 'calc(100vw - 24px)' : 'calc((100vw - 36px) / 2)'}, (max-width: 1180px) ${isWide ? '50vw' : '33vw'}, ${isWide ? '50vw' : '25vw'}`,
	);
};

const navLinks = [
	{ href: '/red-carpet', label: 'Red Carpet' },
	{ href: '/before-after', label: 'Before & After' },
	{ href: '/about', label: 'About Me' },
	{ href: '/blog/wikiportraits-story', label: 'Why WikiPortraits' },
	{ href: '/red-carpets', label: 'Red Carpets Around the World' },
	{ href: '/contact', label: 'Contact' },
	{ href: 'https://jaydixit.com', label: 'jaydixit.com', external: true },
];

const title = 'Jay Dixit: Red Carpet Photography for Wikipedia';
const description =
	'As a red carpet photographer for WikiPortraits, I take pictures of celebrities, leaders, and scientists at film festivals and cultural events around the world, then release the images under a free license for use on Wikipedia.';
---

<MainLayout
	title="Red Carpet Photography for Wikipedia"
	description={description}
	canonical="/"
	image={heroPrintLayout[0].photo.fullSrc}
	imageAlt={heroPrintLayout[0].photo.caption}
	showChrome={false}
>
	<meta slot="head" name="theme-color" content="#f4efe5" />
	<a class="skip-link" href="#main-content">Skip to content</a>
	<div class="reading-progress" aria-hidden="true"><span></span></div>

	<header class="site-header" data-header>
		<a class="site-mark" href="/" aria-label="Jay Dixit Photos, current homepage">
			<img src="/brand/red-carpet-seal.svg" alt="" width="72" height="72" />
			<span>Jay Dixit</span>
			<small>Photos</small>
		</a>
		<nav class="site-nav-primary" aria-label="Primary navigation">
			{
				navLinks.map(({ href, label, external }) =>
					external ? (
						<a href={href} target="_blank" rel="noopener noreferrer">
							{label} <span aria-hidden="true">↗</span>
						</a>
					) : (
						<a href={href}>{label}</a>
					),
				)
			}
		</nav>
		<a class="header-contact" href="/contact">Contact <span aria-hidden="true">↗</span></a>
		<button
			class="header-menu-toggle"
			type="button"
			data-menu-toggle
			aria-expanded="false"
			aria-controls="homepage-menu"
		>
			<span class="header-menu-bars" aria-hidden="true"></span>
			<span class="header-menu-label">Menu</span>
		</button>
		<nav class="header-menu" id="homepage-menu" data-menu-panel aria-label="Site menu" hidden>
			{
				navLinks.map(({ href, label, external }) => (
					<a
						href={href}
						data-menu-link
						{...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
					>
						{label} <span aria-hidden="true">{external ? '↗' : '→'}</span>
					</a>
				))
			}
		</nav>
	</header>

	<main id="main-content">
		<section class="hero" aria-labelledby="hero-title" data-hero>
			<canvas class="atmosphere" data-atmosphere aria-hidden="true"></canvas>
			<div class="hero-orbit" aria-hidden="true"></div>
			<div class="hero-grid">
				<div class="hero-copy">
					<p class="eyebrow" data-reveal>Red Carpet Photography for Wikipedia</p>
					<h1 id="hero-title" aria-label={title}>
						<span class="title-line" aria-hidden="true"><span>Jay Dixit:</span></span>
						<span class="title-line title-line-emphasis" aria-hidden="true"
							><span>Red Carpet</span></span
						>
						<span class="title-line" aria-hidden="true"><span>Photography</span></span>
						<span class="title-line title-line-final" aria-hidden="true"
							><span>for Wikipedia</span></span
						>
					</h1>
					<p class="hero-lede" data-reveal>{description}</p>
					<div class="hero-actions" data-reveal>
						<a class="hero-action" href="/before-after">
							<span>See the Before &amp; After</span>
							<svg viewBox="0 0 36 14" aria-hidden="true">
								<path d="M1 7h32M27 1l6 6-6 6"></path>
							</svg>
						</a>
						<a class="hero-action" href="/about">
							<span>About Me</span>
							<svg viewBox="0 0 36 14" aria-hidden="true">
								<path d="M1 7h32M27 1l6 6-6 6"></path>
							</svg>
						</a>
						<a class="hero-action" href="/blog/wikiportraits-story">
							<span>The Story of WikiPortraits</span>
							<svg viewBox="0 0 36 14" aria-hidden="true">
								<path d="M1 7h32M27 1l6 6-6 6"></path>
							</svg>
						</a>
						<a class="hero-action" href="/red-carpets">
							<span>Red Carpets Around the World</span>
							<svg viewBox="0 0 36 14" aria-hidden="true">
								<path d="M1 7h32M27 1l6 6-6 6"></path>
							</svg>
						</a>
					</div>
				</div>

				<div
					id="hero-print-gallery"
					class="hero-stage"
					aria-label="Selected portrait prints"
					data-hero-stage
				>
					<div class="darkroom-line darkroom-line-one" aria-hidden="true"></div>
					<div class="darkroom-line darkroom-line-two" aria-hidden="true"></div>
					{
						heroPrintLayout.map(({ photo, x, y, width, rotation, z }, index) => (
							<a
								class="hero-print"
								data-hero-photo
								data-depth={(index + 1) * 0.12}
								data-tilt
								data-pswp-item="true"
								data-full-src={photo.fullSrc}
								data-pswp-srcset={photo.lightboxSrcset}
								data-pswp-width={photo.lightboxWidth}
								data-pswp-height={photo.lightboxHeight}
								data-pswp-caption={photo.caption}
								data-cropped="true"
								href={photo.fullSrc}
								style={`--print-x:${x}%;--print-y:${y}%;--print-width:${width}%;--print-rotation:${rotation}deg;--print-z:${z}`}
								aria-label={`${photo.caption} — view full size`}
							>
								<span class="clothespin" aria-hidden="true" />
								<img
									src={photo.src}
									srcset={photo.srcset}
									sizes={
										index === 1
											? '(max-width: 820px) calc(100vw - 40px), 29vw'
											: '(max-width: 820px) calc((100vw - 52px) / 2), 29vw'
									}
									alt={photo.caption}
									width={index === 1 ? 1200 : 800}
									height={index === 1 ? 800 : 1200}
									loading={index === 0 ? 'eager' : 'lazy'}
									fetchpriority={index === 0 ? 'high' : undefined}
									decoding="async"
								/>
							</a>
						))
					}
				</div>
			</div>

			<div class="hero-footer" data-reveal>
				<span>Selected portraits</span>
				<a href="#selected-portraits">Scroll to explore <i aria-hidden="true">↓</i></a>
			</div>

			<a class="scroll-cue" href="#selected-portraits" data-scroll-cue>
				<span>Scroll</span>
				<i aria-hidden="true">↓</i>
			</a>
		</section>

		<section
			class="editorial-profile"
			id="red-carpets-around-the-world"
			aria-label="About Jay Dixit"
		>
			<div class="profile-rail" aria-hidden="true">
				<i></i>
			</div>

			<figure id="profile-portrait-gallery" class="profile-portrait">
				<a
					class="profile-image-frame"
					data-pswp-item="true"
					data-full-src="/images/jay-anisha-williamsburg_jay-dixit-photos_lighter.jpg"
					data-pswp-srcset="/images/jay-anisha-williamsburg_jay-dixit-photos_lighter-720.jpg 720w, /images/jay-anisha-williamsburg_jay-dixit-photos_lighter-1280.jpg 1280w, /images/jay-anisha-williamsburg_jay-dixit-photos_lighter.jpg 3000w"
					data-pswp-width="3000"
					data-pswp-height="2000"
					data-pswp-caption="Jay Dixit"
					href="/images/jay-anisha-williamsburg_jay-dixit-photos_lighter.jpg"
					aria-label="Jay Dixit — view full size"
				>
					<img
						src="/images/jay-anisha-williamsburg_jay-dixit-photos_lighter-1280.jpg"
						srcset="/images/jay-anisha-williamsburg_jay-dixit-photos_lighter-720.jpg 720w, /images/jay-anisha-williamsburg_jay-dixit-photos_lighter-1280.jpg 1280w, /images/jay-anisha-williamsburg_jay-dixit-photos_lighter.jpg 3000w"
						sizes="(max-width: 540px) calc(100vw - 40px), (max-width: 820px) calc(100vw - 126px), (max-width: 1180px) 38vw, 48vw"
						alt="Jay Dixit at the Williamsburg waterfront"
						width="3000"
						height="2000"
						loading="lazy"
						decoding="async"
					/>
				</a>
				<figcaption>Jay Dixit</figcaption>
			</figure>

			<div class="profile-copy">
				<p class="profile-coverage">
					As a photographer, I’ve covered Sundance, SXSW, the Toronto International Film Festival,
					the New York Film Festival, the Locarno Film Festival in Switzerland, and the Busan Film
					Festival in Korea, as well as the Nobel Prizes in Stockholm and Oslo.
				</p>
				<p class="profile-bio">
					I’m also a writer, former Yale writing professor, and AI educator. My work has appeared in
					The New York Times, Rolling Stone, The Washington Post, Wired, Harvard Business Review,
					and Psychology Today, where I was a senior editor. I was OpenAI’s first Head of Community
					for Writers, and I now run my own training and education consultancy,
					<a href="https://socraticai.co/" target="_blank" rel="noopener noreferrer">Socratic AI</a
					>.
				</p>
				<a class="profile-link" href="/about">
					Why I Take Photographs <span aria-hidden="true">→</span>
				</a>
			</div>
		</section>

		<section class="portrait-section" id="selected-portraits" aria-labelledby="portraits-title">
			<header class="section-header">
				<p>Selected portraits</p>
				<h2 id="portraits-title">The photo wall</h2>
				<a href="/gallery">View all galleries <span aria-hidden="true">↗</span></a>
			</header>

			<div class="photo-wall" data-photo-wall>
				{
					wallPhotos.map((photo, index) => (
						<article
							class={`wall-card ${wallLayouts[index]}`}
							data-wall-card
							data-mobile-duplicate={photo.mobileDuplicate ? 'true' : undefined}
							data-mobile-position={photo.mobilePosition ?? undefined}
							style={`--card-index: ${index}`}
						>
							<a
								data-pswp-item="true"
								data-mobile-duplicate={photo.mobileDuplicate ? 'true' : undefined}
								data-full-src={photo.fullSrc}
								data-pswp-srcset={photo.lightboxSrcset}
								data-pswp-width={photo.lightboxWidth}
								data-pswp-height={photo.lightboxHeight}
								data-pswp-caption={photo.caption}
								data-cropped="true"
								href={photo.fullSrc}
								aria-label={`${photo.caption} — view full size`}
							>
								<div class="wall-media" data-tilt>
									<img
										src={photo.src}
										srcset={photo.srcset}
										sizes={wallImageSizes(index, photo.mobileWide)}
										alt={photo.caption}
										width={photo.size === 'landscape' ? 1200 : 800}
										height={photo.size === 'landscape' ? 800 : 1200}
										loading="lazy"
										decoding="async"
									/>
									<span class="wall-number" aria-hidden="true">
										<span class="wall-number-desktop">{index + 1}</span>
										{photo.mobilePosition !== null && (
											<span class="wall-number-mobile">{photo.mobilePosition}</span>
										)}
									</span>
									<span class="wall-arrow" aria-hidden="true">
										↗
									</span>
								</div>
							</a>
						</article>
					))
				}
			</div>
		</section>

		<section class="closing-panel" aria-labelledby="closing-title">
			<h2 id="closing-title">Jay Dixit <em>Photos</em></h2>
			<div class="closing-links">
				<a href="/red-carpet">Red Carpet <span aria-hidden="true">↗</span></a>
				<a href="/gallery">Galleries <span aria-hidden="true">↗</span></a>
				<a href="/before-after">Before &amp; After <span aria-hidden="true">↗</span></a>
				<a href="/contact">Contact <span aria-hidden="true">↗</span></a>
			</div>
		</section>
	</main>

	<PhotoSwipeLightbox
		gallerySelector="#hero-print-gallery"
		childrenSelector="a[data-pswp-item]"
		options={{
			wheelToZoom: true,
			padding: { top: 20, bottom: 80, left: 20, right: 20 },
			showHideAnimationType: 'zoom',
			showAnimationDuration: 650,
			easing: 'cubic-bezier(0.4, 0, 0.2, 1)',
			mainClass: 'pswp--kinetic-editorial',
			bgOpacity: 0.28,
		}}
	/>

	<PhotoSwipeLightbox
		gallerySelector="[data-photo-wall]"
		childrenSelector="a[data-pswp-item]"
		responsiveExclude={{
			media: '(max-width: 820px)',
			selector: '[data-mobile-duplicate="true"]',
		}}
		options={{
			wheelToZoom: true,
			padding: { top: 20, bottom: 80, left: 20, right: 20 },
			showHideAnimationType: 'zoom',
			showAnimationDuration: 650,
			easing: 'cubic-bezier(0.4, 0, 0.2, 1)',
			mainClass: 'pswp--kinetic-editorial',
			bgOpacity: 0.28,
		}}
	/>

	<PhotoSwipeLightbox
		gallerySelector="#profile-portrait-gallery"
		childrenSelector="a[data-pswp-item]"
		options={{
			wheelToZoom: true,
			padding: { top: 20, bottom: 80, left: 20, right: 20 },
			showHideAnimationType: 'zoom',
			showAnimationDuration: 650,
			easing: 'cubic-bezier(0.4, 0, 0.2, 1)',
			mainClass: 'pswp--kinetic-editorial',
			bgOpacity: 0.28,
		}}
	/>

	<footer class="site-footer">
		<span>© {new Date().getFullYear()} {siteConfig.owner}</span>
	</footer>

	<script>
		import { initKineticEditorial } from '../scripts/experiments/kineticEditorial';

		initKineticEditorial();
	</script>
</MainLayout>

<style is:global>
	:root {
		--paper: #f4efe5;
		--paper-bright: #fbf8f1;
		--ink: #171713;
		--muted: #756e64;
		--accent: #a43f2e;
		--accent-soft: #d9ad91;
		--rule: rgba(23, 23, 19, 0.22);
		--serif: 'Newsreader', 'Iowan Old Style', 'Baskerville', 'Times New Roman', serif;
		--sans: 'Instrument Sans', 'Helvetica Neue', Arial, sans-serif;
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
		overflow-x: clip;
		background: var(--paper);
	}

	body {
		margin: 0;
		min-width: 320px;
		overflow-x: clip;
		background:
			linear-gradient(rgba(23, 23, 19, 0.025) 1px, transparent 1px),
			linear-gradient(90deg, rgba(23, 23, 19, 0.018) 1px, transparent 1px), var(--paper);
		background-size:
			100% 8px,
			8px 100%;
		color: var(--ink);
		font-family: var(--sans);
		-webkit-font-smoothing: antialiased;
	}

	body::after {
		position: fixed;
		z-index: 100;
		inset: 0;
		pointer-events: none;
		content: '';
		opacity: 0.17;
		background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.18'/%3E%3C/svg%3E");
		mix-blend-mode: multiply;
	}

	.pswp.pswp--kinetic-editorial {
		--pswp-bg: var(--paper);
		--pswp-placeholder-bg: #ded5c8;
		--pswp-icon-color: #96773f;
		--pswp-icon-color-secondary: var(--paper-bright);
		--pswp-icon-stroke-color: var(--ink);
		--pswp-icon-stroke-width: 1.5px;
		--pswp-preloader-color: rgb(150 119 63 / 35%);
		--pswp-preloader-color-secondary: #96773f;
	}

	.pswp.pswp--kinetic-editorial .pswp__bg {
		background-color: var(--paper) !important;
		opacity: 1 !important;
	}

	.pswp--kinetic-editorial .pswp__img {
		box-shadow:
			0 3px 10px rgb(23 23 19 / 20%),
			0 24px 70px rgb(23 23 19 / 30%);
	}

	.pswp--kinetic-editorial .pswp__counter {
		color: var(--ink);
		font-family: var(--sans);
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-shadow: 0 1px 0 var(--paper-bright);
	}

	.pswp--kinetic-editorial .pswp__button--close,
	.pswp--kinetic-editorial .pswp__button--zoom {
		width: 44px;
		height: 44px;
		margin: 8px 8px 0 0;
		border: 1px solid rgb(150 119 63 / 45%);
		border-radius: 50%;
		background: var(--paper-bright);
		box-shadow: 0 4px 18px rgb(23 23 19 / 12%);
	}

	.pswp--kinetic-editorial .pswp__button--close:hover,
	.pswp--kinetic-editorial .pswp__button--close:focus-visible,
	.pswp--kinetic-editorial .pswp__button--zoom:hover,
	.pswp--kinetic-editorial .pswp__button--zoom:focus-visible {
		border-color: #96773f;
		background: var(--paper-bright);
	}

	.pswp--kinetic-editorial .pswp__button--close .pswp__icn,
	.pswp--kinetic-editorial .pswp__button--zoom .pswp__icn {
		top: 5px;
		left: 5px;
	}

	.pswp--kinetic-editorial .pswp__button--arrow .pswp__icn {
		filter: drop-shadow(0 2px 5px rgb(23 23 19 / 22%));
	}

	.pswp--kinetic-editorial .pswp__button--arrow {
		top: calc(50% - 30px);
	}

	.pswp--kinetic-editorial .pswp__button--arrow--prev {
		left: max(12px, calc(35.5vw - 87px));
	}

	.pswp--kinetic-editorial .pswp__button--arrow--next {
		right: max(12px, calc(35.5vw - 87px));
	}

	.pswp--kinetic-editorial .pswp__custom--caption {
		right: auto !important;
		bottom: 22px !important;
		left: 50% !important;
		width: max-content !important;
		max-width: min(80vw, 720px) !important;
		padding: 10px 17px 11px !important;
		transform: translateX(-50%);
		border: 1px solid rgb(150 119 63 / 42%);
		background: var(--paper-bright) !important;
		box-shadow: 0 7px 26px rgb(23 23 19 / 16%);
		color: var(--ink) !important;
		font-family: var(--serif) !important;
		font-size: 16px !important;
