		top: 52%;
		transform: rotate(0.6deg);
	}

	.hero-print {
		position: absolute;
		z-index: var(--print-z);
		top: var(--print-y);
		left: var(--print-x);
		display: block;
		width: var(--print-width);
		padding: clamp(7px, 0.7vw, 12px);
		padding-bottom: clamp(42px, 4vw, 65px);
		background: #fffdf7;
		box-shadow:
			0 28px 60px rgb(53 42 27 / 16%),
			0 3px 9px rgb(53 42 27 / 13%);
		color: var(--ink);
		text-decoration: none;
		transform: rotate(var(--print-rotation));
		transform-origin: 50% 55%;
		will-change: transform;
		pointer-events: auto;
