	.hero-print img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		aspect-ratio: 2 / 3;
		background: #d8d2c7;
		transition:
			filter 450ms ease,
			transform 800ms cubic-bezier(0.2, 0.75, 0.2, 1);
	}

	.hero-print:nth-of-type(2) img {
		aspect-ratio: 3 / 2;
	}

	.hero-print:hover img,
	.hero-print:focus-visible img {
		filter: saturate(1.05) contrast(1.02);
		transform: scale(1.025);
	}

	.print-caption {
		position: absolute;
		right: 11px;
