		position: relative;
		font-size: 0.76rem;
		font-weight: 600;
		letter-spacing: 0.085em;
		text-decoration: none;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.site-nav-primary a span {
		color: var(--accent);
	}

	.site-nav-primary a::after,
	.header-contact::after {
		position: absolute;
		right: 100%;
		bottom: -7px;
		left: 0;
		height: 1px;
		background: var(--accent);
		content: '';
		transition: right 220ms ease;
	}

	.site-nav-primary a:hover::after,
	.site-nav-primary a:focus-visible::after,
	.header-contact:hover::after,
	.header-contact:focus-visible::after {
		right: 0;
	}

	.header-contact {
		display: none;
		align-items: center;
		justify-self: end;
		min-height: 44px;
	}

	.header-contact span {
		color: var(--accent);
	}

	/* Compact navigation. Hidden at full desktop width, where the inline nav is shown. */
	.header-menu-toggle {
		display: none;
		align-items: center;
		gap: 9px;
		justify-self: end;
		min-height: 44px;
		padding: 0 2px;
		border: 0;
		background: none;
		color: var(--ink);
		font-family: var(--sans);
		font-size: 0.76rem;
		font-weight: 600;
		letter-spacing: 0.085em;
		text-transform: uppercase;
		cursor: pointer;
	}

	.header-menu-bars {
		position: relative;
		width: 20px;
		height: 9px;
	}

	.header-menu-bars::before,
	.header-menu-bars::after {
		position: absolute;
		right: 0;
		left: 0;
		height: 1.5px;
		background: var(--ink);
		content: '';
		transition:
			transform 240ms ease,
			opacity 180ms ease;
	}

	.header-menu-bars::before {
		top: 0;
	}

	.header-menu-bars::after {
		bottom: 0;
		left: 5px;
	}

	.header-menu-toggle[aria-expanded='true'] .header-menu-bars::before {
		transform: translateY(3.75px) rotate(45deg);
	}

	.header-menu-toggle[aria-expanded='true'] .header-menu-bars::after {
		left: 0;
		transform: translateY(-3.75px) rotate(-45deg);
	}

	.header-menu {
		display: none;
		grid-column: 1 / -1;
		padding-bottom: 12px;
	}

	.header-menu[hidden] {
		display: none;
	}

	.header-menu a {
