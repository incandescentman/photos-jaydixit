	.site-mark span {
		font-family: var(--serif);
		font-size: 2.35rem;
		font-weight: 500;
		line-height: 1;
		letter-spacing: -0.025em;
	}

	.site-mark small {
		color: var(--accent);
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
