---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro:assets';
import MainLayout from '../../layouts/MainLayout.astro';
import siteConfig from '../../../site.config.mts';
import rawPeople from '../../data/people.json';

interface Person {
	slug: string;
	name: string;
	match: string[];
	photoSlugs?: string[];
	bio?: string;
	wikipedia?: string;
}

const people = rawPeople as Person[];

const galleryImageModules = import.meta.glob<{ default: ImageMetadata }>(
	'../../gallery/photos/**/*.{jpg,jpeg,png,webp,gif}',
	{ eager: true },
);

const highlightImageModules = import.meta.glob<{ default: ImageMetadata }>(
	'../../gallery/highlights/**/*.{jpg,jpeg,png,webp,gif}',
	{ eager: true },
);

const wikiportraitImageModules = import.meta.glob<{ default: ImageMetadata }>(
	'../../assets/images/wikiportraits/**/*.{jpg,jpeg,png,webp,gif}',
	{ eager: true },
);

function getSubjectSlug(filename: string): string {
	const baseName = filename.replace(/\.[^/.]+$/, '');
	return baseName.split('_')[0];
}

function normalizeMatchValue(value: string) {
	return value.trim().toLowerCase();
}

function matchesPerson(subjectSlug: string, photoSlug: string, person: Person): boolean {
	const normalizedSubjectSlug = normalizeMatchValue(subjectSlug);
	const normalizedPhotoSlug = normalizeMatchValue(photoSlug);
	const explicitPhotoSlugs = new Set((person.photoSlugs ?? []).map(normalizeMatchValue));

	if (explicitPhotoSlugs.has(normalizedPhotoSlug)) {
		return true;
	}

	return person.match.some((pattern) => {
		const normalizedPattern = normalizeMatchValue(pattern);
		if (normalizedSubjectSlug === normalizedPattern) return true;
		if (normalizedSubjectSlug.startsWith(normalizedPattern + '-')) {
			const suffix = normalizedSubjectSlug.slice(normalizedPattern.length + 1);
			return /^\d+$/.test(suffix);
		}
		return false;
	});
}

// Collect all match patterns to detect multi-person photos
const allMatchPatterns = people.flatMap((p) => p.match.map(normalizeMatchValue));

function isMultiPersonPhoto(photoSlug: string, currentPerson: Person): boolean {
	const normalizedSlug = normalizeMatchValue(photoSlug);
	const ownPatterns = new Set(currentPerson.match.map(normalizeMatchValue));
	return allMatchPatterns.some(
		(pattern) => !ownPatterns.has(pattern) && normalizedSlug.includes(pattern),
	);
}

const extensionPriority = ['jpg', 'jpeg', 'webp', 'png', 'gif'];
const sourcePriority = { gallery: 0, highlights: 1, wikiportraits: 2 } as const;

function extensionRank(file: string) {
	const ext = file.split('.').pop()?.toLowerCase() ?? '';
	const rank = extensionPriority.indexOf(ext);
	return rank === -1 ? extensionPriority.length : rank;
}

const personEntries = people
	.map((person) => {
		const matchingPhotos: {
			metadata: ImageMetadata;
			filename: string;
			slug: string;
			source: keyof typeof sourcePriority;
		}[] = [];

		const collectMatchingPhotos = (
			modules: Record<string, { default: ImageMetadata }>,
			basePath: string,
			source: keyof typeof sourcePriority,
		) => {
			Object.entries(modules).forEach(([key, module]) => {
				const relativePath = key.replace(basePath, '');
				const segments = relativePath.split('/');
				const filename = segments.pop();
				if (!filename) return;
				const subjectSlug = getSubjectSlug(filename);

				const photoSlug = filename.replace(/\.[^/.]+$/, '');
				if (
					matchesPerson(subjectSlug, photoSlug, person) &&
					!isMultiPersonPhoto(photoSlug, person)
				) {
					matchingPhotos.push({
						metadata: module.default,
						filename,
						slug: photoSlug,
						source,
					});
				}
			});
		};

		collectMatchingPhotos(galleryImageModules, '../../gallery/photos/', 'gallery');
		collectMatchingPhotos(highlightImageModules, '../../gallery/highlights/', 'highlights');
		collectMatchingPhotos(
			wikiportraitImageModules,
			'../../assets/images/wikiportraits/',
			'wikiportraits',
		);

		const grouped = matchingPhotos.reduce<Record<string, typeof matchingPhotos>>((acc, photo) => {
			const key = photo.slug;
			if (!acc[key]) acc[key] = [];
			acc[key].push(photo);
			return acc;
		}, {});

		const deduplicated = Object.values(grouped).map(
			(variants) =>
				variants.slice().sort((a, b) => {
					const sourceDiff = sourcePriority[a.source] - sourcePriority[b.source];
					if (sourceDiff !== 0) return sourceDiff;
					return extensionRank(a.filename) - extensionRank(b.filename);
				})[0],
		);

		if (deduplicated.length === 0) return null;

		return {
			...person,
			photoCount: deduplicated.length,
			sampleImage: deduplicated[0].metadata,
		};
	})
	.filter(
		(entry): entry is Person & { photoCount: number; sampleImage: ImageMetadata } => entry !== null,
	)
	.sort((a, b) => a.name.localeCompare(b.name));

const siteUrl = Astro.site?.origin ?? siteConfig.siteUrl ?? 'https://photos.jaydixit.com';
const canonicalUrl = new URL('/red-carpet/', siteUrl).toString();
const pageDescription = `Browse red carpet photos of ${personEntries.length} subjects photographed by ${siteConfig.owner}.`;

const portraitsStructuredData = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: `Red Carpet Photos — ${siteConfig.owner}`,
	description: pageDescription,
	url: canonicalUrl,
	hasPart: personEntries.map((person) => ({
		'@type': 'CollectionPage',
		name: person.name,
		url: new URL(`/red-carpet/${person.slug}`, siteUrl).toString(),
	})),
};
---

<MainLayout
	title="Red Carpet Photos"
	description={pageDescription}
	canonical={canonicalUrl}
	structuredData={portraitsStructuredData}
>
	<section class="rc-page">
		<div class="rc-shell">
			<header class="rc-header">
				<p class="rc-kicker">Portrait Archive</p>
				<h1 class="rc-title">Red Carpet Photos</h1>
				<p class="rc-standfirst">
					Subjects photographed at film festivals, Nobel ceremonies, and cultural events around the
					world.
				</p>
			</header>

			{
				personEntries.length > 0 ? (
					<div class="rc-grid">
						{personEntries.map((person) => (
							<a href={`/red-carpet/${person.slug}`} class="rc-card">
								<div class="rc-frame">
									<Image
										src={person.sampleImage}
										alt={person.name}
										width={480}
										height={640}
										fit="cover"
										position="attention"
										class="rc-img"
										loading="lazy"
									/>
								</div>
								<div class="rc-meta">
									<h3 class="rc-name">{person.name}</h3>
									{person.bio && <p class="rc-bio">{person.bio}</p>}
									<p class="rc-count">
										{person.photoCount} {person.photoCount === 1 ? 'photo' : 'photos'}
									</p>
								</div>
							</a>
						))}
					</div>
				) : (
					<div class="rc-empty">
						<h3>No portraits found</h3>
						<p>
							Add people to <code>src/data/people.json</code> to get started.
						</p>
					</div>
				)
			}
		</div>
	</section>
</MainLayout>

<style>
	.rc-page {
		background: var(--paper);
		padding: 8rem 0 5rem;
	}

	.rc-shell {
		max-width: 76rem;
		margin: 0 auto;
		padding: 0 2.5rem;
	}

	.rc-header {
		max-width: 42rem;
		margin: 0 auto 3.75rem;
		text-align: center;
	}

	.rc-kicker {
		margin: 0 0 1.4rem;
		font-family: var(--sans);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.32em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.rc-title {
		margin: 0;
		font-family: var(--serif);
		font-weight: 300;
		font-size: clamp(2.8rem, 6vw, 4.5rem);
		line-height: 1.02;
		letter-spacing: -0.015em;
		color: #161310;
	}

	.rc-standfirst {
		max-width: 34rem;
		margin: 1.6rem auto 0;
		font-family: var(--serif);
		font-weight: 300;
		font-style: italic;
		font-size: 1.2rem;
		line-height: 1.55;
		color: #565049;
	}

	.rc-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 2.25rem 1.75rem;
	}

	.rc-card {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.rc-frame {
		width: 100%;
		aspect-ratio: 3 / 4;
		overflow: hidden;
		background: #eceae3;
	}

	.rc-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	.rc-card:hover .rc-img {
		transform: scale(1.04);
	}

	.rc-meta {
		padding-top: 0.9rem;
		margin-top: 0.9rem;
		border-top: 1px solid var(--hairline);
	}

	.rc-name {
		margin: 0;
		font-family: var(--serif);
		font-weight: 400;
		font-size: 1.35rem;
		line-height: 1.1;
		letter-spacing: -0.01em;
		color: #161310;
		transition: color 0.2s ease;
	}

	.rc-card:hover .rc-name {
		color: var(--accent);
	}

	.rc-bio {
		margin: 0.4rem 0 0;
		font-family: var(--sans);
		font-size: 0.85rem;
		line-height: 1.4;
		color: #6e675c;
	}

	.rc-count {
		margin: 0.55rem 0 0;
		font-family: var(--sans);
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.rc-empty {
		text-align: center;
		padding: 4rem 1rem;
		font-family: var(--sans);
		color: var(--muted);
	}

	.rc-empty h3 {
		font-family: var(--serif);
		font-weight: 400;
		font-size: 1.5rem;
		color: var(--ink);
	}

	.rc-empty code {
		background: #efece4;
		padding: 0.15rem 0.4rem;
		border-radius: 2px;
		font-size: 0.85em;
	}

	@media (max-width: 1024px) {
		.rc-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	@media (max-width: 767px) {
		.rc-page {
			padding-top: 7rem;
		}

		.rc-shell {
			padding: 0 1.5rem;
		}

		.rc-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 1.75rem 1.25rem;
		}
	}

	@media (max-width: 440px) {
		.rc-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
