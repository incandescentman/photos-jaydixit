---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro:assets';
import MainLayout from '../../layouts/MainLayout.astro';
import PortfolioLightbox from '../../components/PortfolioLightbox.astro';
import AnneCarsonStory from '../../components/AnneCarsonStory.astro';
import AnneCarsonReuse from '../../components/AnneCarsonReuse.astro';
import FrancesHaugenStory from '../../components/FrancesHaugenStory.astro';
import siteConfig from '../../../site.config.mts';
import rawPeople from '../../data/people.json';
import publishedPortraits from '../../data/published-portraits.json';
import { cldUrl, cldSrcset } from '../../lib/cloudinary';
import { photoPublication } from '../../lib/photoPublication';
import { images as homepageImages } from '../../data/homepage-images.js';
import { embeddedAttribution, embeddedCreator } from '../../lib/embeddedAttribution';
import { buildCaptionAndTags, formatPhrase, type GalleryTagsFile } from '../../lib/galleryMetadata';
import { lightboxVariant } from '../../lib/image-variants';
import { ogImageFromAsset, photographer, photoImageObject } from '../../lib/seo';

interface Person {
	slug: string;
	name: string;
	match: string[];
	photoSlugs?: string[];
	featuredPhotoSlug?: string;
	indexExcludedPhotoSlugs?: string[];
	bio?: string;
	seoTitle?: string;
	seoDescription?: string;
	wikipedia?: string;
	commonsUrl?: string;
	articleUsageStatus?: 'lead' | 'formerly-lead' | 'unknown';
	sourceCredit?: string;
	license?: string;
	licenseUrl?: string;
}

const people = rawPeople as Person[];

const { person } = Astro.params;

const personData = people.find((p) => p.slug === person);
if (!personData) {
	return Astro.redirect('/404');
}

const galleryImageModules = import.meta.glob<{ default: ImageMetadata }>(
	'../../gallery/photos/**/*.{jpg,jpeg,png,webp,gif}',
	{ eager: true },
);

const highlightImageModules = import.meta.glob<{ default: ImageMetadata }>(
	'../../gallery/highlights/**/*.{jpg,jpeg,png,webp,gif}',
	{ eager: true },
);

const wikiportraitImageModules = import.meta.glob<{ default: ImageMetadata }>(
	'../../assets/images/wikiportraits/**/*.{jpg,jpeg,png,webp,gif}',
	{ eager: true },
);

const sequenceImageModules = import.meta.glob<{ default: ImageMetadata }>(
	'../../assets/issa-rae-sequence/issa-rae_tiff_2026_{04162,04163,04164,04165}.jpg',
	{ eager: true },
);

const tagModules = import.meta.glob<GalleryTagsFile>('../../gallery/photos/**/tags.json', {
	import: 'default',
	eager: true,
});

const tagsByFolder = Object.entries(tagModules).reduce<Record<string, GalleryTagsFile>>(
	(acc, [key, value]) => {
		const relativeFolder = key.replace('../../gallery/photos/', '').replace(/\/tags\.json$/, '');
		acc[relativeFolder] = value;
		return acc;
	},
	{},
);

const captionByFilename = new Map(homepageImages.map((image) => [image.filename, image.caption]));

function getSubjectSlug(filename: string): string {
	const baseName = filename.replace(/\.[^/.]+$/, '');
	return baseName.split('_')[0];
}

function normalizeMatchValue(value: string) {
	return value.trim().toLowerCase();
}

function matchesPerson(subjectSlug: string, photoSlug: string, person: Person): boolean {
	const normalizedSubjectSlug = normalizeMatchValue(subjectSlug);
	const normalizedPhotoSlug = normalizeMatchValue(photoSlug);
	const explicitPhotoSlugs = new Set((person.photoSlugs ?? []).map(normalizeMatchValue));

	if (explicitPhotoSlugs.has(normalizedPhotoSlug)) {
		return true;
	}

	return person.match.some((pattern) => {
		const normalizedPattern = normalizeMatchValue(pattern);
		if (normalizedSubjectSlug === normalizedPattern) return true;
		if (normalizedSubjectSlug.startsWith(normalizedPattern + '-')) {
			const suffix = normalizedSubjectSlug.slice(normalizedPattern.length + 1);
			return /^\d+$/.test(suffix);
		}
		return false;
	});
}

function toPhotoHref(folderSlug: string, file: string) {
	const slug = file.replace(/\.[^/.]+$/, '');
	const encodedPath = [...folderSlug.split('/'), slug].map(encodeURIComponent).join('/');
	return `/gallery/photo/${encodedPath}`;
}

const extensionPriority = ['jpg', 'jpeg', 'webp', 'png', 'gif'];
const sourcePriority = { gallery: 0, highlights: 1, wikiportraits: 2, sequence: 3 } as const;

function extensionRank(file: string) {
	const ext = file.split('.').pop()?.toLowerCase() ?? '';
	const rank = extensionPriority.indexOf(ext);
	return rank === -1 ? extensionPriority.length : rank;
}

type PhotoEntry = {
	metadata: ImageMetadata;
	filename: string;
	folder: string;
	slug: string;
	caption: string;
	galleryName: string;
	moduleKey: string;
	detailHref: string | null;
	source: keyof typeof sourcePriority;
};

function collectMatchingPhotos(
	modules: Record<string, { default: ImageMetadata }>,
	basePath: string,
	source: keyof typeof sourcePriority,
): PhotoEntry[] {
	return Object.entries(modules)
		.map(([key, module]) => {
			const metadata = module.default;
			const relativePath = key.replace(basePath, '');
			const segments = relativePath.split('/');
			const filename = segments.pop();
			if (!filename) return null;
			const folder = segments.join('/');
			const subjectSlug = getSubjectSlug(filename);
			const photoSlug = filename.replace(/\.[^/.]+$/, '');

			if (!matchesPerson(subjectSlug, photoSlug, personData)) return null;

			const slug = photoSlug;
			const galleryCaption =
				source === 'gallery'
					? buildCaptionAndTags(filename, folder, tagsByFolder[folder], personData.name).caption
					: undefined;
			const caption =
				(source === 'sequence'
					? 'Issa Rae at the Toronto International Film Festival world premiere of Babies in 2026.'
					: captionByFilename.get(filename)) ??
				galleryCaption ??
				buildCaptionAndTags(filename, folder, undefined, personData.name).caption;
			const galleryName =
				source === 'sequence'
					? 'Toronto International Film Festival'
					: source === 'highlights'
						? 'Highlights'
						: source === 'wikiportraits'
							? 'WikiPortraits'
							: folder
									.split('/')
									.map((part) => formatPhrase(part))
									.join(' / ');

			return {
				metadata,
				filename,
				folder,
				slug,
				caption,
				galleryName,
				moduleKey: key,
				detailHref: source === 'gallery' ? toPhotoHref(folder, filename) : null,
				source,
			};
		})
		.filter((entry): entry is PhotoEntry => entry !== null);
}

const allMatches: PhotoEntry[] = [
	...collectMatchingPhotos(galleryImageModules, '../../gallery/photos/', 'gallery'),
	...collectMatchingPhotos(highlightImageModules, '../../gallery/highlights/', 'highlights'),
	...collectMatchingPhotos(sequenceImageModules, '../../assets/issa-rae-sequence/', 'sequence'),
	...collectMatchingPhotos(
		wikiportraitImageModules,
		'../../assets/images/wikiportraits/',
		'wikiportraits',
	),
];

const grouped = allMatches.reduce<Record<string, PhotoEntry[]>>((acc, photo) => {
	const key = photo.slug;
	if (!acc[key]) acc[key] = [];
	acc[key].push(photo);
	return acc;
}, {});

const matchedPhotos = Object.values(grouped)
	.map(
		(variants) =>
			variants.slice().sort((a, b) => {
				const sourceDiff = sourcePriority[a.source] - sourcePriority[b.source];
				if (sourceDiff !== 0) return sourceDiff;
				return extensionRank(a.filename) - extensionRank(b.filename);
			})[0],
	)
	.sort((a, b) => a.filename.localeCompare(b.filename));

const localPhotos = await Promise.all(
	matchedPhotos.map(async (photo) => {
		const [thumbnail, lightbox, exhibitionAttribution, publication, creatorName] =
			await Promise.all([
				getImage({ src: photo.metadata, width: 160, format: 'webp' }),
				lightboxVariant(photo.metadata),
				embeddedAttribution({
					moduleKey: photo.moduleKey,
					pageFile: 'src/pages/red-carpet/[person].astro',
					caption: photo.caption,
					sourceDetailUrl: new URL(
						photo.detailHref ?? `/red-carpet/${personData.slug}`,
						siteConfig.siteUrl,
					).toString(),
				}),
				photoPublication(photo.moduleKey, 'src/pages/red-carpet/[person].astro'),
				embeddedCreator(photo.moduleKey, 'src/pages/red-carpet/[person].astro'),
			]);

		return {
			...photo,
			thumbnailSrc: thumbnail.src,
			lightboxSrc: lightbox.src,
			lightboxWidth: lightbox.width,
			lightboxHeight: lightbox.height,
			exhibitionAttribution,
			publication,
			creatorName,
			publicId: undefined,
			publishedOn: photo.source === 'sequence' ? '/#issa-rae-sequence' : undefined,
		};
	}),
);

// These four remote originals are already displayed on the public homepage/editorial page.
// Keep their existing Cloudinary sources; do not make new source-image copies.
const remotePhotos = publishedPortraits
	.filter((photo) => photo.personSlug === personData.slug)
	.map((photo) => ({
		...photo,
		metadata: undefined,
		folder: '',
		slug: photo.filename.replace(/\.[^/.]+$/, ''),
		galleryName: photo.publishedOn === '/' ? 'Highlights' : 'Toronto International Film Festival',
		detailHref: null,
		source: 'published' as const,
		thumbnailSrc: cldUrl(photo.publicId, 160),
		lightboxSrc: cldUrl(photo.publicId, Math.min(photo.width, 3000)),
		lightboxWidth: Math.min(photo.width, 3000),
		lightboxHeight: Math.round((photo.height * Math.min(photo.width, 3000)) / photo.width),
		exhibitionAttribution: undefined,
		publication: undefined,
		creatorName: undefined,
	}));
const photos = [...localPhotos, ...remotePhotos];
const featuredPhotoIndex = personData.featuredPhotoSlug
	? photos.findIndex(
			(photo) => photo.filename.replace(/\.[^/.]+$/, '') === personData.featuredPhotoSlug,
		)
	: -1;
const hasFeaturedPhoto = featuredPhotoIndex >= 0;
if (hasFeaturedPhoto) {
	photos.unshift(...photos.splice(featuredPhotoIndex, 1));
}

if (photos.length === 0) {
	return Astro.redirect('/404');
}

const siteUrl = Astro.site?.origin ?? siteConfig.siteUrl ?? 'https://photos.jaydixit.com';
const canonicalUrl = new URL(`/red-carpet/${personData.slug}`, siteUrl).toString();
const hasStory = personData.slug === 'anne-carson';
const hasPortraitEssay = personData.slug === 'frances-haugen';
const pageTitle = personData.seoTitle ?? `${personData.name} Photos`;
const pageDescription =
	personData.seoDescription ?? `Photographs of ${personData.name} by ${siteConfig.owner}.`;
// A complete social card (URL, size, and type), since the shared resolver cannot measure
// a resized copy before it is written.
const firstPhoto = photos[0];
const sharedCaption =
	photos.length > 1 && photos.every((photo) => photo.caption === firstPhoto.caption)
		? firstPhoto.caption
		: undefined;
const sharedGalleryName =
	sharedCaption && photos.every((photo) => photo.galleryName === firstPhoto.galleryName)
		? firstPhoto.galleryName
		: undefined;
const socialCard = firstPhoto.metadata
	? await ogImageFromAsset(firstPhoto.metadata, `Portrait of ${personData.name}`)
	: {
			url: cldUrl(firstPhoto.publicId, 1200).replace('f_auto', 'f_jpg'),
			width: 1200,
			height: Math.round((firstPhoto.lightboxHeight * 1200) / firstPhoto.lightboxWidth),
			type: 'image/jpeg',
			alt: firstPhoto.caption,
		};
const primaryImage = socialCard?.url;
const provenanceParts = [
	personData.articleUsageStatus === 'lead' ? 'Currently the lead photo on Wikipedia' : null,
	personData.sourceCredit ? `Photo by ${personData.sourceCredit}` : null,
].filter((part): part is string => Boolean(part));
const showProvenance =
	provenanceParts.length > 0 ||
	Boolean(personData.license && personData.licenseUrl) ||
	Boolean(personData.commonsUrl);

const breadcrumbs = [
	{ name: 'Home', url: '/' },
	{ name: 'Red Carpet Photos', url: '/red-carpet' },
	{ name: personData.name, url: `/red-carpet/${personData.slug}` },
];

const imageObjects = photos.map((photo) =>
	photoImageObject({
		src: photo.lightboxSrc,
		caption: photo.caption,
		width: photo.lightboxWidth,
		height: photo.lightboxHeight,
		thumbnail: photo.thumbnailSrc,
		pageUrl: photo.detailHref ?? canonicalUrl,
		creatorName: photo.creatorName,
		publication: photo.publication,
	}),
);
const personStructuredData = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: `${personData.name} — ${siteConfig.owner}`,
	description: pageDescription,
	url: canonicalUrl,
	about: {
		'@type': 'Person',
		name: personData.name,
		...(personData.wikipedia ? { sameAs: personData.wikipedia } : {}),
	},
	creator: photographer,
	image: imageObjects,
	primaryImageOfPage: imageObjects[0],
};

const breadcrumbStructuredData = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: breadcrumbs.map((crumb, index) => ({
		'@type': 'ListItem',
		position: index + 1,
		name: crumb.name,
		item: new URL(crumb.url, siteUrl).toString(),
	})),
};

export function getStaticPaths() {
	return (rawPeople as Person[]).map((p) => ({ params: { person: p.slug } }));
}
---

<MainLayout
	photoFooter
	useArnoPro={hasStory || hasFeaturedPhoto}
	title={pageTitle}
	description={pageDescription}
	canonical={canonicalUrl}
	image={primaryImage}
	ogImages={socialCard ? [socialCard] : undefined}
	imageAlt={`Portrait of ${personData.name}`}
	structuredData={[personStructuredData, breadcrumbStructuredData]}
>
	<section class="py-16 pt-(--nav-clearance)">
		<div
			class:list={[
				'container mx-auto px-4 max-w-7xl',
				{
					'person-feature': hasStory,
					'person-portrait-feature': hasFeaturedPhoto,
					'person-portrait-essay': hasPortraitEssay,
				},
			]}
		>
			<nav aria-label="Breadcrumb" class="mb-6">
				<ol class="flex flex-wrap items-center gap-2 text-sm text-gray-500">
					{
						breadcrumbs.map((crumb, index) => (
							<li class="inline-flex items-center gap-2">
								{index > 0 && <span aria-hidden="true">/</span>}
								{index === breadcrumbs.length - 1 ? (
									<span class="text-gray-700">{crumb.name}</span>
								) : (
									<a href={crumb.url} class="hover:text-gray-900 hover:underline">
										{crumb.name}
									</a>
								)}
							</li>
						))
					}
				</ol>
			</nav>

			<div class="person-introduction">
				<header class="mb-10 text-center">
					<h1 class="text-4xl md:text-5xl font-bold mb-3">{personData.name}</h1>
					{
						hasPortraitEssay && (
							<p class="person-story-deck">
								<em>
									Facebook whistleblower | International Journalism Festival, Perugia, Italy | April
									19, 2024
								</em>
							</p>
						)
					}
					{
						personData.bio && (
							<p class="text-xl text-gray-600 max-w-xl mx-auto mb-3">{personData.bio}</p>
						)
					}
					{
						!hasStory && !hasFeaturedPhoto && (
							<p class="text-gray-500 text-base">
								{photos.length}
								{photos.length === 1 ? 'photo' : 'photos'}
							</p>
						)
					}
					{
						personData.wikipedia && !hasPortraitEssay && (
							<a
								href={personData.wikipedia}
								target="_blank"
								rel="noopener noreferrer"
								class="editorial-link inline-block mt-2"
							>
								Wikipedia &rarr;
							</a>
						)
					}
					{
						showProvenance && (
							<p class="photo-credit mt-4">
								{provenanceParts.join(' · ')}
								{personData.license && personData.licenseUrl && (
									<>
										{provenanceParts.length > 0 && <span aria-hidden="true"> · </span>}
										<a
											href={personData.licenseUrl}
											target="_blank"
											rel="noopener noreferrer"
											class="editorial-link"
										>
											{personData.license}
										</a>
									</>
								)}
								{personData.commonsUrl && (
									<>
										{(provenanceParts.length > 0 ||
											Boolean(personData.license && personData.licenseUrl)) && (
											<span aria-hidden="true"> · </span>
										)}
										<a
											href={personData.commonsUrl}
											target="_blank"
											rel="noopener noreferrer"
											class="editorial-link"
										>
											View on Wikimedia Commons
										</a>
									</>
								)}
							</p>
						)
					}
				</header>

				{
					sharedCaption && !hasPortraitEssay && (
						<div class="mb-8 text-center" data-person-shared-caption>
							<p class="text-base font-medium text-gray-800">{sharedCaption}</p>
							{sharedGalleryName && !hasFeaturedPhoto && (
								<p class="photo-credit mt-1">{sharedGalleryName}</p>
							)}
						</div>
					)
				}
			</div>

			{
				hasPortraitEssay && (
					<article class="person-essay" aria-label="Photographing Frances Haugen">
						<FrancesHaugenStory />
					</article>
				)
			}

			<div class:list={{ 'person-story-layout': hasStory }} data-person-photo-gallery>
				<div
					class:list={[
						'grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6',
						{ 'person-story-photos': hasStory },
					]}
				>
					{
						photos.map((photo, index) => (
							<div
								class:list={[
									'group block',
									{
										'person-portrait-photo': hasFeaturedPhoto,
										'person-portrait-lead': hasFeaturedPhoto && index === 0,
									},
								]}
							>
								<a
									href={photo.lightboxSrc}
									class="block"
									data-pswp-item="true"
									data-exhibition-thumb={photo.thumbnailSrc}
									data-full-src={photo.lightboxSrc}
									data-pswp-width={photo.lightboxWidth}
									data-pswp-height={photo.lightboxHeight}
									data-pswp-caption={photo.caption}
									data-exhibition-details={photo.detailHref ?? undefined}
									data-exhibition-person={canonicalUrl}
									data-exhibition-person-label={personData.name}
									data-exhibition-gallery={
										photo.source === 'gallery' && photo.folder
											? `/gallery/${photo.folder}`
											: undefined
									}
									data-exhibition-attribution={photo.exhibitionAttribution}
									data-exhibition-story={photo.publishedOn}
									data-exhibition-story-label="View original placement"
									data-exhibition-commons={photo.publication?.commonsUrl}
									data-exhibition-license={photo.publication?.license}
									data-exhibition-license-url={photo.publication?.licenseUrl}
									data-exhibition-download={photo.publication?.downloadUrl}
									aria-label={`${photo.caption} — view full size`}
								>
									<div
										class:list={
											hasStory || hasFeaturedPhoto
												? 'person-feature-image'
												: 'aspect-[3/4] overflow-hidden rounded-xl bg-gray-100 shadow-sm'
										}
									>
										{(hasStory || hasFeaturedPhoto) && photo.metadata ? (
											<Image
												src={photo.metadata}
												alt={photo.caption}
												width={1600}
												widths={[480, 720, 960, 1280, 1600, 2400]}
												sizes={
													hasFeaturedPhoto
														? index === 0
															? hasPortraitEssay
																? '(min-width: 1680px) 788px, (min-width: 1000px) 47vw, calc(100vw - 48px)'
																: '(min-width: 1560px) 853px, (min-width: 1000px) 55vw, calc(100vw - 48px)'
															: hasPortraitEssay
																? '(min-width: 1680px) 382px, (min-width: 1000px) 23vw, (min-width: 601px) 46vw, calc(100vw - 48px)'
																: '(min-width: 1560px) 352px, (min-width: 1000px) 23vw, (min-width: 601px) 46vw, calc(100vw - 48px)'
														: '(min-width: 1680px) 780px, (min-width: 1000px) 47vw, calc(100vw - 48px)'
												}
												loading={index === 0 ? 'eager' : 'lazy'}
												fetchpriority={index === 0 ? 'high' : 'auto'}
											/>
										) : photo.metadata ? (
											<Image
												src={photo.metadata}
												alt={photo.caption}
												width={480}
												height={640}
												fit="cover"
												position="attention"
												loading="lazy"
												class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
											/>
										) : (
											<img
												src={cldUrl(photo.publicId, 960)}
												srcset={cldSrcset(photo.publicId, [480, 720, 960, 1440])}
												sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
												width={480}
												height={640}
												alt={photo.caption}
												loading="lazy"
												class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
											/>
										)}
									</div>
								</a>
								<div class="mt-3 px-1">
									{hasPortraitEssay && index === 0 && sharedCaption && (
										<p class="person-lead-caption" data-person-shared-caption>
											{sharedCaption}
										</p>
									)}
									{hasPortraitEssay && index === 0 && (
										<p class="photo-credit mt-1">
											Photo by{' '}
											<a class="editorial-link" href="https://jaydixit.com/about">
												{siteConfig.owner}
											</a>
										</p>
									)}
									{!sharedCaption && (
										<p class="text-base font-medium text-gray-800 group-hover:text-gray-900">
											{photo.caption}
										</p>
									)}
									{!sharedGalleryName && <p class="photo-credit mt-0.5">{photo.galleryName}</p>}
									{hasStory && <AnneCarsonReuse />}
									{photo.detailHref && (
										<a href={photo.detailHref} class="editorial-link mt-2 inline-block text-sm">
											Details
										</a>
									)}
								</div>
							</div>
						))
					}
				</div>
				{hasStory && <AnneCarsonStory />}
			</div>
		</div>
	</section>

	<PortfolioLightbox
		gallerySelector="[data-person-photo-gallery]"
		childrenSelector="a[data-pswp-item]"
		options={{ escKey: true, tapAction: 'toggle-controls' }}
	/>
</MainLayout>

<style>
	.person-feature {
		width: 100%;
		max-width: 1680px;
		padding-inline: 2.5rem;
	}
	.person-feature h1 {
		font-family: var(--serif);
		font-weight: 300;
		font-size: clamp(3rem, 6vw, 5rem);
		line-height: 1.05;
	}
	.person-story-layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: clamp(2rem, 4vw, 5rem);
		align-items: start;
	}
	.person-story-photos {
		grid-template-columns: minmax(0, 1fr);
	}
	.person-feature-image img {
		display: block;
		width: 100%;
		height: auto;
	}
	.person-portrait-feature {
		width: 100%;
		max-width: 1560px;
		padding-inline: 2.5rem;
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
