---
export const prerender = true;

import { getImage } from 'astro:assets';
import MainLayout from '../layouts/MainLayout.astro';
import NobelPhoto from '../components/NobelPhoto.astro';
import PhotoSwipeLightbox from '../components/PhotoSwipeLightbox.astro';

import peaceCampaigners from '../gallery/photos/events/nobel-prizes-2024/anti-nuclear-campaigners_nobel-peace-prize-torchlight-procession-oslo_2024.jpg';
import daronAcemoglu from '../gallery/photos/events/nobel-prizes-2024/daron-acemoglu_nobel-lectures-stockholm_2024.jpg';
import davidBaker from '../gallery/photos/events/nobel-prizes-2024/david-baker_nobel-lectures-stockholm_2024.jpg';
import demisHassabis from '../gallery/photos/events/nobel-prizes-2024/demis-hassabis_nobel-lectures-stockholm_2024.jpg';
import demisHassabisChemistry from '../gallery/photos/events/nobel-prizes-2024/demis-hassabis-2_nobel-lectures-stockholm_2024.jpg';
import geoffreyHinton from '../gallery/photos/events/nobel-prizes-2024/geoffrey-hinton_nobel-lectures-stockholm_2024.jpg';
import jamesRobinson from '../gallery/photos/events/nobel-prizes-2024/james-robinson_nobel-lectures-stockholm_2024.jpg';
import johnHopfield from '../gallery/photos/events/nobel-prizes-2024/john-hopfield_nobel-lectures-stockholm_2024.jpg';
import johnJumper from '../gallery/photos/events/nobel-prizes-2024/john-jumper_nobel-lectures-stockholm_2024.jpg';
import peacePrizePresentation from '../gallery/photos/events/nobel-prizes-2024/nobel-peace-prize-ceremony-award-presentation-oslo_2024.jpg';
import oslo04 from '../gallery/photos/events/nobel-prizes-2024/nobel-peace-prize-torchlight-procession-oslo-04_2024.jpg';
import oslo06 from '../gallery/photos/events/nobel-prizes-2024/nobel-peace-prize-torchlight-procession-oslo-06_2024.jpg';
import oslo15 from '../gallery/photos/events/nobel-prizes-2024/nobel-peace-prize-torchlight-procession-oslo-15_2024.jpg';
import oslo21 from '../gallery/photos/events/nobel-prizes-2024/nobel-peace-prize-torchlight-procession-oslo-21_2024.jpg';
import osloCrowd from '../gallery/photos/events/nobel-prizes-2024/nobel-peace-prize-torchlight-procession-oslo-crowd_2024.jpg';
import stockholmPhotographer from '../gallery/photos/events/nobel-prizes-2024/photographer-in-stockholm_nobel-lectures_2024.jpg';
import simonJohnson from '../gallery/photos/events/nobel-prizes-2024/simon-johnson_nobel-lectures-stockholm_2024.jpg';

const pageTitle = 'The Year AI Won the Nobel Prize';
const description =
	'Jay Dixit photographs the 2024 Nobel Lectures in Stockholm and the Nobel Peace Prize Torchlight Procession in Oslo.';

const photographs = [
	{
		id: 'baker',
		src: davidBaker,
		alt: 'David Baker speaking at the 2024 Nobel Lectures in Stockholm',
		caption: 'David Baker · Nobel Lectures, Stockholm',
		commons: undefined,
	},
	{
		id: 'hopfield',
		src: johnHopfield,
		alt: 'John Hopfield speaking at the 2024 Nobel Lectures in Stockholm',
		caption: 'John Hopfield · Nobel Lectures, Stockholm',
		commons:
			'https://commons.wikimedia.org/wiki/File:John_Hopfield_at_the_2024_Nobel_Lectures_5.jpg',
	},
	{
		id: 'hinton',
		src: geoffreyHinton,
		alt: 'Geoffrey Hinton speaking at the 2024 Nobel Lectures in Stockholm',
		caption: 'Geoffrey Hinton · Nobel Lectures, Stockholm',
		commons:
			'https://commons.wikimedia.org/wiki/File:Geoffrey_Hinton_at_the_2024_Nobel_Lectures_3.jpg',
	},
	{
		id: 'hassabis',
		src: demisHassabis,
		alt: 'Demis Hassabis speaking at the 2024 Nobel Lectures in Stockholm',
		caption: 'Demis Hassabis · Nobel Lectures, Stockholm',
		commons: undefined,
	},
	{
		id: 'hassabis-chemistry',
		src: demisHassabisChemistry,
		alt: 'Demis Hassabis at the 2024 Nobel Lectures in Stockholm',
		caption: 'Demis Hassabis · Nobel Lectures, Stockholm',
		commons: undefined,
	},
	{
		id: 'jumper',
		src: johnJumper,
		alt: 'John Jumper speaking at the 2024 Nobel Lectures in Stockholm',
		caption: 'John Jumper · Nobel Lectures, Stockholm',
		commons:
			'https://commons.wikimedia.org/wiki/File:John_M._Jumper_presenting_his_Nobel_Lecture_at_the_2024_Nobel_Prizes.jpg',
	},
	{
		id: 'robinson',
		src: jamesRobinson,
		alt: 'James A. Robinson speaking at the 2024 Nobel Lectures in Stockholm',
		caption: 'James A. Robinson · Nobel Lectures, Stockholm',
		commons:
			'https://commons.wikimedia.org/wiki/File:James_A._Robinson_at_the_2024_Nobel_Lectures_2.jpg',
	},
	{
		id: 'acemoglu',
		src: daronAcemoglu,
		alt: 'Daron Acemoglu speaking at the 2024 Nobel Lectures in Stockholm',
		caption: 'Daron Acemoglu · Nobel Lectures, Stockholm',
		commons: undefined,
	},
	{
		id: 'johnson',
		src: simonJohnson,
		alt: 'Simon Johnson speaking at the 2024 Nobel Lectures in Stockholm',
		caption: 'Simon Johnson · Nobel Lectures, Stockholm',
		commons: undefined,
	},
	{
		id: 'stockholm-photographer',
		src: stockholmPhotographer,
		alt: 'A photographer beneath illuminated arches in Stockholm',
		caption: 'Photograph by John Sears · Stockholm',
		commons: undefined,
	},
	{
		id: 'peace-prize-presentation',
		src: peacePrizePresentation,
		alt: 'Jørgen Watne Frydnes presenting the 2024 Nobel Peace Prize to representatives of Nihon Hidankyo',
		caption:
			'Jørgen Watne Frydnes presents the Nobel Peace Prize to Terumi Tanaka, Shigemitsu Tanaka, and Toshiyuki Mimaki · Oslo City Hall',
		commons:
			'https://commons.wikimedia.org/wiki/File:J%C3%B8rgen_Watne_Frydnes_awarding_Terumi_Tanaka,_Shigemitsu_Tanaka,_and_Toshiyuki_Mimaki_at_2024_Nobel_Peace_Prize_Ceremony_4_(cropped).jpg',
	},
	{
		id: 'peace-campaigners',
		src: peaceCampaigners,
		alt: 'Anti-nuclear campaigners at the 2024 Nobel Peace Prize Torchlight Procession in Oslo',
		caption: 'Anti-nuclear campaigners · Torchlight Procession, Oslo',
		commons:
			'https://commons.wikimedia.org/wiki/File:Nei_til_atomv%C3%A5pen_at_the_Nobel_Peace_Prize_torchlight_procession_in_Oslo,_Norway_3.jpg',
	},
	{
		id: 'oslo-crowd',
		src: osloCrowd,
		alt: 'A torch-bearing crowd at the 2024 Nobel Peace Prize Torchlight Procession in Oslo',
		caption: 'Nobel Peace Prize Torchlight Procession · Oslo',
		commons: undefined,
	},
	...[
		{ id: 'oslo-04', src: oslo04, number: '4' },
		{ id: 'oslo-06', src: oslo06, number: '6' },
		{ id: 'oslo-15', src: oslo15, number: '15' },
	].map(({ id, src, number }) => ({
		id,
		src,
		alt: 'The 2024 Nobel Peace Prize Torchlight Procession in Oslo',
		caption: 'Nobel Peace Prize Torchlight Procession · Oslo',
		commons: `https://commons.wikimedia.org/wiki/File:The_Nobel_Peace_Prize_torchlight_procession_in_Oslo,_Norway_${number}.jpg`,
	})),
	{
		id: 'oslo-21',
		src: oslo21,
		alt: 'The 2024 Nobel Peace Prize Torchlight Procession in Oslo',
		caption: 'Nobel Peace Prize Torchlight Procession · Oslo',
		commons: undefined,
	},
];

const lightboxImages = await Promise.all(
	photographs.map(async (photo) => ({
		...photo,
		full: await getImage({ src: photo.src, width: 2600, quality: 90, format: 'webp' }),
	})),
);

const photo = (id: string) => {
	const match = lightboxImages.find((candidate) => candidate.id === id);
	if (!match) throw new Error(`Missing Nobel photograph: ${id}`);
	return match;
};

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'ImageGallery',
	name: pageTitle,
	description,
	creator: { '@type': 'Person', name: 'Jay Dixit' },
	dateCreated: '2024-12',
	associatedMedia: photographs.map((image) => ({
		'@type': 'ImageObject',
		name: image.caption,
		caption: image.caption,
		creditText: 'Photograph by Jay Dixit',
		license: 'https://creativecommons.org/licenses/by-sa/4.0/',
		...(image.commons ? { contentUrl: image.commons } : {}),
	})),
};
---

<MainLayout
	title={pageTitle}
	{description}
	image={photo('hassabis').full.src}
	imageAlt="Demis Hassabis at the 2024 Nobel Lectures in Stockholm"
	keywords={[
		'2024 Nobel Prize photographs',
		'Nobel Lectures Stockholm',
		'Nobel Peace Prize Oslo',
		'John Hopfield',
		'Geoffrey Hinton',
		'David Baker',
		'Demis Hassabis',
	]}
	{structuredData}
>
	<main class="nobel-page">
		<header class="nobel-hero">
			<div class="hero-copy">
				<p class="eyebrow">Stockholm + Oslo · December 2024</p>
				<h1>The year AI won the Nobel Prize.</h1>
				<div class="standfirst">
					<p>
						In 2024, two Nobel committees, in two different fields, awarded prizes for work in AI.
						The Physics prize went to Geoffrey Hinton and John Hopfield, whose foundational
						discoveries in artificial neural networks made modern machine learning possible.
					</p>
					<p>
						The Chemistry prize went to David Baker, Demis Hassabis, and John Jumper, for using
						computation and AI to predict and design proteins, the molecular machinery of life.
						Baker pioneered computational protein design; Hassabis and Jumper developed AlphaFold2,
						which predicts a protein’s three-dimensional structure from its amino-acid sequence.
					</p>
					<p>
						I photographed all five of them at the Nobel Lectures in Stockholm, then flew to Oslo
						for the Nobel Peace Prize.
					</p>
				</div>
			</div>
			<NobelPhoto photo={photo('hassabis')} eager className="hero-photo" />
		</header>

		<section class="prose-section intro-section" aria-labelledby="lectures-title">
			<p class="section-number">1 · The lectures</p>
			<h2 id="lectures-title">Photographing The Nobel Lectures in Stockholm</h2>
			<p>
				The Nobel Prizes consist of a few different events: the ceremony, the Nobel Lectures, and
				the press conference. In Stockholm, I covered the Nobel Lectures, where each laureate gets
				an hour on stage to present their life’s work.
			</p>
			<NobelPhoto photo={photo('stockholm-photographer')} className="intro-photo" />
		</section>

		<section class="story-section" aria-labelledby="physics-title">
			<div class="section-heading">
				<p class="section-number">2 · Physics</p>
				<h2 id="physics-title">John Hopfield and Geoffrey Hinton</h2>
				<div class="section-copy">
					<p>
						John Hopfield’s work on associative neural networks was published in 1982. By the time I
						photographed him at the Nobels, he was 91 years old.
					</p>
					<p>
						He used two canes to walk across the stage, but set them down when he reached the
						microphone. He leaned on the podium with one hand, using his free hand to gesture as he
						spoke animatedly for an hour about his life’s work. It made me sad they waited 42 years
						to recognize his contributions.
					</p>
					<p>
						He was a delightful speaker. I never got a good shot of Hinton, though. In an hour of
						lecturing, he didn't look up from his notes once.
					</p>
				</div>
			</div>
			<div class="photo-pair">
				<NobelPhoto photo={photo('hopfield')} />
				<NobelPhoto photo={photo('hinton')} />
			</div>
		</section>

		<section class="story-section" aria-labelledby="chemistry-title">
			<div class="section-heading">
				<p class="section-number">3 · Chemistry</p>
				<h2 id="chemistry-title">David Baker, Demis Hassabis, and John Jumper</h2>
			</div>
			<div class="chemistry-grid">
				<NobelPhoto photo={photo('baker')} className="chemistry-baker" />
				<NobelPhoto photo={photo('hassabis-chemistry')} className="chemistry-hassabis" />
				<NobelPhoto photo={photo('jumper')} className="chemistry-portrait" />
			</div>
		</section>

		<section class="story-section" aria-labelledby="economics-title">
			<div class="section-heading">
				<p class="section-number">4 · Economic sciences</p>
				<h2 id="economics-title">The Nobel Prize in Economics</h2>
			</div>
			<div class="economics-grid">
				<NobelPhoto photo={photo('robinson')} />
				<NobelPhoto photo={photo('johnson')} />
				<NobelPhoto photo={photo('acemoglu')} />
			</div>
		</section>

		<section class="oslo-section" aria-labelledby="oslo-title">
			<div class="section-heading section-heading--light">
				<p class="section-number">5 · Oslo</p>
				<h2 id="oslo-title">The Nobel Peace Prize in Oslo</h2>
				<p>
					In Oslo, I was credentialed for the Nobel Peace Prize ceremony at City Hall. The 2024
					prize went to Nihon Hidankyo, represented by its three co-chairs. That evening, I
					photographed the annual Torchlight Procession from the Nobel Peace Center to the Grand
					Hotel.
				</p>
			</div>
			<div class="oslo-subsection oslo-ceremony">
				<h3>The ceremony</h3>
				<NobelPhoto photo={photo('peace-prize-presentation')} />
			</div>
			<div class="oslo-subsection">
				<h3>The Torchlight Procession</h3>
				<div class="oslo-grid">
					<NobelPhoto photo={photo('peace-campaigners')} />
					<NobelPhoto photo={photo('oslo-04')} />
					<NobelPhoto photo={photo('oslo-06')} />
					<NobelPhoto photo={photo('oslo-15')} />
					<NobelPhoto photo={photo('oslo-21')} />
					<NobelPhoto photo={photo('oslo-crowd')} />
				</div>
			</div>
		</section>

		<footer class="nobel-contact">
			<h2>Red carpet and portrait photography</h2>
			<a href="/contact">Get in touch <span aria-hidden="true">→</span></a>
		</footer>
	</main>

	<PhotoSwipeLightbox gallerySelector=".nobel-page" childrenSelector="a[data-nobel-photo]" />
</MainLayout>

<style>
	:global(body) {
		background: #f1ece2;
		color: #171513;
	}

	.nobel-page {
		--paper: #f1ece2;
		--ink: #171513;
		--muted: #6f685f;
		--rule: rgba(23, 21, 19, 0.18);
		background: var(--paper);
	}

	.nobel-hero {
		display: grid;
		grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
		min-height: 100svh;
		padding: clamp(9rem, 13vw, 13rem) clamp(2rem, 6vw, 7rem) clamp(4rem, 7vw, 7rem);
		gap: clamp(3rem, 7vw, 8rem);
		align-items: center;
	}

	.hero-copy {
		max-width: 43rem;
	}

	.eyebrow,
	.section-number,
	.nobel-contact > p {
		margin: 0 0 1.4rem;
		font-family: var(--font-sans, system-ui, sans-serif);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.22em;
		text-transform: uppercase;
	}

	h1,
	h2 {
		margin: 0;
		font-family: var(--serif, Georgia, serif);
		font-weight: 300;
		letter-spacing: -0.045em;
	}

	h1 {
		max-width: 10ch;
		font-size: clamp(4rem, 7vw, 8.8rem);
		line-height: 0.88;
	}

	.standfirst,
	.section-heading > p:not(.section-number),
	.section-copy,
	.prose-section > p:not(.section-number) {
		font-family: var(--serif, Georgia, serif);
		font-size: clamp(1.25rem, 1.75vw, 1.75rem);
		font-weight: 300;
		line-height: 1.55;
	}

	.standfirst {
		max-width: 39rem;
		margin: 2.5rem 0 0;
		color: var(--muted);
	}

	.standfirst p {
		margin: 0 0 1.25em;
	}

	.standfirst p:last-child {
		margin-bottom: 0;
	}

	:global(.nobel-photo) {
		min-width: 0;
		margin: 0;
	}

	:global(.nobel-photo > a) {
		display: block;
		overflow: hidden;
		background: #d7d0c4;
	}

	:global(.nobel-photo img) {
		display: block;
		width: 100%;
		height: auto;
		transition: transform 500ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
	}

	:global(.nobel-photo > a:hover img) {
		transform: scale(1.012);
	}

	:global(.nobel-photo figcaption) {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding-top: 0.8rem;
		border-top: 1px solid var(--rule);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		line-height: 1.5;
		text-transform: uppercase;
	}

	:global(.nobel-photo figcaption a),
	.nobel-contact a {
		color: inherit;
		text-decoration: none;
	}

	.prose-section,
	.story-section {
		padding: clamp(5rem, 10vw, 10rem) clamp(2rem, 9vw, 11rem);
	}

	.prose-section {
		display: grid;
		grid-template-columns: minmax(12rem, 0.55fr) minmax(0, 1fr);
		column-gap: clamp(3rem, 8vw, 10rem);
		border-top: 1px solid var(--rule);
	}

	.prose-section .section-number {
		grid-row: span 2;
	}

	.prose-section h2,
	.section-heading h2,
	.nobel-contact h2 {
		font-size: clamp(3.2rem, 6vw, 7rem);
		line-height: 0.94;
	}

	.prose-section > p:last-child {
		max-width: 52rem;
		margin: 2.5rem 0 0;
	}

	:global(.intro-photo) {
		grid-column: 1 / -1;
		margin-top: clamp(3rem, 6vw, 6rem);
	}

	.story-section {
		border-top: 1px solid var(--rule);
	}

	.section-heading {
		display: grid;
		grid-template-columns: minmax(10rem, 0.32fr) minmax(0, 0.78fr) minmax(18rem, 0.55fr);
		gap: clamp(2rem, 5vw, 6rem);
		margin-bottom: clamp(4rem, 7vw, 8rem);
		align-items: start;
	}

	.section-heading > p:last-child {
		margin: 0;
		color: var(--muted);
	}

	.section-copy {
		color: var(--muted);
	}

	.section-copy p {
		margin: 0 0 1.4em;
	}

	.section-copy p:last-child {
		margin-bottom: 0;
	}

	.photo-pair {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(1rem, 3vw, 3rem);
		align-items: start;
	}

	.photo-trio {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(1rem, 2vw, 2rem);
		align-items: start;
	}

	.chemistry-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
		grid-template-areas:
			'baker portrait'
			'hassabis portrait';
		gap: clamp(1rem, 3vw, 3rem);
		align-items: start;
	}

	.chemistry-grid :global(.chemistry-portrait) {
		grid-area: portrait;
	}

	.chemistry-grid :global(.chemistry-baker) {
		grid-area: baker;
	}

	.chemistry-grid :global(.chemistry-hassabis) {
		grid-area: hassabis;
	}

	.economics-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(2rem, 5vw, 6rem) clamp(1rem, 3vw, 3rem);
		align-items: start;
	}

	.economics-grid :global(.nobel-photo:last-child) {
		grid-column: 1 / -1;
	}

	.photo-single-wrap {
		display: flex;
		justify-content: center;
	}

	:global(.photo-single) {
		width: min(100%, 70rem);
	}

	.oslo-section {
		padding: clamp(6rem, 11vw, 12rem) clamp(2rem, 6vw, 7rem);
		background: #171513;
		color: #f1ece2;
	}

	.section-heading--light > p:last-child {
		color: #b9b0a5;
	}

	.oslo-subsection + .oslo-subsection {
		margin-top: clamp(5rem, 9vw, 10rem);
	}

	.oslo-subsection h3 {
		margin: 0 0 clamp(2rem, 4vw, 4rem);
		font-family: var(--serif, Georgia, serif);
		font-size: clamp(2.4rem, 5vw, 5.5rem);
		font-weight: 300;
		letter-spacing: -0.04em;
		line-height: 0.96;
	}

	.oslo-ceremony :global(.nobel-photo) {
		width: min(100%, 70rem);
		margin: 0 auto;
	}

	.oslo-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(2.5rem, 5vw, 6rem) clamp(1rem, 2vw, 2rem);
	}

	.oslo-grid :global(.nobel-photo figcaption) {
		border-color: rgba(241, 236, 226, 0.25);
	}

	.nobel-contact a {
		border-bottom: 1px solid currentColor;
		font-weight: 700;
		line-height: 1.8;
	}

	.nobel-contact {
		padding: clamp(6rem, 12vw, 12rem) clamp(2rem, 9vw, 11rem);
		background: #b93226;
		color: #fff8ed;
	}

	.nobel-contact h2 {
		margin-bottom: 3rem;
	}

	.nobel-contact a {
		font-size: 1.1rem;
	}

	@media (max-width: 900px) {
		.nobel-hero,
		.prose-section,
		.section-heading {
			grid-template-columns: 1fr;
		}

		.nobel-hero {
			min-height: auto;
		}

		.hero-copy {
			max-width: 48rem;
		}

		.prose-section .section-number {
			grid-row: auto;
			grid-column: auto;
		}

		.section-heading {
			gap: 1.5rem;
		}

		.section-heading > p:last-child,
		.section-copy {
			max-width: 42rem;
		}

		.photo-trio {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 680px) {
		.nobel-hero {
			padding: 7.5rem 1rem 4rem;
			gap: 3rem;
		}

		h1 {
			font-size: clamp(3.6rem, 18vw, 5.6rem);
		}

		.prose-section,
		.story-section,
		.oslo-section,
		.nobel-contact {
			padding-right: 1rem;
			padding-left: 1rem;
		}

		.photo-pair,
		.photo-trio,
		.chemistry-grid,
		.economics-grid,
		.oslo-grid {
			grid-template-columns: 1fr;
		}

		.chemistry-grid {
			grid-template-areas: none;
		}

