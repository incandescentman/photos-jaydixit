---
export const prerender = true;

import MainLayout from '../layouts/MainLayout.astro';
import PhotoSwipeLightbox from '../components/PortfolioLightbox.astro';
import siteConfig from '../../site.config.mts';
import data from '../data/wikipedia-portraits.json';

// Generated by scripts/wikipedia-portraits.js from Wikimedia Commons usage data,
// plus Jay's own record of photos that used to appear (src/data/wikipedia-portraits-manual.json).
interface WikipediaPortrait {
	name: string;
	sortName: string;
	slug: string | null;
	article: { url: string; language: string };
	languages: string[];
	photo: {
		file: string;
		commonsUrl: string;
		thumb: string;
		thumbWidth: number;
		thumbHeight: number;
		srcset: string;
		full: string;
		fullWidth: number;
		fullHeight: number;
	};
	position?: string;
}

// The biggest names lead, by fame (Jay, 2026-11-16: "you can choose the biggest names by fame
// yourself"); everyone else follows alphabetically. Ratings don't lift a photo, but a photo Jay
// rated fine goes below every photo he rated great (Jay: "a fine photo should go below every
// great photo"). Names must match the data.
const leadOrder = [
	'Anne Hathaway',
	'Sydney Sweeney',
	'Ana de Armas',
	'Seth Rogen',
	'Ron Howard',
	'Anna Kendrick',
	"Conan O'Brien",
	'Paul Mescal',
	'Alexander Skarsgård',
	'John Leguizamo',
	'J. K. Simmons',
	'Sebastian Stan',
	'Bong Joon Ho',
	'Issa Rae',
	'Vanessa Kirby',
	'Jeremy Strong',
	'Margaret Qualley',
	'Geoffrey Hinton',
	'Judd Apatow',
	'Laverne Cox',
	'Marques Brownlee',
	'Jessie Buckley',
	'Daniel Brühl',
	'Dave Franco',
	'Ed Helms',
	'Kaia Gerber',
	'Michael Cohen',
	'Frank Oz',
	'Demis Hassabis',
	'Pamela Adlon',
	'Nick Kroll',
	'Bobby Cannavale',
	'Maria Ressa',
	'Alex Garland',
	'Paul Schrader',
	'Ray Kurzweil',
	'Lilly Singh',
	'Sophia Bush',
	'Rachel Sennott',
	'Maria Bakalova',
	'Nicholas Braun',
	'Andrew Rannells',
	'Stephen Root',
	'Frances Haugen',
	'Art Spiegelman',
];
const leadRank = new Map(leadOrder.map((name, i) => [name, i]));
const missingLead = leadOrder.filter((name) => !data.people.some((p) => p.name === name));
if (missingLead.length) console.warn(`wikipedia.astro: lead names not in the data: ${missingLead.join(', ')}`);

const quality = (p: WikipediaPortrait) => (p as WikipediaPortrait & { quality?: string }).quality ?? 'unreviewed';
const byFame = (data.people as WikipediaPortrait[]).slice().sort((a, b) => {
	const ra = leadRank.get(a.name) ?? Infinity;
	const rb = leadRank.get(b.name) ?? Infinity;
	return ra !== rb ? ra - rb : a.sortName.localeCompare(b.sortName);
});
const lastGreat = byFame.map(quality).lastIndexOf('great');
const fineAboveGreat = byFame.filter((p, i) => quality(p) === 'fine' && i < lastGreat);
const people = byFame.filter((p) => !fineAboveGreat.includes(p));
people.splice(people.indexOf(byFame[lastGreat]) + 1, 0, ...fineAboveGreat);

// Jay's intro line (2026-11-16); the numbers come from the data so a refresh keeps them true.
const fmt = (n: number) => n.toLocaleString('en-US');
const languagesFor = (name: string) =>
	(data.people as (WikipediaPortrait & { languageCount: number })[]).find((p) => p.name === name)
		?.languageCount ?? 0;
const intro = {
	articles: fmt(data.sources.wikipediaArticlesUsingPhotos),
	languages: fmt(data.sources.wikipediaLanguages),
	sweeney: languagesFor('Sydney Sweeney'),
	mescal: languagesFor('Paul Mescal'),
	howard: languagesFor('Ron Howard'),
};

const siteUrl = Astro.site?.origin ?? siteConfig.siteUrl ?? 'https://photos.jaydixit.com';
const canonicalUrl = new URL('/wikipedia/', siteUrl).toString();
const pageDescription = `People whose Wikipedia articles use portraits by ${siteConfig.owner}.`;

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: `My Photos on Wikipedia — ${siteConfig.owner}`,
	description: pageDescription,
	url: canonicalUrl,
};
---

<MainLayout
	photoFooter
	useArnoPro
	title="My Photos on Wikipedia"
	description={pageDescription}
	canonical={canonicalUrl}
	structuredData={structuredData}
>
	<section class="wp-page">
		<div class="wp-shell">
			<header class="wp-header">
				<h1 class="wp-title">My Photos on Wikipedia</h1>
				<p class="wp-standfirst">
					My photos are used in {intro.articles} Wikipedia articles in {intro.languages} languages.
					Sydney Sweeney’s page uses my photo in {intro.sweeney} languages, Paul Mescal’s in{' '}
					{intro.mescal}, and Ron Howard’s in {intro.howard}.
				</p>
			</header>

			<div class="wp-search">
				<label class="wp-search-label" for="wp-search-input">Search names</label>
				<input
					id="wp-search-input"
					type="search"
					class="wp-search-input"
					placeholder="Search by name"
					autocomplete="off"
				/>
			</div>

			<p class="wp-no-matches" id="wp-no-matches" hidden>No matches</p>

			<div class="wp-grid" id="wp-grid">
				{
					people.map((person, i) => (
						<figure class="wp-card" data-search={person.name.toLowerCase()}>
							<a
								class="wp-frame portfolio-lightbox"
								href={person.photo.full}
								data-pswp-item="true"
								data-pswp-width={person.photo.fullWidth}
								data-pswp-height={person.photo.fullHeight}
								data-pswp-caption={person.name}
								data-exhibition-thumb={person.photo.thumb}
								data-exhibition-commons={person.photo.commonsUrl}
								data-exhibition-person={person.slug ? `/red-carpet/${person.slug}/` : undefined}
								data-exhibition-person-label={person.slug ? `${person.name} portraits` : undefined}
								data-cropped="true"
								aria-label={`${person.name} — view full size`}
								style={`--cover-position: ${person.position ?? '50% 22%'}`}
							>
								<img
									class="wp-img"
									src={person.photo.thumb}
									srcset={person.photo.srcset}
									sizes="(min-width: 1025px) 25vw, (min-width: 768px) 33vw, 50vw"
									width={person.photo.thumbWidth}
									height={person.photo.thumbHeight}
									alt={person.name}
									loading={i < 8 ? 'eager' : 'lazy'}
									decoding="async"
								/>
							</a>
							<figcaption class="wp-meta">
								<h2 class="wp-name">
									{person.slug ? (
										<a class="wp-name-link" href={`/red-carpet/${person.slug}/`}>
											{person.name}
										</a>
									) : (
										person.name
									)}
								</h2>
								<a
									class="editorial-link wp-article"
									href={person.article.url}
									target="_blank"
									rel="noopener noreferrer"
								>
									View on Wikipedia
									{person.article.language !== 'English' && ` (${person.article.language})`}
									<span aria-hidden="true">↗</span>
								</a>
							</figcaption>
						</figure>
					))
				}
			</div>
		</div>
	</section>

	<PhotoSwipeLightbox
		gallerySelector="#wp-grid"
		childrenSelector="a[data-pswp-item]"
		options={{ escKey: true, tapAction: 'toggle-controls' }}
	/>
</MainLayout>

<style>
	.wp-page {
		background: var(--paper);
		padding: var(--nav-clearance) 0 5rem;
	}

	.wp-shell {
		width: 100%;
		margin: 0 auto;
		padding: 0 2.5rem;
	}

	.wp-header {
		max-width: 60rem;
		margin: 0 auto 3rem;
		text-align: center;
	}

	.wp-title {
		margin: 0;
		font-family: var(--serif);
		font-weight: 300;
		font-size: clamp(2.8rem, 6vw, 4.5rem);
		line-height: 1.02;
		letter-spacing: -0.015em;
		color: #161310;
	}

	/* Reading-size intro, matching the homepage hero lede (Arno Subhead 28px; 26px floor). */
	.wp-standfirst {
		max-width: 46rem;
		margin: 1.6rem auto 0;
		font-family: var(--arno-subhead);
		font-weight: 400;
		font-size: 28px;
		line-height: 1.4;
		color: #3f3a34;
	}

	@media (max-width: 767px) {
		.wp-standfirst {
			font-size: 26px;
		}
	}

	.wp-search {
		max-width: 30rem;
		margin: 0 auto 3.25rem;
	}

	.wp-search-label {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.wp-search-input {
		width: 100%;
		padding: 0.85rem 1.1rem;
		border: 1px solid var(--hairline);
		border-radius: 2px;
		background: #fff;
		color: var(--ink);
		font-family: var(--sans);
		font-size: 1rem;
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.wp-search-input::placeholder {
		color: var(--muted);
		letter-spacing: 0.06em;
	}

	.wp-search-input:focus {
		outline: none;
		border-color: var(--accent);
		box-shadow: 0 0 0 3px rgba(150, 119, 63, 0.12);
	}

	.wp-no-matches {
		margin: 0 0 2rem;
		text-align: center;
		font-family: var(--serif);
		font-weight: 300;
		font-style: italic;
		font-size: 1.2rem;
		color: var(--muted);
	}

	.wp-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 2.5rem 1.75rem;
	}

	.wp-card {
		margin: 0;
	}

	.wp-card[hidden] {
		display: none;
	}

	.wp-frame {
		display: block;
		width: 100%;
		aspect-ratio: 3 / 4;
		overflow: hidden;
		background: #eceae3;
	}

	.wp-img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: var(--cover-position, 50% 22%);
		transition: filter 0.2s ease;
	}

	.wp-frame:hover .wp-img,
	.wp-frame:focus-visible .wp-img {
		filter: brightness(1.04);
	}

	.wp-meta {
		padding-top: 0.85rem;
		margin-top: 0.85rem;
		border-top: 1px solid var(--hairline);
	}

	.wp-name {
		margin: 0;
		font-family: var(--serif);
		font-weight: 400;
		font-size: 1.3rem;
		line-height: 1.12;
		letter-spacing: -0.01em;
		color: #161310;
	}

	.wp-name-link {
		color: inherit;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.wp-name-link:hover,
	.wp-name-link:focus-visible {
		color: var(--accent);
	}

	.wp-article {
		display: inline-block;
		margin-top: 0.45rem;
		font-family: var(--sans);
		font-size: 0.85rem;
	}

	@media (min-width: 2000px) {
		.wp-grid {
			grid-template-columns: repeat(5, 1fr);
		}
	}

	@media (min-width: 2600px) {
		.wp-grid {
			grid-template-columns: repeat(6, 1fr);
		}
	}

	@media (max-width: 1280px) {
		.wp-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	@media (max-width: 900px) {
		.wp-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 2rem 1.25rem;
		}
	}

	@media (max-width: 767px) {
		.wp-shell {
			padding: 0 1rem;
		}
	}
</style>

<script is:inline>
	(function () {
		const input = document.getElementById('wp-search-input');
		const grid = document.getElementById('wp-grid');
		const noMatches = document.getElementById('wp-no-matches');
		if (!input || !grid) return;
		const cards = Array.from(grid.querySelectorAll('.wp-card'));
		input.addEventListener('input', function () {
			const query = input.value.trim().toLowerCase();
			let visible = 0;
			cards.forEach(function (card) {
				const match = query === '' || (card.getAttribute('data-search') || '').includes(query);
				card.hidden = !match;
				if (match) visible++;
			});
			if (noMatches) noMatches.hidden = !(query !== '' && visible === 0);
		});
	})();
</script>
