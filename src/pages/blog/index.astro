---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import { smartQuotes } from '@jaydixit/astro-utils';
import { cldUrl, cldSrcset, cldSizes } from '../../lib/cloudinary';
import siteConfig from '../../../site.config.mts';

function formatTagLabel(tag: string) {
	const normalized = tag.trim().toLowerCase();
	const labelMap: Record<string, string> = {
		wikiportraits: 'WikiPortraits',
		sxsw: 'SXSW',
		tiff: 'TIFF',
		nyff: 'NYFF',
		ucb: 'UCB',
	};

	return labelMap[normalized] ?? tag;
}

const posts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = posts
	.map((entry) => ({
		...entry,
		data: {
			...entry.data,
			publishDate: entry.data.publishDate ?? entry.data.updateDate ?? new Date(0),
		},
	}))
	.sort((a, b) => (b.data.publishDate?.valueOf() ?? 0) - (a.data.publishDate?.valueOf() ?? 0));

const blogDateFormatOptions: Intl.DateTimeFormatOptions = {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
	timeZone: 'UTC',
};

const siteUrl = Astro.site?.origin ?? siteConfig.siteUrl ?? 'https://photos.jaydixit.com';
const canonicalUrl = new URL('/blog/', siteUrl).toString();
const pageDescription =
	'Dispatches on photography, creative process, and the craft of storytelling.';
const blogIndexStructuredData = {
	'@context': 'https://schema.org',
	'@type': 'Blog',
	name: `${siteConfig.title} Journal`,
	description: pageDescription,
	url: canonicalUrl,
	author: {
		'@type': 'Person',
		name: siteConfig.owner,
	},
};
---

<MainLayout
	title="Blog"
	description={pageDescription}
	canonical={canonicalUrl}
	structuredData={blogIndexStructuredData}
>
	<section class="blog-page">
		<div class="blog-shell">
			<header class="blog-header">
				<p class="blog-kicker">Journal</p>
				<h1 class="blog-title">Notes From the Field</h1>
				<p class="blog-standfirst">
					Dispatches on photography, creative process, and the craft of storytelling.
				</p>
			</header>

			{
				sortedPosts.length === 0 && (
					<p class="blog-empty">No posts published yet. Check back soon.</p>
				)
			}

			<div class="blog-list">
				{
					sortedPosts.map(({ data, id }) => {
						const publishDate = data.publishDate ? new Date(data.publishDate) : undefined;
						const formattedDate = publishDate
							? publishDate.toLocaleDateString('en-US', blogDateFormatOptions)
							: null;

						const heroImage = data.imagePublicId
							? cldUrl(data.imagePublicId, 1600)
							: (data.image ?? null);
						const heroSrcset = data.imagePublicId ? cldSrcset(data.imagePublicId) : undefined;
						const excerpt = data.excerpt ? smartQuotes(data.excerpt) : null;

						return (
							<article class="post">
								<a href={`/blog/${id}/`} class="post-link">
									{heroImage && (
										<figure class="post-figure">
											<img
												src={heroImage}
												srcset={heroSrcset}
												sizes={cldSizes('(max-width: 768px) 100vw, 50vw')}
												alt={data.imageAlt ?? data.title}
												loading="lazy"
												decoding="async"
												class="post-img"
											/>
										</figure>
									)}

									<div class="post-body">
										{formattedDate && (
											<time datetime={publishDate?.toISOString()} class="post-date">
												{formattedDate}
											</time>
										)}

										<h2 class="post-title">{data.title}</h2>

										{excerpt && <p class="post-excerpt">{excerpt}</p>}

										{data.tags && data.tags.length > 0 && (
											<ul class="post-tags">
												{data.tags.map((tag) => (
													<li class="post-tag">{formatTagLabel(tag)}</li>
												))}
											</ul>
										)}

										<span class="post-more">
											Read story
											<svg viewBox="0 0 12 12" aria-hidden="true">
												<path
													fill="currentColor"
													d="M3.172 11.828 2 10.657l5.485-5.485H1V3h8.172l.707.707-6.707 6.707z"
												/>
											</svg>
										</span>
									</div>
								</a>
							</article>
						);
					})
				}
			</div>
		</div>
	</section>
</MainLayout>

<style>
	.blog-page {
		background: var(--paper);
		padding: 9rem 0 6rem;
	}

	.blog-shell {
		max-width: 60rem;
		margin: 0 auto;
		padding: 0 2.5rem;
	}

	.blog-header {
		max-width: 40rem;
		margin: 0 auto 4rem;
		text-align: center;
	}

	.blog-kicker {
		margin: 0 0 1.4rem;
		font-family: var(--sans);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.32em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.blog-title {
		margin: 0;
		font-family: var(--serif);
		font-weight: 300;
		font-size: clamp(2.8rem, 6vw, 4.5rem);
		line-height: 1.02;
		letter-spacing: -0.015em;
		color: #161310;
	}

	.blog-standfirst {
		max-width: 32rem;
		margin: 1.6rem auto 0;
		font-family: var(--serif);
		font-weight: 300;
		font-style: italic;
		font-size: 1.2rem;
		line-height: 1.55;
		color: #565049;
	}

	.blog-empty {
		text-align: center;
		font-family: var(--sans);
		color: var(--muted);
	}

	.blog-list {
		display: grid;
		gap: 0;
	}

	.post {
		border-top: 1px solid var(--hairline);
	}

	.post:first-child {
		border-top: none;
	}

	.post-link {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2.5rem;
		align-items: center;
		padding: 3rem 0;
		text-decoration: none;
		color: inherit;
	}

	.post-figure {
		margin: 0;
		aspect-ratio: 3 / 2;
		overflow: hidden;
		background: #eceae3;
	}

	.post-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	.post-link:hover .post-img {
		transform: scale(1.03);
	}

	.post-body {
		min-width: 0;
	}

	.post-date {
		display: block;
		margin-bottom: 1rem;
		font-family: var(--sans);
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.post-title {
		margin: 0;
		font-family: var(--serif);
		font-weight: 400;
		font-size: clamp(1.6rem, 3vw, 2.1rem);
		line-height: 1.12;
		letter-spacing: -0.015em;
		color: #161310;
		transition: color 0.2s ease;
	}

	.post-link:hover .post-title {
		color: var(--accent);
	}

	.post-excerpt {
		margin: 1rem 0 0;
		font-family: var(--sans);
		font-size: 1rem;
		line-height: 1.65;
		color: #5c554c;
	}

	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 1.5rem 0 0;
		padding: 0;
		list-style: none;
	}

	.post-tag {
		font-family: var(--sans);
		font-size: 0.66rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--accent);
		border: 1px solid #e0d6c2;
		border-radius: 999px;
		padding: 0.3rem 0.75rem;
	}

	.post-more {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		margin-top: 1.75rem;
		font-family: var(--sans);
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		color: var(--ink);
	}

	.post-more svg {
		width: 0.7rem;
		height: 0.7rem;
		transition: transform 0.25s ease;
	}

	.post-link:hover .post-more svg {
		transform: translate(2px, -2px);
	}

	/* Alternate image side for rhythm */
	.post:nth-child(even) .post-figure {
		order: 2;
	}

	@media (max-width: 767px) {
		.blog-page {
			padding-top: 7rem;
		}

		.blog-shell {
			padding: 0 1.5rem;
		}

		.post-link {
			grid-template-columns: 1fr;
			gap: 1.5rem;
			padding: 2.5rem 0;
		}

		.post:nth-child(even) .post-figure {
			order: 0;
		}
	}
</style>
