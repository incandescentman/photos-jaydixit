---
import MainLayout from '../../layouts/MainLayout.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import SocialShare from '../../components/SocialShare.astro';
import { getCollection, render } from 'astro:content';
import { smartQuotes } from '@jaydixit/astro-utils';
import { cldUrl, cldSrcset, cldSizes } from '../../lib/cloudinary';
import siteConfig from '../../../site.config.mts';

function formatTagLabel(tag: string) {
	const normalized = tag.trim().toLowerCase();
	const labelMap: Record<string, string> = {
		wikiportraits: 'WikiPortraits',
		sxsw: 'SXSW',
		tiff: 'TIFF',
		nyff: 'NYFF',
		ucb: 'UCB',
	};

	return labelMap[normalized] ?? tag;
}

export async function getStaticPaths() {
	const posts = await getCollection('blog', (entry) => !entry.data.draft);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
const data = post.data;
const publishDate = data.publishDate ? new Date(data.publishDate) : undefined;
const blogDateFormatOptions: Intl.DateTimeFormatOptions = {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
	timeZone: 'UTC',
};
const formattedDate = publishDate
	? publishDate.toLocaleDateString('en-US', blogDateFormatOptions)
	: null;
const heroImage = data.imagePublicId ? cldUrl(data.imagePublicId, 2000) : (data.image ?? null);
const heroSrcset = data.imagePublicId ? cldSrcset(data.imagePublicId) : undefined;
const excerpt = data.excerpt ? smartQuotes(data.excerpt) : null;
const siteUrl = Astro.site?.origin ?? siteConfig.siteUrl ?? 'https://photos.jaydixit.com';
const canonicalUrl = new URL(`/blog/${post.id}/`, siteUrl).toString();
const showRelatedPosts = post.id !== 'wikiportraits-story';
const blogStructuredData = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: data.title,
	description: data.excerpt ?? '',
	datePublished: publishDate?.toISOString(),
	dateModified: (data.updateDate ?? data.publishDate)?.toISOString(),
	author: {
		'@type': 'Person',
		name: siteConfig.owner,
	},
	publisher: {
		'@type': 'Person',
		name: siteConfig.owner,
	},
	mainEntityOfPage: canonicalUrl,
	image: heroImage ? [new URL(heroImage, siteUrl).toString()] : undefined,
	keywords: data.tags?.join(', '),
};
---

<MainLayout
	title={data.title}
	description={data.excerpt}
	canonical={canonicalUrl}
	image={heroImage ?? undefined}
	imageAlt={data.imageAlt ?? data.title}
	ogType="article"
	publishedTime={publishDate}
	modifiedTime={data.updateDate ?? data.publishDate}
	keywords={data.tags}
	structuredData={blogStructuredData}
>
	<article
		id="blog-lightbox-gallery"
		class="blog-article mx-auto max-w-3xl px-6 pb-24 pt-44 md:pt-56"
	>
		{
			heroImage && (
				<figure class="relative mb-12 overflow-hidden rounded-[2.5rem] bg-slate-100 shadow-[0_25px_70px_-30px_rgba(15,23,42,0.35)]">
					<img
						src={heroImage}
						srcset={heroSrcset}
						sizes={cldSizes('(max-width: 900px) 100vw, 80vw')}
						alt={data.imageAlt ?? data.title}
						loading="eager"
						decoding="async"
						class="blog-hero-image h-full w-full object-cover"
					/>
				</figure>
			)
		}

		<header class="blog-header text-center">
			<p class="blog-kicker eyebrow">Essay</p>
			<h1 class="blog-title">{data.title}</h1>
			{
				formattedDate && (
					<time datetime={publishDate?.toISOString()} class="blog-meta">
						{formattedDate}
					</time>
				)
			}
			{
				data.tags && (
					<ul class="blog-tags">
						{data.tags.map((tag) => (
							<li>{formatTagLabel(tag)}</li>
						))}
					</ul>
				)
			}
			{excerpt && <p class="blog-excerpt">{excerpt}</p>}
		</header>

		<SocialShare
			title={data.title}
			text={data.excerpt ?? `Read ${data.title} on ${siteConfig.title}`}
			className="mb-10"
		/>

		<div class="article-content mx-auto max-w-none">
			<Content />
		</div>

		{showRelatedPosts && <RelatedPosts currentSlug={post.id} currentTags={data.tags ?? []} />}
	</article>
</MainLayout>

<script hoist>
	import PhotoSwipeLightbox from 'photoswipe/lightbox';
	import 'photoswipe/style.css';

	function updateLightboxLink(img: HTMLImageElement, link: HTMLAnchorElement) {
		link.href = img.currentSrc || img.src;

		if (img.naturalWidth > 0) {
			link.setAttribute('data-pswp-width', String(img.naturalWidth));
		}

		if (img.naturalHeight > 0) {
			link.setAttribute('data-pswp-height', String(img.naturalHeight));
		}

		if (img.alt) {
			link.setAttribute('data-pswp-caption', img.alt);
		}
	}

	function wrapBlogImage(img: HTMLImageElement) {
		const existingLink = img.closest('a');

		if (existingLink instanceof HTMLAnchorElement) {
			existingLink.classList.add('portfolio-lightbox');
			updateLightboxLink(img, existingLink);
			return;
		}

		const link = document.createElement('a');
		link.className = 'portfolio-lightbox block';
		link.setAttribute('aria-label', img.alt || 'Open image');
		img.parentNode?.insertBefore(link, img);
		link.appendChild(img);
		updateLightboxLink(img, link);
	}

	function enhanceBlogImages() {
		const gallery = document.querySelector('#blog-lightbox-gallery');
		if (!(gallery instanceof HTMLElement)) return;

		const targets = gallery.querySelectorAll<HTMLImageElement>(
			'.blog-hero-image, .article-content img',
		);
		targets.forEach((img) => {
			img.classList.add('cursor-zoom-in');
			wrapBlogImage(img);

			if (!img.complete || img.naturalWidth === 0 || img.naturalHeight === 0) {
				img.addEventListener(
					'load',
					() => {
						const link = img.closest('a.portfolio-lightbox');
						if (link instanceof HTMLAnchorElement) {
							updateLightboxLink(img, link);
						}
					},
					{ once: true },
				);
			}
		});

		const lightbox = new PhotoSwipeLightbox({
			gallery: '#blog-lightbox-gallery',
			children: '.portfolio-lightbox',
			pswpModule: () => import('photoswipe'),
			padding: { top: 20, bottom: 80, left: 20, right: 20 },
			wheelToZoom: true,
			imageClickAction: 'close',
			tapAction: 'toggle-controls',
			doubleTapAction: 'zoom',
			preloaderDelay: 0,
			showHideAnimationType: 'fade',
		});

		lightbox.addFilter('itemData', (itemData) => {
			const linkEl = itemData.element;
			if (!(linkEl instanceof HTMLAnchorElement)) return itemData;

			const img = linkEl.querySelector('img');
			const width = parseInt(linkEl.getAttribute('data-pswp-width') || '', 10);
			const height = parseInt(linkEl.getAttribute('data-pswp-height') || '', 10);
			const caption = linkEl.getAttribute('data-pswp-caption') || '';

			if (Number.isFinite(width) && width > 0) {
				itemData.w = width;
			} else if (img instanceof HTMLImageElement && img.naturalWidth > 0) {
				itemData.w = img.naturalWidth;
			}

			if (Number.isFinite(height) && height > 0) {
				itemData.h = height;
			} else if (img instanceof HTMLImageElement && img.naturalHeight > 0) {
				itemData.h = img.naturalHeight;
			}

			if (caption) {
				itemData.title = caption;
			}

			return itemData;
		});

		lightbox.init();
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', enhanceBlogImages, { once: true });
	} else {
		enhanceBlogImages();
	}
</script>

<style>
	.blog-article {
		color: var(--ink);
	}

	.blog-header {
		margin-bottom: 3rem;
	}

	.blog-kicker {
		margin: 0 0 1.3rem;
	}

	.blog-title {
		margin: 0;
		font-family: var(--serif);
		font-weight: 300;
		font-size: clamp(3rem, 6.5vw, 5rem);
		line-height: 1.02;
		letter-spacing: -0.015em;
		color: #161310;
	}

	.blog-meta {
		display: block;
		margin-top: 1.35rem;
		font-family: var(--sans);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.blog-tags {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.65rem;
		margin: 1.35rem 0 0;
		padding: 0;
		list-style: none;
		font-family: var(--sans);
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: #6e675c;
	}

	.blog-tags li {
		border: 1px solid var(--hairline);
		border-radius: 999px;
		padding: 0.32rem 0.78rem;
	}

	.blog-excerpt {
		max-width: 40rem;
		margin: 1.75rem auto 0;
		font-family: var(--serif);
		font-weight: 300;
		font-size: clamp(1.35rem, 2.5vw, 1.8rem);
		line-height: 1.4;
		color: #5c554c;
	}

	.article-content {
		font-family: var(--serif);
		font-weight: 300;
		color: #3a352e;
	}

	.article-content :global(p),
	.article-content :global(li) {
		margin: 0 0 1.5rem;
		font-family: var(--serif);
		font-weight: 300;
		font-size: 1.5rem;
		line-height: 1.5;
		color: #3a352e;
	}

	.article-content :global(ul),
	.article-content :global(ol) {
		margin: 0 0 1.5rem;
		padding-left: 1.4rem;
	}

	.article-content :global(li) {
		margin-bottom: 0.6rem;
	}

	.article-content :global(h2) {
		margin: 4rem 0 1.5rem;
		font-family: var(--serif);
		font-weight: 400;
		font-size: clamp(2rem, 4vw, 3rem);
		line-height: 1.08;
		letter-spacing: -0.015em;
		color: #161310;
	}

	.article-content :global(h3) {
		margin: 3rem 0 1.25rem;
		font-family: var(--serif);
		font-weight: 400;
		font-size: 1.8rem;
		line-height: 1.1;
		color: #161310;
	}

	.article-content :global(a:not(.portfolio-lightbox)) {
		color: var(--accent);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.16em;
	}

	.article-content :global(figure) {
		margin: 2.75rem 0;
	}

	.article-content :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}

	.article-content :global(blockquote) {
		margin: 3rem 0;
		padding-left: 1.5rem;
		border-left: 1px solid var(--accent);
		font-family: var(--serif);
		font-weight: 300;
		font-style: italic;
		font-size: 1.5rem;
		line-height: 1.5;
		color: #2a2620;
	}

	.article-content :global(figcaption) {
		max-width: 34rem;
		margin: 0.85rem auto 0;
		font-family: var(--sans);
		font-size: 0.88rem;
		font-weight: 400;
		line-height: 1.5;
		text-align: center;
		color: #6e675c;
	}

	.article-content :global(figcaption p) {
		margin: 0;
		font: inherit;
		line-height: inherit;
		color: inherit;
	}

	.article-content :global(.portfolio-lightbox) {
		text-decoration: none;
	}

	.article-content :global(.wikiportraits-hero) {
		width: min(58rem, calc(100vw - 3rem));
		max-width: none;
		margin: 0 50% 4rem;
		transform: translateX(-50%);
	}

	.article-content :global(.wikiportraits-hero-grid) {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		gap: 1.25rem;
		align-items: start;
	}

	.article-content :global(.wikiportraits-hero-panel) {
		display: grid;
		gap: 0.9rem;
		min-width: 0;
	}

	.article-content :global(.wikiportraits-hero-frame) {
		aspect-ratio: 3 / 4;
		overflow: hidden;
		background: #eceae3;
	}

	.article-content :global(.wikiportraits-hero-frame .portfolio-lightbox) {
		display: block;
		width: 100%;
		height: 100%;
	}

	.article-content :global(.wikiportraits-hero-img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.article-content :global(.wikiportraits-hero-img--before) {
		object-position: center 20%;
	}

	.article-content :global(.wikiportraits-hero-img--after) {
		object-position: center top;
	}

	.article-content :global(.wikiportraits-hero-arrow) {
		display: grid;
		place-items: center;
		align-self: start;
		width: 2.75rem;
		height: 2.75rem;
		margin-top: clamp(9rem, 20vw, 16rem);
		border: 1px solid var(--hairline);
		border-radius: 999px;
		background: var(--paper);
		color: var(--muted);
		font-size: 1.8rem;
		line-height: 1;
		box-shadow: 0 6px 18px rgba(41, 37, 36, 0.06);
	}

	.article-content :global(.wikiportraits-hero-meta) {
		display: grid;
		gap: 0.35rem;
		font-family: var(--sans);
		font-size: 0.8rem;
		line-height: 1.35;
		color: #5c554c;
	}

	.article-content :global(.wikiportraits-hero-meta p) {
		margin: 0;
		font: inherit;
		line-height: inherit;
		color: inherit;
	}

	.article-content :global(.wikiportraits-hero-meta span) {
		font-family: var(--sans);
		font-size: inherit;
		line-height: inherit;
		color: inherit;
	}

	.article-content :global(.wikiportraits-hero-meta strong) {
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--ink);
	}

	.article-content :global(.wikiportraits-hero-title) {
		display: block;
		margin-bottom: 0.45rem;
		font-family: var(--sans);
		font-size: 0.9rem;
		line-height: 1.35;
		font-weight: 500;
		color: #2a2620;
	}

	.article-content :global(.article-image-small) {
		max-width: 34rem;
		margin-inline: auto;
	}

	.article-content :global(.article-image-small .portfolio-lightbox) {
		display: block;
		max-width: 18rem;
		margin-inline: auto;
	}

	.article-content :global(.article-image-small img) {
		width: 100%;
		max-width: 18rem;
		height: auto;
		margin-inline: auto;
	}

	.article-content :global(.article-image-medium) {
		max-width: 24rem;
		margin-inline: auto;
	}

	.article-content :global(.article-image-medium .portfolio-lightbox) {
		display: block;
	}

	.article-content :global(.before-after-grid) {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		gap: 1rem;
		align-items: center;
	}

	.article-content :global(.before-after-grid img) {
		width: 100%;
		height: auto;
		aspect-ratio: 3 / 4;
		object-fit: cover;
	}

	.article-content :global(.before-after-arrow) {
		color: #44403c;
		font-size: 2.5rem;
		line-height: 1;
	}

	@media (max-width: 640px) {
		.blog-title {
			font-size: 3rem;
		}

		.article-content :global(p),
		.article-content :global(li),
		.article-content :global(blockquote) {
			font-size: 1.25rem;
		}

		.article-content :global(.before-after-grid) {
			grid-template-columns: 1fr;
		}

		.article-content :global(.wikiportraits-hero-grid) {
			grid-template-columns: 1fr;
		}

		.article-content :global(.wikiportraits-hero-arrow) {
			justify-self: center;
			margin-top: 0;
			transform: rotate(90deg);
		}

		.article-content :global(.before-after-arrow) {
			justify-self: center;
			transform: rotate(90deg);
		}
	}
</style>
