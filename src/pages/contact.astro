---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Contact" description="Send a message to Jay Dixit." canonical="/contact">
	<section class="contact-page">
		<div class="contact-shell">
			<header class="contact-header">
				<p class="contact-kicker">Contact</p>
				<h1>Let's Talk</h1>
				<p>
					Send a message with Formspree and I will get back to you. If you prefer email, you can
					also reach me directly at <a href="mailto:jay@jaydixit.com">jay@jaydixit.com</a>.
				</p>
			</header>

			<form action="https://formspree.io/f/xeelzjpn" method="POST" class="contact-form">
				<input
					type="hidden"
					name="_subject"
					value="New message from photos.jaydixit.com contact form"
				/>
				<input type="text" name="_gotcha" class="hp-field" tabindex="-1" autocomplete="off" />

				<label for="name">Name</label>
				<input id="name" name="name" type="text" required />

				<label for="email">Email</label>
				<input id="email" name="email" type="email" required />

				<label for="topic">Topic</label>
				<select id="topic" name="topic">
					<option value="Photography">Photography</option>
					<option value="Speaking">Speaking</option>
					<option value="Press">Press</option>
					<option value="Other">Other</option>
				</select>

				<label for="message">Message</label>
				<textarea id="message" name="message" rows={7} required></textarea>

				<button type="submit">Send Message</button>
			</form>
		</div>
	</section>
</MainLayout>

<style>
	.contact-page {
		min-height: 100vh;
		padding: 9rem 1rem 4rem;
		background:
			radial-gradient(circle at 12% 10%, rgba(14, 165, 233, 0.13), transparent 42%),
			radial-gradient(circle at 90% 90%, rgba(16, 185, 129, 0.1), transparent 40%), #f8fafc;
	}

	.contact-shell {
		max-width: 760px;
		margin: 0 auto;
		background: rgba(255, 255, 255, 0.92);
		border: 1px solid rgba(203, 213, 225, 0.65);
		border-radius: 1.5rem;
		padding: 2rem;
		box-shadow: 0 18px 45px -35px rgba(15, 23, 42, 0.5);
	}

	.contact-header {
		margin-bottom: 1.5rem;
	}

	.contact-kicker {
		margin: 0;
		font-size: 0.75rem;
		letter-spacing: 0.32em;
		text-transform: uppercase;
		color: #0284c7;
		font-weight: 700;
	}

	.contact-header h1 {
		margin: 0.4rem 0 0.8rem;
		font-size: clamp(2rem, 4vw, 2.8rem);
		letter-spacing: -0.02em;
	}

	.contact-header p {
		margin: 0;
		color: #334155;
		line-height: 1.6;
	}

	.contact-header a {
		color: #0f172a;
		font-weight: 600;
	}

	.contact-form {
		display: grid;
		gap: 0.6rem;
	}

	.contact-form label {
		margin-top: 0.6rem;
		font-size: 0.83rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: #475569;
	}

	.contact-form input,
	.contact-form textarea,
	.contact-form select {
		width: 100%;
		padding: 0.85rem 0.9rem;
		border: 1px solid #cbd5e1;
		border-radius: 0.75rem;
		background: #fff;
		color: #0f172a;
		font: inherit;
	}

	.contact-form input:focus,
	.contact-form textarea:focus,
	.contact-form select:focus {
		outline: 2px solid #0ea5e9;
		outline-offset: 1px;
		border-color: #0ea5e9;
	}

	.contact-form button {
		margin-top: 1rem;
		padding: 0.95rem 1.2rem;
		border: 0;
		border-radius: 9999px;
		background: linear-gradient(130deg, #0f172a, #0369a1);
		color: #fff;
		font-weight: 700;
		letter-spacing: 0.03em;
		cursor: pointer;
		transition:
			transform 0.18s ease,
			opacity 0.18s ease;
	}

	.contact-form button:hover {
		opacity: 0.94;
		transform: translateY(-1px);
	}

	.hp-field {
		position: absolute;
		left: -100vw;
		width: 1px;
		height: 1px;
		opacity: 0;
	}

	@media (max-width: 640px) {
		.contact-shell {
			padding: 1.25rem;
			border-radius: 1.1rem;
		}
	}
</style>
