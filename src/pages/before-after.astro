---
import MainLayout from '../layouts/MainLayout.astro';
import EditorialPhotoFrame from '../components/EditorialPhotoFrame.astro';
import PhotoSwipeLightbox from '../components/PhotoSwipeLightbox.astro';
import { comparisons } from '../data/beforeAfter';
---

<MainLayout
	title="Before & After"
	description="Wikipedia portrait upgrades: see the difference professional photography makes"
>
	<!-- Hero -->
	<section class="ba-hero">
		<div class="ba-shell">
			<p class="ba-kicker eyebrow">The WikiPortraits Project</p>
			<h1 class="ba-title">Before &amp; After</h1>
			<p class="ba-standfirst">
				Wikipedia deserves better photographs. As a red-carpet photographer for Wikipedia, I replace
				low-quality portraits with professional images shot at film festivals and cultural events.
			</p>
		</div>
	</section>

	<!-- Comparison Grid -->
	<section class="ba-gallery-section">
		<div id="before-after-gallery" class="ba-shell">
			{
				comparisons.length === 0 ? (
					<div class="ba-empty">
						<p>More comparisons coming soon.</p>
					</div>
				) : (
					<div class="ba-list">
						{comparisons.map((comparison, i) => (
							<article class="ba-pair">
								<header class="ba-pair-head">
									<span class="ba-index">{String(i + 1).padStart(2, '0')}</span>
									<div class="ba-pair-titles">
										<h2 class="ba-name">{comparison.name}</h2>
										{comparison.event && <p class="ba-event">{comparison.event}</p>}
									</div>
									{comparison.article && (
										<a
											href={comparison.article}
											target="_blank"
											rel="noopener noreferrer"
											class="ba-wiki editorial-link"
										>
											View on Wikipedia
											<span aria-hidden="true">&rarr;</span>
										</a>
									)}
								</header>

								<div class="ba-images">
									<EditorialPhotoFrame
										image={comparison.beforeImage}
										alt={`${comparison.name} - previous Wikipedia photo`}
										caption={`${comparison.name} - previous Wikipedia photo`}
										label="Before"
										source={comparison.beforeSource}
										objectPosition={comparison.beforePos}
										eager={i === 0}
										labelVariant="ba-cap--before"
									/>

									<div class="ba-arrow" aria-hidden="true">
										<svg viewBox="0 0 32 32" focusable="false">
											<path d="M5 16h20" />
											<path d="m17 8 8 8-8 8" />
										</svg>
									</div>

									<EditorialPhotoFrame
										image={comparison.afterImage}
										alt={`${comparison.name} - upgraded Wikipedia photo by Jay Dixit`}
										caption={`${comparison.name} - upgraded Wikipedia photo by Jay Dixit`}
										label="After"
										source={comparison.afterSource}
										objectPosition={comparison.afterPos}
										eager={i === 0}
										labelVariant="ba-cap--after"
									/>
								</div>

								{comparison.license && comparison.licenseUrl && (
									<div class="ba-provenance-row">
										<p class="ba-provenance photo-credit">
											{comparison.articleUsageStatus === 'lead' && (
												<span>Currently the lead photo on Wikipedia</span>
											)}
											<a
												href={comparison.licenseUrl}
												target="_blank"
												rel="noopener noreferrer"
												class="editorial-link"
											>
												{comparison.license}
											</a>
											{comparison.commonsUrl && (
												<a
													href={comparison.commonsUrl}
													target="_blank"
													rel="noopener noreferrer"
													class="editorial-link"
												>
													View on Wikimedia Commons
												</a>
											)}
										</p>
									</div>
								)}
							</article>
						))}
					</div>
				)
			}
		</div>
	</section>

	<!-- Context -->
	<section class="ba-context">
		<div class="ba-shell ba-shell--narrow">
			<p class="ba-kicker ba-kicker--center eyebrow">Why This Matters</p>
			<p class="ba-pullquote">
				For many people, a Wikipedia article is the first place they go to learn about someone. The
				photo at the top shapes how millions perceive that person.
			</p>
			<p class="ba-body">
				Yet countless articles still feature outdated, poorly lit, or unflattering images — awkward
				crops from group shots, grainy phone photos, stills pulled from video interviews. Through
				the
				<a href="/blog/wikiportraits-story" class="ba-inline-link editorial-link"
					>WikiPortraits initiative</a
				>, I'm working to change that, one portrait at a time.
			</p>
		</div>
	</section>

	<!-- CTA -->
	<section class="ba-cta">
		<div class="ba-shell ba-shell--narrow">
			<p class="ba-cta-lede">Want to see more of my work?</p>
			<div class="ba-cta-actions">
				<a href="/gallery" class="ba-btn ba-btn--solid">Browse Gallery</a>
				<a href="/about" class="ba-btn ba-btn--ghost">About Me</a>
			</div>
		</div>
	</section>
</MainLayout>

<PhotoSwipeLightbox
	gallerySelector="#before-after-gallery"
	childrenSelector="a[data-pswp-item]"
	options={{
		padding: { top: 20, bottom: 80, left: 20, right: 20 },
		wheelToZoom: true,
		preloaderDelay: 0,
		showHideAnimationType: 'fade',
	}}
/>

<style>
	.ba-shell {
		max-width: 68rem;
		margin: 0 auto;
		padding-left: 2.5rem;
		padding-right: 2.5rem;
	}

	.ba-shell--narrow {
		max-width: 42rem;
	}

	/* ---- Hero ---- */
	.ba-hero {
		background: var(--paper);
		padding: var(--nav-clearance) 0 2rem;
		text-align: center;
	}

	.ba-kicker {
		margin: 0 0 1.6rem;
	}

	.ba-kicker--center {
		text-align: center;
		margin-bottom: 1.4rem;
	}

	.ba-title {
		margin: 0;
		font-family: var(--serif);
		font-weight: 300;
		font-size: clamp(3.2rem, 7vw, 5.1rem);
		line-height: 1.02;
		letter-spacing: -0.015em;
		color: #161310;
	}

	.ba-standfirst {
		max-width: 37rem;
		margin: 1.9rem auto 0;
		font-family: var(--serif);
		font-weight: 300;
		font-size: 1.35rem;
		line-height: 1.55;
		color: #565049;
	}

	/* ---- Gallery ---- */
	.ba-gallery-section {
		background: var(--paper);
		padding: 3.75rem 0 4rem;
	}

	.ba-list {
		display: grid;
		gap: 0;
	}

	.ba-pair {
		padding: 4rem 0 4.5rem;
		border-top: 1px solid var(--hairline);
	}

	.ba-pair:first-child {
		border-top: none;
		padding-top: 1rem;
	}

	.ba-pair-head {
		display: flex;
		align-items: flex-end;
		gap: 1.5rem;
		margin-bottom: 2.375rem;
	}

	.ba-index {
		font-family: var(--serif);
		font-weight: 300;
		font-size: 3.25rem;
		line-height: 0.8;
		letter-spacing: -0.02em;
		color: var(--accent);
		opacity: 0.55;
	}

	.ba-pair-titles {
		flex: 1;
		min-width: 0;
	}

	.ba-name {
		margin: 0;
		font-family: var(--serif);
		font-weight: 400;
		font-size: clamp(1.9rem, 3.2vw, 2.625rem);
		line-height: 1;
		letter-spacing: -0.015em;
		color: #161310;
	}

	.ba-event {
		margin: 0.875rem 0 0;
		font-family: var(--sans);
		font-size: 0.78rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.ba-wiki {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		flex-shrink: 0;
		font-family: var(--sans);
		font-size: 0.81rem;
		letter-spacing: 0.04em;
		white-space: nowrap;
		padding-bottom: 0.375rem;
		border-bottom: 1px solid transparent;
	}

	.ba-images {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		gap: 1.25rem;
		align-items: start;
	}

	.ba-provenance-row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		gap: 1.25rem;
		margin-top: 0.75rem;
	}

	.ba-provenance {
		grid-column: 3;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.25rem 2ch;
		margin: 0;
	}

	:global(.ba-figure) {
		margin: 0;
	}

	.ba-arrow {
		display: grid;
		place-items: center;
		align-self: center;
		width: 2.75rem;
		height: 2.75rem;
		margin-top: -1rem;
		border: 1px solid var(--hairline);
		border-radius: 999px;
		background: var(--paper);
		color: var(--muted);
		box-shadow: 0 6px 18px rgba(41, 37, 36, 0.06);
	}

	.ba-arrow svg {
		width: 1.15rem;
		height: 1.15rem;
	}

	.ba-arrow path {
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	:global(.ba-frame) {
		display: block;
		width: 100%;
		aspect-ratio: 3 / 4;
		overflow: hidden;
		background: #eceae3;
		cursor: zoom-in;
	}

	:global(.ba-img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	:global(.ba-frame:hover .ba-img) {
		transform: scale(1.035);
	}

	:global(.ba-cap) {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 0.75rem;
		margin-top: 0.875rem;
		padding-top: 0.75rem;
	}

	:global(.ba-cap--before) {
		border-top: 1px solid var(--hairline);
	}

	:global(.ba-cap--after) {
		border-top: 1px solid var(--ink);
	}

	:global(.ba-cap-label) {
		flex-shrink: 0;
		font-family: var(--sans);
		font-size: 0.69rem;
		font-weight: 600;
		letter-spacing: 0.24em;
		text-transform: uppercase;
	}

	:global(.ba-cap--before .ba-cap-label) {
		color: #a79e90;
	}

	:global(.ba-cap--after .ba-cap-label) {
		color: var(--ink);
	}

	:global(.ba-cap-src) {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		text-align: right;
		font-family: var(--sans);
		font-size: 0.78rem;
	}

	:global(.ba-cap--before .ba-cap-src) {
		color: var(--muted);
	}

	:global(.ba-cap--after .ba-cap-src) {
		color: #4a443c;
	}

	.ba-empty {
		text-align: center;
		padding: 4rem 1rem;
		border: 1px solid var(--hairline);
		font-family: var(--sans);
		color: var(--muted);
	}

	/* ---- Context / pull-quote ---- */
	.ba-context {
		background: var(--paper-deep);
		padding: 5.5rem 0;
		border-top: 1px solid var(--hairline);
		border-bottom: 1px solid var(--hairline);
	}

	.ba-pullquote {
		margin: 0 0 1.75rem;
		text-align: center;
		font-family: var(--serif);
		font-weight: 300;
		font-size: clamp(1.4rem, 2.6vw, 1.65rem);
		line-height: 1.5;
		letter-spacing: -0.01em;
		color: #26221d;
	}

	.ba-body {
		margin: 0;
		font-family: var(--sans);
		font-size: 1rem;
		line-height: 1.75;
		color: #5c554c;
	}

	.ba-inline-link {
		text-decoration: underline;
		text-underline-offset: 2px;
		text-decoration-thickness: 1px;
	}

	/* ---- CTA ---- */
	.ba-cta {
		background: var(--paper);
		padding: 5rem 0;
		text-align: center;
	}

	.ba-cta-lede {
		margin: 0 0 2rem;
		font-family: var(--serif);
		font-weight: 300;
		font-style: italic;
		font-size: 1.5rem;
		color: #565049;
	}

	.ba-cta-actions {
		display: flex;
		gap: 0.875rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.ba-btn {
		display: inline-flex;
		align-items: center;
		padding: 0.85rem 1.6rem;
		font-family: var(--sans);
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		text-decoration: none;
		border-radius: 2px;
		transition:
			background-color 0.25s ease,
			color 0.25s ease,
			border-color 0.25s ease;
	}

	.ba-btn--solid {
		background: var(--ink);
		color: #faf9f6;
		border: 1px solid var(--ink);
	}

	.ba-btn--solid:hover {
		background: #000;
	}

	.ba-btn--ghost {
		background: transparent;
		color: var(--ink);
		border: 1px solid #cfc8bb;
	}

	.ba-btn--ghost:hover {
		border-color: var(--ink);
	}

	/* ---- Mobile ---- */
	@media (max-width: 767px) {
		.ba-shell {
			padding-left: 1.5rem;
			padding-right: 1.5rem;
		}

		.ba-pair-head {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.9rem;
			margin-bottom: 1.6rem;
		}

		.ba-index {
			font-size: 2.4rem;
		}

		.ba-images {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.ba-provenance-row {
			display: block;
			margin-top: 0.75rem;
		}

		.ba-arrow {
			justify-self: center;
			margin-top: 0;
			margin-bottom: 0.1rem;
			width: 2.5rem;
			height: 2.5rem;
		}

		.ba-arrow svg {
			transform: rotate(90deg);
		}

		:global(.ba-cap-src) {
			white-space: normal;
		}
	}
</style>
