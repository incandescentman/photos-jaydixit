---
import MainLayout from '../layouts/MainLayout.astro';
import { Image, getImage } from 'astro:assets';
import PhotoSwipeLightbox from '../components/PhotoSwipeLightbox.astro';
import vanessaBeforeImg from '../assets/images/wikiportraits/vanessa-kirby-before-2018.jpg';
import vanessaAfterImg from '../assets/images/wikiportraits/vanessa-kirby_tiff_2024.jpg';
import johnBeforeImg from '../assets/images/wikiportraits/john-hopfield-before-2016.jpg';
import johnAfterImg from '../assets/images/wikiportraits/john-hopfield_nobel-physics_2024.jpg';
import jeremyBeforeImg from '../assets/images/wikiportraits/jeremy-strong-before.jpg';
import jeremyAfterImg from '../assets/images/wikiportraits/jeremy-strong_the-apprentice-premiere_2024.jpg';
import conanBeforeImg from '../assets/images/wikiportraits/conan-obrien-before.jpg';
import conanAfterImg from '../assets/images/wikiportraits/conan-obrien_sundance_2024.jpg';
import sydneyBeforeImg from '../assets/images/wikiportraits/sydney-sweeney-before-2019.jpg';
import sydneyAfterImg from '../assets/images/wikiportraits/sydney-sweeney_tiff_2024.jpg';

// Before/after pairs - Wikipedia portrait upgrades.
// beforePos / afterPos hand-tune each cover-crop so faces stay in frame.
const comparisons = [
	{
		name: 'Vanessa Kirby',
		beforeImage: vanessaBeforeImg,
		afterImage: vanessaAfterImg,
		article: 'https://en.wikipedia.org/wiki/Vanessa_Kirby',
		event: 'Toronto International Film Festival 2024',
		beforeSource: 'Wikipedia portrait, 2018',
		afterSource: 'Jay Dixit, TIFF 2024',
		beforePos: 'center 20%',
		afterPos: 'center top',
	},
	{
		name: 'John Hopfield',
		beforeImage: johnBeforeImg,
		afterImage: johnAfterImg,
		article: 'https://en.wikipedia.org/wiki/John_Hopfield',
		event: 'Nobel Prize Lectures, Stockholm 2024',
		beforeSource: 'Wikipedia portrait, 2016',
		afterSource: 'Jay Dixit, Nobel Lectures 2024',
		beforePos: 'center 18%',
		afterPos: 'center 15%',
	},
	{
		name: 'Jeremy Strong',
		beforeImage: jeremyBeforeImg,
		afterImage: jeremyAfterImg,
		article: 'https://en.wikipedia.org/wiki/Jeremy_Strong',
		event: 'BFI London Film Festival 2025',
		beforeSource: 'Previous Wikipedia portrait',
		afterSource: 'Jay Dixit, BFI London 2025',
		beforePos: 'center 18%',
		afterPos: 'center 8%',
	},
	{
		name: "Conan O'Brien",
		beforeImage: conanBeforeImg,
		afterImage: conanAfterImg,
		article: 'https://en.wikipedia.org/wiki/Conan_O%27Brien',
		event: 'Sundance Film Festival 2025',
		beforeSource: 'Previous Wikipedia portrait',
		afterSource: 'Jay Dixit, Sundance 2025',
		beforePos: 'center 18%',
		afterPos: 'center 12%',
	},
	{
		name: 'Sydney Sweeney',
		beforeImage: sydneyBeforeImg,
		afterImage: sydneyAfterImg,
		article: 'https://en.wikipedia.org/wiki/Sydney_Sweeney',
		event: 'Toronto International Film Festival 2024',
		beforeSource: 'Glenn Francis, 2019',
		afterSource: 'Jay Dixit, TIFF 2024',
		beforePos: 'center 18%',
		afterPos: 'center top',
	},
];

const comparisonsWithLightbox = await Promise.all(
	comparisons.map(async (comparison) => ({
		...comparison,
		beforeLightboxHref: (
			await getImage({
				src: comparison.beforeImage,
				width: comparison.beforeImage.width,
				inferSize: true,
			})
		).src,
		afterLightboxHref: (
			await getImage({
				src: comparison.afterImage,
				width: comparison.afterImage.width,
				inferSize: true,
			})
		).src,
	})),
);
---

<MainLayout
	title="Before & After"
	description="Wikipedia portrait upgrades: see the difference professional photography makes"
>
	{/* Fonts — for best performance, move these two <link>s into MainLayout's <head>. */}
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link
		href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;1,6..72,300;1,6..72,400&display=swap"
		rel="stylesheet"
	/>

	<!-- Hero -->
	<section class="ba-hero">
		<div class="ba-shell">
			<p class="ba-kicker">The WikiPortraits Project</p>
			<h1 class="ba-title">Before &amp; After</h1>
			<p class="ba-standfirst">
				Wikipedia deserves better photographs. As a red-carpet photographer for Wikipedia, I replace
				low-quality portraits with professional images shot at film festivals and cultural events.
			</p>
		</div>
	</section>

	<!-- Comparison Grid -->
	<section class="ba-gallery-section">
		<div id="before-after-gallery" class="ba-shell">
			{
				comparisons.length === 0 ? (
					<div class="ba-empty">
						<p>
							Comparisons coming soon. Add entries to the comparisons array in before-after.astro
						</p>
					</div>
				) : (
					<div class="ba-list">
						{comparisonsWithLightbox.map((comparison, i) => (
							<article class="ba-pair">
								<header class="ba-pair-head">
									<span class="ba-index">{String(i + 1).padStart(2, '0')}</span>
									<div class="ba-pair-titles">
										<h2 class="ba-name">{comparison.name}</h2>
										{comparison.event && <p class="ba-event">{comparison.event}</p>}
									</div>
									{comparison.article && (
										<a
											href={comparison.article}
											target="_blank"
											rel="noopener noreferrer"
											class="ba-wiki"
										>
											View on Wikipedia
											<span aria-hidden="true">&rarr;</span>
										</a>
									)}
								</header>

								<div class="ba-images">
									<figure class="ba-figure">
										<a
											href={comparison.beforeLightboxHref}
											data-pswp-item="true"
											class="portfolio-lightbox ba-frame"
											data-pswp-width={comparison.beforeImage.width}
											data-pswp-height={comparison.beforeImage.height}
											data-pswp-caption={`${comparison.name} - previous Wikipedia photo`}
											data-cropped="true"
										>
											<Image
												src={comparison.beforeImage}
												alt={`${comparison.name} - previous Wikipedia photo`}
												widths={[400, 800]}
												sizes="(min-width: 768px) 50vw, 100vw"
												class="ba-img"
												style={`object-position:${comparison.beforePos}`}
												loading="lazy"
											/>
										</a>
										<figcaption class="ba-cap ba-cap--before">
											<span class="ba-cap-label">Before</span>
											<span class="ba-cap-src">{comparison.beforeSource}</span>
										</figcaption>
									</figure>

									<div class="ba-arrow" aria-hidden="true">
										<svg viewBox="0 0 32 32" focusable="false">
											<path d="M5 16h20" />
											<path d="m17 8 8 8-8 8" />
										</svg>
									</div>

									<figure class="ba-figure">
										<a
											href={comparison.afterLightboxHref}
											data-pswp-item="true"
											class="portfolio-lightbox ba-frame"
											data-pswp-width={comparison.afterImage.width}
											data-pswp-height={comparison.afterImage.height}
											data-pswp-caption={`${comparison.name} - upgraded Wikipedia photo by Jay Dixit`}
											data-cropped="true"
										>
											<Image
												src={comparison.afterImage}
												alt={`${comparison.name} - upgraded Wikipedia photo by Jay Dixit`}
												widths={[400, 800]}
												sizes="(min-width: 768px) 50vw, 100vw"
												class="ba-img"
												style={`object-position:${comparison.afterPos}`}
												loading="lazy"
											/>
										</a>
										<figcaption class="ba-cap ba-cap--after">
											<span class="ba-cap-label">After</span>
											<span class="ba-cap-src">{comparison.afterSource}</span>
										</figcaption>
									</figure>
								</div>
							</article>
						))}
					</div>
				)
			}
		</div>
	</section>

	<!-- Context -->
	<section class="ba-context">
		<div class="ba-shell ba-shell--narrow">
			<p class="ba-kicker ba-kicker--center">Why This Matters</p>
			<p class="ba-pullquote">
				For many people, a Wikipedia article is the first place they go to learn about someone. The
				photo at the top shapes how millions perceive that person.
			</p>
			<p class="ba-body">
				Yet countless articles still feature outdated, poorly lit, or unflattering images — awkward
				crops from group shots, grainy phone photos, stills pulled from video interviews. Through
				the
				<a href="/blog/wikiportraits-story" class="ba-inline-link">WikiPortraits initiative</a>, I'm
				working to change that, one portrait at a time.
			</p>
		</div>
	</section>

	<!-- CTA -->
	<section class="ba-cta">
		<div class="ba-shell ba-shell--narrow">
			<p class="ba-cta-lede">Want to see more of my work?</p>
			<div class="ba-cta-actions">
				<a href="/gallery" class="ba-btn ba-btn--solid">Browse Gallery</a>
				<a href="/about" class="ba-btn ba-btn--ghost">About Me</a>
			</div>
		</div>
	</section>
</MainLayout>

<PhotoSwipeLightbox
	gallerySelector="#before-after-gallery"
	childrenSelector="a[data-pswp-item]"
	options={{
		padding: { top: 20, bottom: 80, left: 20, right: 20 },
		wheelToZoom: true,
		preloaderDelay: 0,
		showHideAnimationType: 'fade',
	}}
/>

<style>
	/* ---- Palette & type tokens (scoped to this page) ---- */
	.ba-hero,
	.ba-gallery-section,
	.ba-context,
	.ba-cta {
		--paper: #faf9f6;
		--paper-deep: #f4f1ea;
		--ink: #1a1714;
		--muted: #8a8175;
		--hairline: #ebe6dc;
		--accent: #96773f;
		--serif: 'Newsreader', Georgia, 'Times New Roman', serif;
		--sans: 'Instrument Sans', system-ui, -apple-system, sans-serif;
	}

	.ba-shell {
		max-width: 68rem;
		margin: 0 auto;
		padding-left: 2.5rem;
		padding-right: 2.5rem;
	}

	.ba-shell--narrow {
		max-width: 42rem;
	}

	/* ---- Hero ---- */
	.ba-hero {
		background: var(--paper);
		padding: 8rem 0 2rem;
		text-align: center;
	}

	.ba-kicker {
		margin: 0 0 1.6rem;
		font-family: var(--sans);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.32em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.ba-kicker--center {
		text-align: center;
		margin-bottom: 1.4rem;
	}

	.ba-title {
		margin: 0;
		font-family: var(--serif);
		font-weight: 300;
		font-size: clamp(3.2rem, 7vw, 5.1rem);
		line-height: 1.02;
		letter-spacing: -0.015em;
		color: #161310;
	}

	.ba-standfirst {
		max-width: 37rem;
		margin: 1.9rem auto 0;
		font-family: var(--serif);
		font-weight: 300;
		font-style: italic;
		font-size: 1.35rem;
		line-height: 1.55;
		color: #565049;
	}

	/* ---- Gallery ---- */
	.ba-gallery-section {
		background: var(--paper);
		padding: 3.75rem 0 4rem;
	}

	.ba-list {
		display: grid;
		gap: 0;
	}

	.ba-pair {
		padding: 4rem 0 4.5rem;
		border-top: 1px solid var(--hairline);
	}

	.ba-pair:first-child {
		border-top: none;
		padding-top: 1rem;
	}

	.ba-pair-head {
		display: flex;
		align-items: flex-end;
		gap: 1.5rem;
		margin-bottom: 2.375rem;
	}

	.ba-index {
		font-family: var(--serif);
		font-weight: 300;
		font-size: 3.25rem;
		line-height: 0.8;
		letter-spacing: -0.02em;
		color: var(--accent);
		opacity: 0.55;
	}

	.ba-pair-titles {
		flex: 1;
		min-width: 0;
	}

	.ba-name {
		margin: 0;
		font-family: var(--serif);
		font-weight: 400;
		font-size: clamp(1.9rem, 3.2vw, 2.625rem);
		line-height: 1;
		letter-spacing: -0.015em;
		color: #161310;
	}

	.ba-event {
		margin: 0.875rem 0 0;
		font-family: var(--sans);
		font-size: 0.78rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.ba-wiki {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		flex-shrink: 0;
		font-family: var(--sans);
		font-size: 0.81rem;
		letter-spacing: 0.04em;
		color: var(--accent);
		text-decoration: none;
		white-space: nowrap;
		padding-bottom: 0.375rem;
		border-bottom: 1px solid transparent;
		transition: border-color 0.3s ease;
	}

	.ba-wiki:hover {
		border-bottom-color: #c9b792;
	}

	.ba-images {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		gap: 1.25rem;
		align-items: start;
	}

	.ba-figure {
		margin: 0;
	}

	.ba-arrow {
		display: grid;
		place-items: center;
		align-self: center;
		width: 2.75rem;
		height: 2.75rem;
		margin-top: -1rem;
		border: 1px solid var(--hairline);
		border-radius: 999px;
		background: var(--paper);
		color: var(--muted);
		box-shadow: 0 6px 18px rgba(41, 37, 36, 0.06);
	}

	.ba-arrow svg {
		width: 1.15rem;
		height: 1.15rem;
	}

	.ba-arrow path {
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.ba-frame {
		display: block;
		width: 100%;
		aspect-ratio: 3 / 4;
		overflow: hidden;
		background: #eceae3;
		cursor: zoom-in;
	}

	.ba-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	.ba-frame:hover .ba-img {
		transform: scale(1.035);
	}

	.ba-cap {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 0.75rem;
		margin-top: 0.875rem;
		padding-top: 0.75rem;
	}

	.ba-cap--before {
		border-top: 1px solid var(--hairline);
	}

	.ba-cap--after {
		border-top: 1px solid var(--ink);
	}

	.ba-cap-label {
		flex-shrink: 0;
		font-family: var(--sans);
		font-size: 0.69rem;
		font-weight: 600;
		letter-spacing: 0.24em;
		text-transform: uppercase;
	}

	.ba-cap--before .ba-cap-label {
		color: #a79e90;
	}

	.ba-cap--after .ba-cap-label {
		color: var(--ink);
	}

	.ba-cap-src {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		text-align: right;
		font-family: var(--sans);
		font-size: 0.78rem;
	}

	.ba-cap--before .ba-cap-src {
		color: var(--muted);
	}

	.ba-cap--after .ba-cap-src {
		color: #4a443c;
	}

	.ba-empty {
		text-align: center;
		padding: 4rem 1rem;
		border: 1px solid var(--hairline);
		font-family: var(--sans);
		color: var(--muted);
	}

	/* ---- Context / pull-quote ---- */
	.ba-context {
		background: var(--paper-deep);
		padding: 5.5rem 0;
		border-top: 1px solid var(--hairline);
		border-bottom: 1px solid var(--hairline);
	}

	.ba-pullquote {
		margin: 0 0 1.75rem;
		text-align: center;
		font-family: var(--serif);
		font-weight: 300;
		font-size: clamp(1.4rem, 2.6vw, 1.65rem);
		line-height: 1.5;
		letter-spacing: -0.01em;
		color: #26221d;
	}

	.ba-body {
		margin: 0;
		font-family: var(--sans);
		font-size: 1rem;
		line-height: 1.75;
		color: #5c554c;
	}

	.ba-inline-link {
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 2px;
		text-decoration-thickness: 1px;
	}

	/* ---- CTA ---- */
	.ba-cta {
		background: var(--paper);
		padding: 5rem 0;
		text-align: center;
	}

	.ba-cta-lede {
		margin: 0 0 2rem;
		font-family: var(--serif);
		font-weight: 300;
		font-style: italic;
		font-size: 1.5rem;
		color: #565049;
	}

	.ba-cta-actions {
		display: flex;
		gap: 0.875rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.ba-btn {
		display: inline-flex;
		align-items: center;
		padding: 0.85rem 1.6rem;
		font-family: var(--sans);
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		text-decoration: none;
		border-radius: 2px;
		transition:
			background-color 0.25s ease,
			color 0.25s ease,
			border-color 0.25s ease;
	}

	.ba-btn--solid {
		background: var(--ink);
		color: #faf9f6;
		border: 1px solid var(--ink);
	}

	.ba-btn--solid:hover {
		background: #000;
	}

	.ba-btn--ghost {
		background: transparent;
		color: var(--ink);
		border: 1px solid #cfc8bb;
	}

	.ba-btn--ghost:hover {
		border-color: var(--ink);
	}

	/* ---- Mobile ---- */
	@media (max-width: 767px) {
		.ba-shell {
			padding-left: 1.5rem;
			padding-right: 1.5rem;
		}

		.ba-hero {
			padding-top: 7rem;
		}

		.ba-pair-head {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.9rem;
			margin-bottom: 1.6rem;
		}

		.ba-index {
			font-size: 2.4rem;
		}

		.ba-images {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.ba-arrow {
			justify-self: center;
			margin-top: 0;
			margin-bottom: 0.1rem;
			width: 2.5rem;
			height: 2.5rem;
		}

		.ba-arrow svg {
			transform: rotate(90deg);
		}

		.ba-cap-src {
			white-space: normal;
		}
	}
</style>
