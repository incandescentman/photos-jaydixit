---
import MainLayout from '../layouts/MainLayout.astro';
import { Image, getImage } from 'astro:assets';
import vanessaBeforeImg from '../assets/images/wikiportraits/vanessa-kirby-before-2018.jpg';
import vanessaAfterImg from '../assets/images/wikiportraits/vanessa-kirby_tiff_2024.jpg';
import johnBeforeImg from '../assets/images/wikiportraits/john-hopfield-before-2016.jpg';
import johnAfterImg from '../assets/images/wikiportraits/john-hopfield_nobel-physics_2024.jpg';
import jeremyBeforeImg from '../assets/images/wikiportraits/jeremy-strong-before.jpg';
import jeremyAfterImg from '../assets/images/wikiportraits/jeremy-strong_the-apprentice-premiere_2024.jpg';
import conanBeforeImg from '../assets/images/wikiportraits/conan-obrien-before.jpg';
import conanAfterImg from '../assets/images/wikiportraits/conan-obrien_sundance_2024.jpg';

// Before/after pairs - Wikipedia portrait upgrades
const comparisons = [
	{
		name: 'Vanessa Kirby',
		beforeImage: vanessaBeforeImg,
		afterImage: vanessaAfterImg,
		article: 'https://en.wikipedia.org/wiki/Vanessa_Kirby',
		event: 'Toronto International Film Festival 2024',
	},
	{
		name: 'John Hopfield',
		beforeImage: johnBeforeImg,
		afterImage: johnAfterImg,
		article: 'https://en.wikipedia.org/wiki/John_Hopfield',
		event: 'Nobel Prize Lectures, Stockholm 2024',
	},
	{
		name: 'Jeremy Strong',
		beforeImage: jeremyBeforeImg,
		afterImage: jeremyAfterImg,
		article: 'https://en.wikipedia.org/wiki/Jeremy_Strong',
		event: 'BFI London Film Festival 2025',
	},
	{
		name: 'Conan O\'Brien',
		beforeImage: conanBeforeImg,
		afterImage: conanAfterImg,
		article: 'https://en.wikipedia.org/wiki/Conan_O%27Brien',
		event: 'Sundance Film Festival 2025',
	},
];

const comparisonsWithLightbox = await Promise.all(
	comparisons.map(async (comparison) => ({
		...comparison,
		beforeLightboxHref: (
			await getImage({ src: comparison.beforeImage, width: comparison.beforeImage.width, inferSize: true })
		).src,
		afterLightboxHref: (
			await getImage({ src: comparison.afterImage, width: comparison.afterImage.width, inferSize: true })
		).src,
	})),
);
---

<MainLayout
	title="Before & After"
	description="Wikipedia portrait upgrades: see the difference professional photography makes"
>
	<!-- Hero Section -->
	<section class="pt-32 md:pt-36 pb-12 bg-white">
		<div class="max-w-6xl mx-auto px-6">
			<h1 class="text-3xl md:text-4xl font-black text-gray-900 font-sans mb-4">Before & After</h1>
			<p class="text-xl text-gray-600 leading-relaxed font-sans max-w-4xl">
				Wikipedia deserves better photos. As a red carpet photographer for Wikipedia, I replace
				low-quality portraits with professional images shot at film festivals and cultural events.
			</p>
		</div>
	</section>

	<!-- Comparison Grid -->
	<section class="py-12 bg-white">
		<div id="before-after-gallery" class="max-w-6xl mx-auto px-6">
			{comparisons.length === 0 ? (
				<div class="text-center py-16 border-2 border-dashed border-gray-200 rounded-2xl">
					<p class="text-gray-500 text-lg font-sans">
						Comparisons coming soon. Add entries to the comparisons array in before-after.astro
					</p>
				</div>
			) : (
				<div class="space-y-16">
					{comparisonsWithLightbox.map((comparison) => (
						<article class="comparison-card">
							<div class="flex items-center justify-between mb-6">
								<div>
									<h2 class="text-2xl font-bold text-gray-900 font-sans">{comparison.name}</h2>
									{comparison.event && (
										<p class="text-gray-500 text-sm font-sans mt-1">{comparison.event}</p>
									)}
								</div>
								{comparison.article && (
									<a
										href={comparison.article}
										target="_blank"
										rel="noopener noreferrer"
										class="text-sm text-blue-600 hover:text-blue-800 font-sans flex items-center gap-1"
									>
										View on Wikipedia
										<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
										</svg>
									</a>
								)}
							</div>

							<div class="grid md:grid-cols-2 gap-6">
								<!-- Before -->
								<div class="relative">
									<span class="absolute top-4 left-4 bg-red-500/90 text-white text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full z-10">
										Before
									</span>
									<a
										href={comparison.beforeLightboxHref}
										class="portfolio-lightbox block aspect-[3/4] bg-gray-100 rounded-xl overflow-hidden"
										data-pswp-width={comparison.beforeImage.width}
										data-pswp-height={comparison.beforeImage.height}
										data-pswp-caption={`${comparison.name} - previous Wikipedia photo`}
									>
										<Image
											src={comparison.beforeImage}
											alt={`${comparison.name} - previous Wikipedia photo`}
											widths={[400, 800]}
											sizes="(min-width: 768px) 50vw, 100vw"
											class="w-full h-full object-cover object-top"
											loading="lazy"
										/>
									</a>
								</div>

								<!-- After -->
								<div class="relative">
									<span class="absolute top-4 left-4 bg-emerald-500/90 text-white text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full z-10">
										After
									</span>
									<a
										href={comparison.afterLightboxHref}
										class="portfolio-lightbox block aspect-[3/4] bg-gray-100 rounded-xl overflow-hidden"
										data-pswp-width={comparison.afterImage.width}
										data-pswp-height={comparison.afterImage.height}
										data-pswp-caption={`${comparison.name} - upgraded Wikipedia photo by Jay Dixit`}
									>
										<Image
											src={comparison.afterImage}
											alt={`${comparison.name} - upgraded Wikipedia photo by Jay Dixit`}
											widths={[400, 800]}
											sizes="(min-width: 768px) 50vw, 100vw"
											class="w-full h-full object-cover object-top"
											loading="lazy"
										/>
									</a>
								</div>
							</div>
						</article>
					))}
				</div>
			)}
		</div>
	</section>

	<!-- Context Section -->
	<section class="py-16 bg-neutral-50">
		<div class="max-w-4xl mx-auto px-6">
			<h2 class="text-2xl font-bold text-gray-900 font-sans mb-6">Why This Matters</h2>
			<div class="space-y-4 text-lg text-gray-600 font-sans leading-relaxed">
				<p>
					Wikipedia is one of the most visited websites in the world. For many people, it's the
					first place they go to learn about a person. The photo at the top of an article shapes
					how millions of people perceive that individual.
				</p>
				<p>
					Yet many Wikipedia articles feature outdated, poorly lit, or unflattering images. Some
					are cropped awkwardly from group shots. Others are grainy phone photos or stills from
					video interviews.
				</p>
				<p>
					Through the <a href="/blog/wikiportraits-story" class="text-blue-600 hover:underline">WikiPortraits initiative</a>,
					I'm working to change that—one portrait at a time.
				</p>
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="py-16 bg-white">
		<div class="max-w-4xl mx-auto px-6 text-center">
			<p class="text-xl text-gray-600 mb-8 font-sans">
				Want to see more of my work?
			</p>
			<div class="flex gap-4 justify-center flex-wrap">
				<a href="/gallery" class="px-6 py-3 bg-gray-900 text-white rounded-full font-semibold hover:bg-gray-800 transition-all duration-300">
					Browse Gallery
				</a>
				<a href="/about" class="px-6 py-3 border-2 border-gray-900 text-gray-900 rounded-full font-semibold hover:bg-gray-100 transition-all duration-300">
					About Me
				</a>
			</div>
		</div>
	</section>
</MainLayout>

<script hoist>
	import PhotoSwipeLightbox from 'photoswipe/lightbox';
	import 'photoswipe/style.css';

	const lightbox = new PhotoSwipeLightbox({
		gallery: '#before-after-gallery',
		children: '.portfolio-lightbox',
		pswpModule: () => import('photoswipe'),
		padding: { top: 20, bottom: 80, left: 20, right: 20 },
		wheelToZoom: true,
		imageClickAction: 'close',
		tapAction: 'toggle-controls',
		doubleTapAction: 'zoom',
		preloaderDelay: 0,
		showHideAnimationType: 'fade',
	});

	lightbox.addFilter('itemData', (itemData) => {
		const linkEl = itemData.element;
		if (!(linkEl instanceof HTMLElement)) return itemData;

		const width = parseInt(linkEl.getAttribute('data-pswp-width') || '', 10);
		const height = parseInt(linkEl.getAttribute('data-pswp-height') || '', 10);
		const caption = linkEl.getAttribute('data-pswp-caption') || '';

		if (Number.isFinite(width) && width > 0) itemData.w = width;
		if (Number.isFinite(height) && height > 0) itemData.h = height;
		if (caption) itemData.title = caption;

		return itemData;
	});

	lightbox.init();
</script>

<style>
	.comparison-card {
		padding-bottom: 3rem;
		border-bottom: 1px solid #e5e7eb;
	}

	.comparison-card:last-child {
		border-bottom: none;
		padding-bottom: 0;
	}
</style>
