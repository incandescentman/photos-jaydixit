---
import MainLayout from '../layouts/MainLayout.astro';
import { Image, getImage } from 'astro:assets';
import PhotoSwipeLightbox from '../components/PhotoSwipeLightbox.astro';
import vanessaBeforeImg from '../assets/images/wikiportraits/vanessa-kirby-before-2018.jpg';
import vanessaAfterImg from '../assets/images/wikiportraits/vanessa-kirby_tiff_2024.jpg';
import johnBeforeImg from '../assets/images/wikiportraits/john-hopfield-before-2016.jpg';
import johnAfterImg from '../assets/images/wikiportraits/john-hopfield_nobel-physics_2024.jpg';
import jeremyBeforeImg from '../assets/images/wikiportraits/jeremy-strong-before.jpg';
import jeremyAfterImg from '../assets/images/wikiportraits/jeremy-strong_the-apprentice-premiere_2024.jpg';
import conanBeforeImg from '../assets/images/wikiportraits/conan-obrien-before.jpg';
import conanAfterImg from '../assets/images/wikiportraits/conan-obrien_sundance_2024.jpg';
import sydneyBeforeImg from '../assets/images/wikiportraits/sydney-sweeney-before-2019.jpg';
import sydneyAfterImg from '../assets/images/wikiportraits/sydney-sweeney_tiff_2024.jpg';

// Before/after pairs - Wikipedia portrait upgrades
const comparisons = [
	{
		name: 'Vanessa Kirby',
		beforeImage: vanessaBeforeImg,
		afterImage: vanessaAfterImg,
		article: 'https://en.wikipedia.org/wiki/Vanessa_Kirby',
		event: 'Toronto International Film Festival 2024',
		beforeSource: 'Previous Wikipedia portrait, 2018',
		afterSource: 'Jay Dixit, Toronto International Film Festival 2024',
	},
	{
		name: 'John Hopfield',
		beforeImage: johnBeforeImg,
		afterImage: johnAfterImg,
		article: 'https://en.wikipedia.org/wiki/John_Hopfield',
		event: 'Nobel Prize Lectures, Stockholm 2024',
		beforeSource: 'Previous Wikipedia portrait, 2016',
		afterSource: 'Jay Dixit, Nobel Prize Lectures 2024',
	},
	{
		name: 'Jeremy Strong',
		beforeImage: jeremyBeforeImg,
		afterImage: jeremyAfterImg,
		article: 'https://en.wikipedia.org/wiki/Jeremy_Strong',
		event: 'BFI London Film Festival 2025',
		beforeSource: 'Previous Wikipedia portrait',
		afterSource: 'Jay Dixit, BFI London Film Festival 2025',
	},
	{
		name: "Conan O'Brien",
		beforeImage: conanBeforeImg,
		afterImage: conanAfterImg,
		article: 'https://en.wikipedia.org/wiki/Conan_O%27Brien',
		event: 'Sundance Film Festival 2025',
		beforeSource: 'Previous Wikipedia portrait',
		afterSource: 'Jay Dixit, Sundance Film Festival 2025',
	},
	{
		name: 'Sydney Sweeney',
		beforeImage: sydneyBeforeImg,
		afterImage: sydneyAfterImg,
		article: 'https://en.wikipedia.org/wiki/Sydney_Sweeney',
		event: 'Toronto International Film Festival 2024',
		beforeSource: 'Glenn Francis, 2019',
		afterSource: 'Jay Dixit, Toronto International Film Festival 2024',
	},
];

const comparisonsWithLightbox = await Promise.all(
	comparisons.map(async (comparison) => ({
		...comparison,
		beforeLightboxHref: (
			await getImage({
				src: comparison.beforeImage,
				width: comparison.beforeImage.width,
				inferSize: true,
			})
		).src,
		afterLightboxHref: (
			await getImage({
				src: comparison.afterImage,
				width: comparison.afterImage.width,
				inferSize: true,
			})
		).src,
	})),
);
---

<MainLayout
	title="Before & After"
	description="Wikipedia portrait upgrades: see the difference professional photography makes"
>
	<!-- Hero Section -->
	<section class="pt-32 md:pt-36 pb-10 bg-white">
		<div class="max-w-6xl mx-auto px-6">
			<h1 class="text-3xl md:text-4xl font-black text-gray-900 font-sans mb-4">Before & After</h1>
			<p class="text-lg md:text-xl text-gray-600 leading-relaxed font-sans max-w-3xl">
				Wikipedia deserves better photos. As a red carpet photographer for Wikipedia, I replace
				low-quality portraits with professional images shot at film festivals and cultural events.
			</p>
		</div>
	</section>

	<!-- Comparison Grid -->
	<section class="pt-8 pb-12 bg-white">
		<div id="before-after-gallery" class="max-w-6xl mx-auto px-6">
			{
				comparisons.length === 0 ? (
					<div class="text-center py-16 border-2 border-dashed border-gray-200 rounded-2xl">
						<p class="text-gray-500 text-lg font-sans">
							Comparisons coming soon. Add entries to the comparisons array in before-after.astro
						</p>
					</div>
				) : (
					<div class="comparison-list">
						{comparisonsWithLightbox.map((comparison) => (
							<article class="comparison-card">
								<header class="comparison-header">
									<div class="comparison-title-block">
										<p class="comparison-kicker">Wikipedia portrait upgrade</p>
										<h2 class="comparison-title">{comparison.name}</h2>
										{comparison.event && <p class="comparison-event">{comparison.event}</p>}
									</div>
									{comparison.article && (
										<a
											href={comparison.article}
											target="_blank"
											rel="noopener noreferrer"
											class="comparison-link"
										>
											View on Wikipedia
											<svg
												class="comparison-link-icon"
												fill="none"
												stroke="currentColor"
												viewBox="0 0 24 24"
											>
												<path
													stroke-linecap="round"
													stroke-linejoin="round"
													stroke-width="2"
													d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
												/>
											</svg>
										</a>
									)}
								</header>

								<div class="comparison-images">
									<figure class="comparison-figure">
										<div class="comparison-label-row">
											<span class="comparison-label">Before</span>
											<span class="comparison-source">{comparison.beforeSource}</span>
										</div>
										<a
											href={comparison.beforeLightboxHref}
											data-pswp-item="true"
											class="portfolio-lightbox comparison-frame"
											data-pswp-width={comparison.beforeImage.width}
											data-pswp-height={comparison.beforeImage.height}
											data-pswp-caption={`${comparison.name} - previous Wikipedia photo`}
											data-cropped="true"
										>
											<Image
												src={comparison.beforeImage}
												alt={`${comparison.name} - previous Wikipedia photo`}
												widths={[400, 800]}
												sizes="(min-width: 768px) 50vw, 100vw"
												class="comparison-image"
												loading="lazy"
											/>
										</a>
										<figcaption class="comparison-caption">
											Image previously used or available for the article.
										</figcaption>
									</figure>

									<figure class="comparison-figure">
										<div class="comparison-label-row">
											<span class="comparison-label">After</span>
											<span class="comparison-source">{comparison.afterSource}</span>
										</div>
										<a
											href={comparison.afterLightboxHref}
											data-pswp-item="true"
											class="portfolio-lightbox comparison-frame"
											data-pswp-width={comparison.afterImage.width}
											data-pswp-height={comparison.afterImage.height}
											data-pswp-caption={`${comparison.name} - upgraded Wikipedia photo by Jay Dixit`}
											data-cropped="true"
										>
											<Image
												src={comparison.afterImage}
												alt={`${comparison.name} - upgraded Wikipedia photo by Jay Dixit`}
												widths={[400, 800]}
												sizes="(min-width: 768px) 50vw, 100vw"
												class="comparison-image"
												loading="lazy"
											/>
										</a>
										<figcaption class="comparison-caption">
											Replacement portrait photographed for public encyclopedic use.
										</figcaption>
									</figure>
								</div>
							</article>
						))}
					</div>
				)
			}
		</div>
	</section>

	<!-- Context Section -->
	<section class="py-16 bg-neutral-50">
		<div class="max-w-4xl mx-auto px-6">
			<h2 class="text-2xl font-bold text-gray-900 font-sans mb-6">Why This Matters</h2>
			<div class="space-y-4 text-lg text-gray-600 font-sans leading-relaxed">
				<p>
					Wikipedia is one of the most visited websites in the world. For many people, it's the
					first place they go to learn about a person. The photo at the top of an article shapes how
					millions of people perceive that individual.
				</p>
				<p>
					Yet many Wikipedia articles feature outdated, poorly lit, or unflattering images. Some are
					cropped awkwardly from group shots. Others are grainy phone photos or stills from video
					interviews.
				</p>
				<p>
					Through the <a href="/blog/wikiportraits-story" class="text-blue-600 hover:underline"
						>WikiPortraits initiative</a
					>, I'm working to change that—one portrait at a time.
				</p>
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="py-16 bg-white">
		<div class="max-w-4xl mx-auto px-6 text-center">
			<p class="text-xl text-gray-600 mb-8 font-sans">Want to see more of my work?</p>
			<div class="flex gap-4 justify-center flex-wrap">
				<a
					href="/gallery"
					class="px-6 py-3 bg-gray-900 text-white rounded-full font-semibold hover:bg-gray-800 transition-all duration-300"
				>
					Browse Gallery
				</a>
				<a
					href="/about"
					class="px-6 py-3 border-2 border-gray-900 text-gray-900 rounded-full font-semibold hover:bg-gray-100 transition-all duration-300"
				>
					About Me
				</a>
			</div>
		</div>
	</section>
</MainLayout>

<PhotoSwipeLightbox
	gallerySelector="#before-after-gallery"
	childrenSelector="a[data-pswp-item]"
	options={{
		padding: { top: 20, bottom: 80, left: 20, right: 20 },
		wheelToZoom: true,
		preloaderDelay: 0,
		showHideAnimationType: 'fade',
	}}
/>

<style>
	.comparison-list {
		display: grid;
		gap: 2.75rem;
	}

	.comparison-card {
		padding-bottom: 2.75rem;
		border-bottom: 1px solid #e7e5e4;
	}

	.comparison-card:last-child {
		border-bottom: none;
		padding-bottom: 0;
	}

	.comparison-header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1.5rem;
		margin-bottom: 1.25rem;
	}

	.comparison-title-block {
		min-width: 0;
	}

	.comparison-kicker {
		margin-bottom: 0.35rem;
		font-family:
			system-ui,
			-apple-system,
			'Segoe UI',
			sans-serif;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #78716c;
	}

	.comparison-title {
		font-family:
			system-ui,
			-apple-system,
			'Segoe UI',
			sans-serif;
		font-size: clamp(1.45rem, 2.2vw, 2rem);
		font-weight: 800;
		line-height: 1.08;
		color: #111827;
	}

	.comparison-event {
		margin-top: 0.45rem;
		font-family:
			system-ui,
			-apple-system,
			'Segoe UI',
			sans-serif;
		font-size: 0.92rem;
		color: #57534e;
	}

	.comparison-link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		flex-shrink: 0;
		border-bottom: 1px solid #a8a29e;
		padding-bottom: 0.1rem;
		font-family:
			system-ui,
			-apple-system,
			'Segoe UI',
			sans-serif;
		font-size: 0.88rem;
		font-weight: 600;
		color: #292524;
		transition:
			border-color 160ms ease,
			color 160ms ease;
	}

	.comparison-link:hover {
		border-color: #1d4ed8;
		color: #1d4ed8;
	}

	.comparison-link-icon {
		width: 1rem;
		height: 1rem;
	}

	.comparison-images {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.comparison-figure {
		margin: 0;
	}

	.comparison-label-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		min-height: 1.45rem;
		margin-bottom: 0.5rem;
	}

	.comparison-label {
		font-family:
			system-ui,
			-apple-system,
			'Segoe UI',
			sans-serif;
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: #1c1917;
	}

	.comparison-source {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		font-family:
			system-ui,
			-apple-system,
			'Segoe UI',
			sans-serif;
		font-size: 0.78rem;
		color: #78716c;
	}

	.comparison-frame {
		display: block;
		aspect-ratio: 3 / 4;
		overflow: hidden;
		border-radius: 6px;
		background: #f5f5f4;
		box-shadow: inset 0 0 0 1px rgba(41, 37, 36, 0.08);
	}

	.comparison-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
	}

	.comparison-caption {
		margin-top: 0.55rem;
		font-family:
			system-ui,
			-apple-system,
			'Segoe UI',
			sans-serif;
		font-size: 0.78rem;
		line-height: 1.45;
		color: #78716c;
	}

	@media (max-width: 767px) {
		.comparison-header {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.8rem;
			margin-bottom: 1rem;
		}

		.comparison-images {
			grid-template-columns: 1fr;
			gap: 1.25rem;
		}

		.comparison-source {
			white-space: normal;
			text-align: right;
		}
	}
</style>
