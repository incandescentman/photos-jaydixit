---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro:assets';
import MainLayout from '../../layouts/MainLayout.astro';
import siteConfig from '../../../site.config.mts';
import rawPeople from '../../data/people.json';

interface Person {
	slug: string;
	name: string;
	match: string[];
	bio?: string;
	wikipedia?: string;
}

const people = rawPeople as Person[];

const { person } = Astro.params;

const personData = people.find((p) => p.slug === person);
if (!personData) {
	return Astro.redirect('/404');
}

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
	'../../gallery/photos/**/*.{jpg,jpeg,png,webp,gif}',
	{ eager: true },
);

function capitalize(word: string) {
	return word.charAt(0).toUpperCase() + word.slice(1);
}

function getSubjectSlug(filename: string): string {
	const baseName = filename.replace(/\.[^/.]+$/, '');
	return baseName.split('_')[0];
}

function matchesPerson(subjectSlug: string, patterns: string[]): boolean {
	return patterns.some((pattern) => {
		if (subjectSlug === pattern) return true;
		if (subjectSlug.startsWith(pattern + '-')) {
			const suffix = subjectSlug.slice(pattern.length + 1);
			return /^\d+$/.test(suffix);
		}
		return false;
	});
}

function buildCaption(filename: string) {
	const baseName = filename.replace(/\.[^/.]+$/, '');
	const parts = baseName.split('_');
	let subject = '';
	let event = '';
	let year = '';

	if (parts.length > 0) {
		subject = parts[0].split('-').map(capitalize).join(' ');
	}

	if (parts.length > 1) {
		const lastPart = parts[parts.length - 1];
		if (/^\d{4}$/.test(lastPart)) {
			year = lastPart;
			if (parts.length > 2) {
				event = parts
					.slice(1, -1)
					.join(' ')
					.split('-')
					.map(capitalize)
					.join(' ');
			}
		} else {
			event = parts
				.slice(1)
				.join(' ')
				.split('-')
				.map(capitalize)
				.join(' ');
		}
	}

	let caption = subject;
	if (event) caption += ` at ${event}`;
	if (year) caption += ` in ${year}`;
	if (!caption) {
		caption = subject || baseName.replace(/[-_]/g, ' ');
	}

	return caption;
}

function toPhotoHref(folderSlug: string, file: string) {
	const slug = file.replace(/\.[^/.]+$/, '');
	const encodedPath = [...folderSlug.split('/'), slug].map(encodeURIComponent).join('/');
	return `/gallery/photo/${encodedPath}`;
}

const extensionPriority = ['jpg', 'jpeg', 'webp', 'png', 'gif'];

function extensionRank(file: string) {
	const ext = file.split('.').pop()?.toLowerCase() ?? '';
	const rank = extensionPriority.indexOf(ext);
	return rank === -1 ? extensionPriority.length : rank;
}

type PhotoEntry = {
	metadata: ImageMetadata;
	filename: string;
	folder: string;
	slug: string;
	caption: string;
	galleryName: string;
	originalSrc: string;
	detailHref: string;
};

const allMatches: PhotoEntry[] = Object.entries(imageModules)
	.map(([key, module]) => {
		const metadata = module.default;
		const relativePath = key.replace('../../gallery/photos/', '');
		const segments = relativePath.split('/');
		const filename = segments.pop();
		if (!filename) return null;
		const folder = segments.join('/');
		const subjectSlug = getSubjectSlug(filename);

		if (!matchesPerson(subjectSlug, personData.match)) return null;

		const slug = filename.replace(/\.[^/.]+$/, '');
		const caption = buildCaption(filename);
		const galleryName = folder
			.split('/')
			.map((part) => part.split('-').map(capitalize).join(' '))
			.join(' / ');

		return {
			metadata,
			filename,
			folder,
			slug,
			caption,
			galleryName,
			originalSrc: metadata.src,
			detailHref: toPhotoHref(folder, filename),
		};
	})
	.filter((entry): entry is PhotoEntry => entry !== null);

const grouped = allMatches.reduce<Record<string, PhotoEntry[]>>((acc, photo) => {
	const key = `${photo.folder}/${photo.slug}`;
	if (!acc[key]) acc[key] = [];
	acc[key].push(photo);
	return acc;
}, {});

const photos = Object.values(grouped)
	.map((variants) => variants.sort((a, b) => extensionRank(a.filename) - extensionRank(b.filename))[0])
	.sort((a, b) => a.filename.localeCompare(b.filename));

if (photos.length === 0) {
	return Astro.redirect('/404');
}

const siteUrl = Astro.site?.origin ?? siteConfig.siteUrl ?? 'https://photos.jaydixit.com';
const canonicalUrl = new URL(`/portraits/${personData.slug}`, siteUrl).toString();
const pageTitle = `${personData.name} — Portraits`;
const pageDescription = personData.bio
	? `${personData.bio}. ${photos.length} ${photos.length === 1 ? 'photo' : 'photos'} by ${siteConfig.owner}.`
	: `${photos.length} ${photos.length === 1 ? 'photo' : 'photos'} of ${personData.name} by ${siteConfig.owner}.`;
const primaryImage = photos[0]?.originalSrc;

const breadcrumbs = [
	{ name: 'Home', url: '/' },
	{ name: 'Portraits', url: '/portraits' },
	{ name: personData.name, url: `/portraits/${personData.slug}` },
];

const personStructuredData = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: `${personData.name} — ${siteConfig.owner}`,
	description: pageDescription,
	url: canonicalUrl,
	about: {
		'@type': 'Person',
		name: personData.name,
		...(personData.wikipedia ? { sameAs: personData.wikipedia } : {}),
	},
	creator: { '@type': 'Person', name: siteConfig.owner },
	image: photos.map((p) => new URL(p.originalSrc, siteUrl).toString()),
};

const breadcrumbStructuredData = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: breadcrumbs.map((crumb, index) => ({
		'@type': 'ListItem',
		position: index + 1,
		name: crumb.name,
		item: new URL(crumb.url, siteUrl).toString(),
	})),
};

export function getStaticPaths() {
	return (rawPeople as Person[]).map((p) => ({ params: { person: p.slug } }));
}
---

<MainLayout
	title={pageTitle}
	description={pageDescription}
	canonical={canonicalUrl}
	image={primaryImage}
	imageAlt={`Portrait of ${personData.name}`}
	structuredData={[personStructuredData, breadcrumbStructuredData]}
>
	<section class="py-16 pt-24">
		<div class="container mx-auto px-4 max-w-7xl">
			<nav aria-label="Breadcrumb" class="mb-6">
				<ol class="flex flex-wrap items-center gap-2 text-sm text-gray-500">
					{
						breadcrumbs.map((crumb, index) => (
							<li class="inline-flex items-center gap-2">
								{index > 0 && <span aria-hidden="true">/</span>}
								{index === breadcrumbs.length - 1 ? (
									<span class="text-gray-700">{crumb.name}</span>
								) : (
									<a href={crumb.url} class="hover:text-gray-900 hover:underline">
										{crumb.name}
									</a>
								)}
							</li>
						))
					}
				</ol>
			</nav>

			<header class="mb-10 text-center">
				<h1 class="text-3xl md:text-4xl font-bold mb-2">{personData.name}</h1>
				{personData.bio && <p class="text-gray-600 max-w-xl mx-auto mb-3">{personData.bio}</p>}
				<p class="text-gray-500 text-sm">
					{photos.length} {photos.length === 1 ? 'photo' : 'photos'}
				</p>
				{
					personData.wikipedia && (
						<a
							href={personData.wikipedia}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-block mt-2 text-sm text-blue-600 hover:text-blue-800 hover:underline"
						>
							Wikipedia &rarr;
						</a>
					)
				}
			</header>

			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
				{
					photos.map((photo) => (
						<a href={photo.detailHref} class="group block">
							<div class="aspect-[3/4] overflow-hidden rounded-xl bg-gray-100 shadow-sm">
								<Image
									src={photo.metadata}
									alt={photo.caption}
									width={480}
									height={640}
									fit="cover"
									position="attention"
									loading="lazy"
									class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
								/>
							</div>
							<div class="mt-3 px-1">
								<p class="text-sm font-medium text-gray-800 group-hover:text-gray-900">
									{photo.caption}
								</p>
								<p class="text-xs text-gray-400 mt-0.5">{photo.galleryName}</p>
							</div>
						</a>
					))
				}
			</div>
		</div>
	</section>
</MainLayout>
