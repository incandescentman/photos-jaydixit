---
import { Image } from 'astro:assets';
import MainLayout from '../layouts/MainLayout.astro';
import quotePhoto from '../assets/images/about/jay-dixit_2024-10-04_telos_ryan-jina-jess_wong-kar-wai_05420.jpg';
---

<MainLayout>
	<div class="ed">
		<!-- Hero -->
		<section class="ed-hero">
			<div class="ed-shell ed-shell--hero">
				<header class="ed-hero-heading">
					<p class="ed-kicker eyebrow">About</p>
					<h1 class="ed-h1"><span>Why I Take</span><span>Photos</span></h1>
				</header>
				<div class="ed-hero-media">
					<img
						src="/images/jay-anisha-williamsburg_jay-dixit-photos_lighter.jpg"
						alt="Jay Dixit"
						class="ed-hero-img"
					/>
				</div>
				<div class="ed-lead">
					<p>
						I&rsquo;m a red carpet photographer for Wikipedia and the first photographer of the
						WikiPortraits initiative founded by Jennifer 8. Lee and Kevin Payravi. I&rsquo;ve
						covered the Nobel Prizes in Stockholm and Oslo, Sundance, SXSW, the Toronto
						International Film Festival, the New York Film Festival, and cultural events in New
						York, San Francisco, and Toronto.
					</p>
					<p>
						I&rsquo;m also a writer, writing professor, and AI educator. I taught storytelling at
						Yale. My work has appeared in The New York Times, Rolling Stone, The Washington Post,
						Wired, Harvard Business Review, and Psychology Today, where I was a senior editor. Most
						recently I worked at OpenAI, where I led the writing community.
					</p>
				</div>
			</div>
		</section>

		<!-- Personal essay -->
		<section class="ed-section ed-essay-section">
			<div class="ed-shell ed-shell--essay">
				<div class="ed-essay-opening">
					<p>As a writer, I relate to the world through words, stories, and ideas.</p>
					<p>But writing is static: It&rsquo;s sitting at a desk typing sentences on a screen.</p>
				</div>

				<div class="ed-essay-main">
					<div class="ed-essay">
						<p>
							Photography, on the other hand, is embodied, visceral, spontaneous. After a day of
							staring at my screen until the words swim, I love how different it feels to grab my
							camera and start moving.
						</p>
						<p>
							With photography, particularly red carpet photography, I find myself huddling in the
							photo pit, crouching to get a better angle, literally running after a movie star
							calling her name, desperately trying to get her to turn around and look at my lens so
							I can get the shot.
						</p>
						<p>
							It&rsquo;s physical and chaotic and exhausting. Sometimes it almost feels like being a
							sniper, braced and still, peering through a long lens, waiting and breathing, finger
							on the shutter ready to fire the second the movie star looks your way.
						</p>
						<p>
							Like writing, photography is all craft and strategy. It&rsquo;s about making
							decisions, working hard to make it good. But I feel like I&rsquo;m using an entirely
							different part of my brain.
						</p>
						<p>
							It&rsquo;s also immediate gratification. If I write an article for a magazine, I
							miiight get an email weeks later when it&rsquo;s finally published. More likely I
							never hear about it again. But when I take a photo of someone, I can show it to them
							then and there. And if I&rsquo;m lucky they might even light up and say, &ldquo;Oh my
							god, I love it, wow you totally captured my personality!&rdquo;
						</p>
						<p>
							It&rsquo;s making someone feel seen, showing them the thing in the same moment the
							thing is created. That never happens with writing.
						</p>
					</div>
				</div>

				<nav class="ed-link-list ed-link-list--essay" aria-label="More about Jay">
					<a class="ed-link" href="https://jaydixit.com" target="_blank" rel="noopener noreferrer">
						<span>Visit jaydixit.com</span>
						<svg viewBox="0 0 36 14" aria-hidden="true">
							<path d="M1 7h32M27 1l6 6-6 6"></path>
						</svg>
					</a>
					<a
						class="ed-link"
						href="https://socraticai.co/"
						target="_blank"
						rel="noopener noreferrer"
					>
						<span>Socratic AI</span>
						<svg viewBox="0 0 36 14" aria-hidden="true">
							<path d="M1 7h32M27 1l6 6-6 6"></path>
						</svg>
					</a>
					<a class="ed-link" href="/contact">
						<span>Get in Touch</span>
						<svg class="ed-link-envelope" viewBox="0 0 26 20" aria-hidden="true">
							<rect x="1" y="1" width="24" height="18" rx="1.5"></rect>
							<path d="m2 3 11 8 11-8"></path>
						</svg>
					</a>
				</nav>
			</div>
		</section>

		<!-- Philosophy quote -->
		<section class="ed-section ed-quote-section">
			<div class="ed-shell ed-shell--quote">
				<div class="ed-quote">
					<figure class="ed-quote-photo">
						<div class="ed-quote-photo-frame">
							<Image
								src={quotePhoto}
								alt="A woman smiling in red light"
								widths={[500, 900, 1200]}
								sizes="(max-width: 900px) 100vw, 46vw"
								loading="lazy"
							/>
						</div>
						<figcaption class="ed-quote-caption">
							Catching Jina in an unguarded moment at the Wong Kar-wai party in Bushwick
						</figcaption>
					</figure>
					<div class="ed-quote-rule" aria-hidden="true"></div>
					<div class="ed-quote-copy">
						<blockquote class="ed-quote-text">
							&ldquo;The feeling I&rsquo;m chasing is that moment when I show someone a photo I just
							took and they say, &lsquo;Oh my God, I love this picture of me, you really captured
							who I am!&rsquo;&rdquo;
						</blockquote>
						<div class="ed-quote-cite">
							<span class="ed-quote-dash" aria-hidden="true"></span>
							<cite>Jay Dixit</cite>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Contact CTA -->
		<section class="ed-section">
			<div class="ed-shell ed-shell--cta ed-center">
				<p class="ed-cta-text">
					Most people land here looking for my photos. But I also teach AI workshops, write, and do
					consulting. If you want to talk about photography, writing, or what AI can actually do for
					your team, I&rsquo;d love to hear from you.
				</p>
				<div class="ed-cta-routes">
					<p class="ed-cta-route">
						My AI work lives at
						<a href="https://socraticai.co/" target="_blank" rel="noopener noreferrer"
							>socraticai.co</a
						>.
					</p>
					<p class="ed-cta-route">
						My storytelling and writing workshops are at
						<a href="https://storytelling.nyc/" target="_blank" rel="noopener noreferrer"
							>storytelling.nyc</a
						>.
					</p>
					<p class="ed-cta-route">
						And my personal website is at
						<a href="https://jaydixit.com/" target="_blank" rel="noopener noreferrer"
							>jaydixit.com</a
						>.
					</p>
				</div>
				<div class="ed-actions ed-actions--center">
					<a href="/contact" class="ed-btn ed-btn--solid">Get In Touch</a>
					<a href="/gallery" class="ed-btn ed-btn--ghost">View Portfolio</a>
				</div>
			</div>
		</section>
	</div>
</MainLayout>

<style>
	.ed {
		background: var(--paper);
	}

	.ed-shell {
		max-width: 48rem;
		margin: 0 auto;
		padding: 0 2.5rem;
	}

	.ed-shell--hero {
		display: grid;
		grid-template-columns: minmax(20rem, 0.82fr) minmax(0, 1.25fr);
		grid-template-areas:
			'heading media'
			'lead media';
		column-gap: clamp(3rem, 5vw, 8rem);
		row-gap: clamp(3rem, 4vw, 5rem);
		max-width: none;
		padding-inline: clamp(1.5rem, 4vw, 5rem);
	}

	.ed-shell--narrow {
		max-width: 46rem;
	}

	.ed-shell--cta {
		max-width: 58rem;
	}

	.ed-shell--quote {
		max-width: none;
		padding-inline: clamp(1.5rem, 4vw, 5rem);
	}

	.ed-center {
		text-align: center;
	}

	/* Hero */
	.ed-hero {
		padding: var(--nav-clearance) 0 clamp(5rem, 7vw, 8rem);
		border-bottom: 1px solid var(--hairline);
	}

	.ed-hero-heading {
		grid-area: heading;
		align-self: end;
	}

	.ed-kicker {
		margin: 0 0 1.5rem;
	}

	.ed-h1 {
		margin: 0;
		font-family: var(--serif);
		font-weight: 300;
		font-size: clamp(3.6rem, 6vw, 7.5rem);
		line-height: 0.9;
		letter-spacing: -0.025em;
		color: #161310;
	}

	.ed-h1 span {
		display: block;
	}

	.ed-hero-media {
		grid-area: media;
		align-self: center;
		box-shadow: 0 28px 80px rgb(63 34 20 / 14%);
	}

	.ed-hero-img {
		display: block;
		width: 100%;
		height: auto;
	}

	/* Sections */
	.ed-section {
		padding: 5.5rem 0;
	}

	/* Lead */
	.ed-lead {
		grid-area: lead;
		display: grid;
		gap: 1.35rem;
		align-self: start;
		padding-top: 2rem;
		border-top: 1px solid var(--hairline);
	}

	.ed-lead p {
		margin: 0;
		font-family: var(--serif);
		font-weight: 300;
		font-size: clamp(1.25rem, 1.5vw, 1.65rem);
		line-height: 1.45;
		letter-spacing: -0.01em;
		color: #2a2620;
	}

	.ed-essay-section {
		padding: clamp(6rem, 9vw, 10rem) 0;
	}

	.ed-shell--essay {
		display: grid;
		grid-template-columns: minmax(20rem, 0.8fr) minmax(30rem, 1fr);
		gap: 0;
		max-width: 112rem;
		padding-inline: clamp(1.5rem, 4vw, 5rem);
	}

	.ed-essay-opening {
		display: grid;
		gap: clamp(1.75rem, 3vw, 3.5rem);
		align-content: start;
		padding-right: clamp(3rem, 6vw, 8rem);
	}

	.ed-essay-opening p {
		margin: 0;
		font-family: var(--serif);
		font-size: clamp(2.5rem, 3.6vw, 4.75rem);
		font-weight: 300;
		line-height: 1.08;
		letter-spacing: -0.025em;
		color: #1c1813;
	}

	.ed-essay-main {
		padding-left: clamp(3rem, 6vw, 8rem);
		border-left: 1px solid #cfc6b3;
	}

	/* Essay */
	.ed-essay {
		display: grid;
		gap: 1.75rem;
		max-width: 44rem;
	}

	.ed-essay p {
		margin: 0;
		font-family: var(--serif);
		font-weight: 300;
		font-size: clamp(1.35rem, 1.45vw, 1.75rem);
		line-height: 1.48;
		color: #3a352e;
	}

	/* Editorial links */
	.ed-link-list {
		display: grid;
		width: min(100%, 32rem);
		margin-top: 3rem;
		border-top: 1px solid var(--ink);
	}

	.ed-link-list--essay {
		grid-column: 1 / -1;
		justify-self: center;
		margin-top: clamp(4.5rem, 7vw, 7rem);
	}

	.ed-link {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		min-height: 59px;
		padding: 0 2px;
		border-bottom: 1px solid var(--hairline);
		color: var(--ink);
		font-family: var(--serif);
		font-size: clamp(1.0625rem, 1.15vw, 1.3125rem);
		font-weight: 400;
		letter-spacing: -0.012em;
		text-decoration: none;
		transition: padding 220ms ease;
	}

	.ed-link svg {
		width: 34px;
		flex: none;
		overflow: visible;
		fill: none;
		stroke: var(--accent);
		stroke-width: 1.3;
		transition: transform 240ms ease;
	}

	.ed-link .ed-link-envelope {
		width: 26px;
		margin-right: 4px;
	}

	.ed-link:hover,
	.ed-link:focus-visible {
		padding-left: 8px;
	}

	.ed-link:hover svg,
	.ed-link:focus-visible svg {
		transform: translateX(5px);
	}

	/* Buttons */
	.ed-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.875rem;
		margin-top: 3rem;
	}

	.ed-actions--center {
		justify-content: center;
		margin-top: 2.5rem;
	}

	.ed-btn {
		display: inline-flex;
		align-items: center;
		padding: 0.85rem 1.7rem;
		font-family: var(--sans);
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		text-decoration: none;
		border-radius: 2px;
		transition:
			background-color 0.25s ease,
			color 0.25s ease,
			border-color 0.25s ease;
	}

	.ed-btn--solid {
		background: var(--ink);
		color: #faf9f6;
		border: 1px solid var(--ink);
	}

	.ed-btn--solid:hover {
		background: #000;
	}

	.ed-btn--ghost {
		background: transparent;
		color: var(--ink);
		border: 1px solid #cfc8bb;
	}

	.ed-btn--ghost:hover {
		border-color: var(--ink);
	}

	/* Philosophy quote */
	.ed-quote-section {
		background: var(--paper-deep);
		border-top: 1px solid var(--hairline);
		border-bottom: 1px solid var(--hairline);
		padding: 7rem 0;
	}

	.ed-quote {
		display: grid;
		grid-template-columns: minmax(0, 1.12fr) 1px minmax(0, 0.88fr);
		gap: clamp(2.5rem, 3vw, 4.5rem);
		align-items: center;
	}

	.ed-quote-photo {
		margin: 0;
	}

	.ed-quote-photo-frame {
		overflow: hidden;
		background: #a93225;
		box-shadow: 0 24px 60px rgb(63 34 20 / 16%);
	}

	.ed-quote-photo-frame :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}

	.ed-quote-caption {
		display: block;
		margin: 1rem 0 0;
		padding: 0 0.75rem;
		font-family: var(--serif);
		font-size: clamp(1rem, 1vw, 1.25rem);
		font-weight: 400;
		line-height: 1.4;
		letter-spacing: 0;
		color: #5c554c;
	}

	.ed-quote-rule {
		width: 1px;
		height: min(22rem, 76%);
		background: #cfc6b3;
	}

	.ed-quote-text {
		margin: 0 0 2rem;
		font-family: var(--serif);
		font-weight: 300;
		font-style: italic;
		font-size: clamp(2.1rem, 4vw, 4.5rem);
		line-height: 1.25;
		letter-spacing: -0.015em;
		color: #1c1813;
	}

	.ed-quote-cite {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.ed-quote-dash {
		width: 2rem;
		height: 1px;
		background: #a89e8a;
	}

	.ed-quote-cite cite {
		font-family: var(--sans);
		font-style: normal;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: #6e675c;
	}

	/* Contact CTA */
	.ed-cta-text {
		max-width: 41rem;
		margin: 0 auto;
		font-family: var(--serif);
		font-weight: 300;
		font-size: clamp(1.6rem, 3.2vw, 2.25rem);
		line-height: 1.35;
		letter-spacing: -0.01em;
		color: #2a2620;
	}

	.ed-cta-routes {
		display: grid;
		gap: 1rem;
		width: fit-content;
		max-width: 100%;
		margin: 2.75rem auto 0;
		text-align: left;
	}

	.ed-cta-route {
		margin: 0;
		font-family: var(--serif);
		font-size: clamp(1.35rem, 1.6vw, 1.65rem);
		line-height: 1.5;
		color: #5c554c;
	}

	.ed-cta-route a {
		color: var(--ink);
		font-weight: 600;
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.24em;
	}

	/* Responsive */
	@media (max-width: 900px) {
		.ed-shell--hero {
			grid-template-columns: 1fr;
			grid-template-areas:
				'heading'
				'media'
				'lead';
			gap: 3rem;
		}

		.ed-hero-heading,
		.ed-hero-media,
		.ed-lead {
			width: min(100%, 46rem);
			margin-inline: auto;
		}

		.ed-shell--essay {
			grid-template-columns: 1fr;
			gap: 3rem;
			width: min(100%, 46rem);
			padding-inline: 2.5rem;
		}

		.ed-essay-opening {
			padding-right: 0;
		}

		.ed-essay-main {
			padding: 3rem 0 0;
			border-top: 1px solid #cfc6b3;
			border-left: 0;
		}

		.ed-link-list--essay {
			margin-top: 0;
		}

		.ed-quote {
			grid-template-columns: 1fr;
			gap: 3rem;
		}

		.ed-quote-photo,
		.ed-quote-copy {
			width: min(100%, 46rem);
			margin-inline: auto;
		}

		.ed-quote-rule {
			display: none;
		}
	}

	@media (max-width: 767px) {
		.ed-shell,
		.ed-shell--narrow {
			padding: 0 1.5rem;
		}

		.ed-hero {
			padding-bottom: 4.5rem;
		}

		.ed-shell--hero {
			gap: 2.5rem;
			padding-inline: 1.5rem;
		}

		.ed-shell--essay {
			padding-inline: 1.5rem;
		}

		.ed-essay-opening p {
			font-size: clamp(2.4rem, 11vw, 3.5rem);
		}

		.ed-lead p {
			font-size: 1.3rem;
		}

		.ed-essay p {
			font-size: 1.3rem;
		}

		.ed-quote {
			gap: 2.5rem;
		}
	}
</style>
