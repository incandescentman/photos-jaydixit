---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout>
	<!-- Hero Section -->
	<section class="pt-16 bg-white">
		<div class="max-w-4xl mx-auto px-6">
			<h1 class="text-3xl md:text-4xl font-black text-gray-900 font-sans mb-2">Jay Dixit</h1>
			<p class="text-lg text-gray-600 mb-8 font-sans">Photographer • Writer • AI Educator</p>
			<img
				src="/images/jay-anisha-williamsburg_jay-dixit-photos_lighter.jpg"
				alt="Jay Dixit"
				class="w-full rounded-2xl shadow-xl"
			/>
		</div>
	</section>

	<!-- Introduction Section -->
	<section class="py-16 bg-white">
		<div class="max-w-4xl mx-auto px-6">
			<h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-8 leading-tight font-sans">
				Capturing Authentic Moments & Telling Compelling Stories
			</h2>
			<div class="prose prose-xl max-w-none">
				<p class="text-xl text-gray-600 leading-relaxed font-sans mb-4">
					Hi, I'm Jay Dixit, a writer, educator, and red carpet photographer.
					As a photographer, my goal is to capture natural, spontaneous moments — those raw, unguarded glimpses of laughter, joy, or surprise that reveal someone's personality in a single frame.
				</p>
				<p class="text-xl text-gray-600 leading-relaxed font-sans mb-4">
					As a press photographer for Wikipedia, I've covered The Nobel Prizes in Stockholm and The Nobel Peace Prize in Oslo, red carpets at Sundance, SXSW, the Toronto International Film Festival, and the New York Film Festival, as well as cultural and literary events in New York, San Francisco, and Toronto.
				</p>
				<p class="text-xl text-gray-600 leading-relaxed font-sans mb-4">
					I was the founding photographer of the WikiPortraits initiative and I contribute actively to Wikimedia Commons, where I help expand the public archive of high-quality images from diverse voices and communities.
				</p>
				<p class="text-xl text-gray-600 leading-relaxed font-sans mb-4">
					In my parallel life as a writer, writing professor, and AI educator, I specialize in storytelling, psychology, and the ethical use of AI to amplify human creativity. I taught storytelling as a writing professor at Yale, and my work has appeared in The New York Times, Rolling Stone, The Washington Post, Wired, Harvard Business Review, and Psychology Today, where I was a senior editor.
				</p>
				<p class="text-xl text-gray-600 leading-relaxed font-sans mb-8">
					Through my company Socratic AI, I lead AI education workshops and training programs for universities and companies. Most recently, I worked at OpenAI, where I led the writing community, spearheading initiatives to help writers and educators use AI as a thought partner to support the writing process.
				</p>
			</div>
			<div class="flex gap-4">
				<a href="#photography" class="px-6 py-3 bg-gray-900 text-white rounded-full font-semibold hover:bg-gray-800 transition-all duration-300">
					View My Work
				</a>
				<a href="mailto:jay@jaydixit.com" class="px-6 py-3 border-2 border-gray-900 text-gray-900 rounded-full font-semibold hover:bg-gray-100 transition-all duration-300">
					Get In Touch
				</a>
			</div>
		</div>
	</section>

	<!-- Photography Section -->
	<section id="photography" class="py-24 bg-white">
		<div class="max-w-7xl mx-auto px-6">
			<div class="text-center mb-16">
				<h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4 font-sans">Photography</h2>
				<p class="text-xl text-gray-600 max-w-3xl mx-auto font-sans">
					Focusing on spontaneous, natural moments that reveal personality
				</p>
			</div>

			<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
				<a href="/gallery" class="block border border-gray-200 rounded-xl p-6 hover:border-gray-400 hover:shadow-md transition-all duration-200">
					<h3 class="text-lg font-bold text-gray-900 mb-2 font-sans">Wikipedia Press</h3>
					<p class="text-gray-600 text-sm font-sans">Contributing high-quality portraits to improve Wikipedia</p>
				</a>

				<a href="/gallery/events/nobel" class="block border border-gray-200 rounded-xl p-6 hover:border-gray-400 hover:shadow-md transition-all duration-200">
					<h3 class="text-lg font-bold text-gray-900 mb-2 font-sans">Nobel Prizes</h3>
					<p class="text-gray-600 text-sm font-sans">Documenting laureates in Stockholm and Oslo</p>
				</a>

				<a href="/gallery/red-carpet" class="block border border-gray-200 rounded-xl p-6 hover:border-gray-400 hover:shadow-md transition-all duration-200">
					<h3 class="text-lg font-bold text-gray-900 mb-2 font-sans">Film Festivals</h3>
					<p class="text-gray-600 text-sm font-sans">Red carpet coverage at Sundance, SXSW, TIFF</p>
				</a>

				<a href="/blog/wikiportraits-story" class="block border border-gray-200 rounded-xl p-6 hover:border-gray-400 hover:shadow-md transition-all duration-200">
					<h3 class="text-lg font-bold text-gray-900 mb-2 font-sans">WikiPortraits</h3>
					<p class="text-gray-600 text-sm font-sans">Founded initiative fixing Wikipedia's celebrity portraits</p>
				</a>
			</div>
		</div>
	</section>

	<!-- Writing & Teaching Section -->
	<section class="py-24 bg-gradient-to-r from-gray-50 to-gray-100">
		<div class="max-w-7xl mx-auto px-6">
			<div class="grid lg:grid-cols-2 gap-16 items-center">
				<div>
					<h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6 font-sans">Writing & Teaching</h2>
					<p class="text-xl text-gray-600 mb-8 font-sans">
						From Yale classrooms to The New York Times, sharing stories that matter.
					</p>
					
					<div class="space-y-6">
						<div class="flex gap-4">
							<div class="flex-shrink-0 w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
								<svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
								</svg>
							</div>
							<div>
								<h3 class="text-xl font-bold text-gray-900 font-sans">Yale University</h3>
								<p class="text-gray-600 font-sans">Teaching storytelling and narrative techniques</p>
							</div>
						</div>

						<div class="flex gap-4">
							<div class="flex-shrink-0 w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center">
								<svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
								</svg>
							</div>
							<div>
								<h3 class="text-xl font-bold text-gray-900 font-sans">Major Publications</h3>
								<p class="text-gray-600 font-sans">The New York Times, Rolling Stone, Harvard Business Review</p>
							</div>
						</div>

						<div class="flex gap-4">
							<div class="flex-shrink-0 w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center">
								<svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
								</svg>
							</div>
							<div>
								<h3 class="text-xl font-bold text-gray-900 font-sans">Psychology Today</h3>
								<p class="text-gray-600 font-sans">Former senior editor exploring human behavior</p>
							</div>
						</div>
					</div>
				</div>

				<div class="relative">
					<img
						src="/images/jay-dixit-about.jpg"
						alt="Jay Dixit"
						class="rounded-2xl shadow-2xl"
					/>
					<div class="absolute -bottom-8 -right-8 bg-gradient-to-r from-blue-500 to-purple-600 text-white p-8 rounded-2xl max-w-xs shadow-xl">
						<p class="text-6xl font-black mb-2">15+</p>
						<p class="text-lg font-sans">Years of Writing Experience</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- AI Work Section -->
	<section class="py-24 bg-[#f5f1e8]">
		<div class="max-w-7xl mx-auto px-6">
			<div class="max-w-3xl mb-14">
				<p class="text-xs uppercase tracking-[0.22em] text-neutral-500 font-semibold mb-3">AI Work</p>
				<h2 class="text-4xl md:text-5xl font-bold text-neutral-900 mb-5 leading-tight font-sans">
					Practical AI for writers, educators, and creative teams
				</h2>
				<p class="text-lg text-neutral-700 leading-relaxed font-sans">
					My focus is hands-on: helping people use AI as a thought partner without losing voice,
					judgment, or craft.
				</p>
			</div>

			<div class="grid lg:grid-cols-2 gap-8">
				<article class="rounded-2xl border border-neutral-300/80 bg-white p-8 shadow-sm">
					<div class="flex items-center justify-between gap-4 mb-6">
						<h3 class="text-2xl font-bold text-neutral-900 font-sans">Socratic AI</h3>
						<span class="text-xs uppercase tracking-[0.16em] font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-full px-3 py-1">
							Current
						</span>
					</div>
					<p class="text-sm uppercase tracking-[0.14em] text-neutral-500 font-semibold mb-5">
						Founder and Educator
					</p>
					<ul class="space-y-3 text-neutral-700 font-sans">
						<li class="border-l-2 border-neutral-200 pl-4">
							Design and lead AI education workshops for organizations
						</li>
						<li class="border-l-2 border-neutral-200 pl-4">
							Train teams to use AI for thinking, drafting, and revision
						</li>
						<li class="border-l-2 border-neutral-200 pl-4">
							Advise on practical, responsible AI adoption in creative workflows
						</li>
					</ul>
				</article>

				<article class="rounded-2xl border border-neutral-300/80 bg-white p-8 shadow-sm">
					<div class="flex items-center justify-between gap-4 mb-6">
						<h3 class="text-2xl font-bold text-neutral-900 font-sans">OpenAI</h3>
						<span class="text-xs uppercase tracking-[0.16em] font-semibold text-neutral-700 bg-neutral-100 border border-neutral-200 rounded-full px-3 py-1">
							Previous
						</span>
					</div>
					<p class="text-sm uppercase tracking-[0.14em] text-neutral-500 font-semibold mb-5">
						Community Lead
					</p>
					<ul class="space-y-3 text-neutral-700 font-sans">
						<li class="border-l-2 border-neutral-200 pl-4">Led the writing community</li>
						<li class="border-l-2 border-neutral-200 pl-4">
							Built educator-focused programs and resources
						</li>
						<li class="border-l-2 border-neutral-200 pl-4">
							Developed frameworks for creative and ethical AI use
						</li>
					</ul>
				</article>
			</div>
		</div>
	</section>

	<!-- Philosophy Quote - Editorial Serif Design -->
	<section class="py-32" style="background-color: var(--neutral-50);">
		<div class="max-w-4xl mx-auto px-6">
			<div class="flex flex-col md:flex-row gap-12 items-start">
				<!-- Elegant thin accent line -->
				<div class="hidden md:block w-px h-64 bg-neutral-300 mt-4"></div>
				
				<div class="flex-1">
					<blockquote class="text-3xl md:text-4xl lg:text-5xl font-serif italic text-neutral-900 leading-tight mb-10">
						"I believe in using technology and creativity to amplify human expression. Whether through a camera lens, the written word, or AI tools, my work focuses on revealing authentic human moments and helping others tell their stories more effectively."
					</blockquote>
					<div class="flex items-center gap-4">
						<div class="w-8 h-px bg-neutral-400"></div>
						<cite class="text-xl font-medium tracking-tight text-neutral-600 not-italic font-sans uppercase">Jay Dixit</cite>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Contact CTA -->
	<section class="py-24 bg-white">
		<div class="max-w-4xl mx-auto px-6 text-center">
			<h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6 font-sans">Let's Work Together</h2>
			<p class="text-xl text-gray-600 mb-12 font-sans">
				Based in New York City, available for photography assignments, writing projects, and AI education workshops worldwide.
			</p>
			<div class="flex gap-4 justify-center">
				<a href="mailto:jay@jaydixit.com" class="px-8 py-4 bg-gray-900 text-white rounded-full font-semibold hover:bg-gray-800 transition-all duration-300 transform hover:scale-105 shadow-lg">
					Get In Touch
				</a>
				<a href="/gallery" class="px-8 py-4 bg-gray-200 text-gray-800 rounded-full font-semibold hover:bg-gray-300 transition-all duration-300">
					View Portfolio
				</a>
			</div>
		</div>
	</section>
</MainLayout>

<style>
	@keyframes blob {
		0% {
			transform: translate(0px, 0px) scale(1);
		}
		33% {
			transform: translate(30px, -50px) scale(1.1);
		}
		66% {
			transform: translate(-20px, 20px) scale(0.9);
		}
		100% {
			transform: translate(0px, 0px) scale(1);
		}
	}

	.animate-blob {
		animation: blob 7s infinite;
	}

	.animation-delay-2000 {
		animation-delay: 2s;
	}

	.animation-delay-4000 {
		animation-delay: 4s;
	}
</style>
