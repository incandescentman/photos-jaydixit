---
import MainLayout from '../layouts/MainLayout.astro';
import RecognitionSection from '../components/RecognitionSection.astro';
---

<MainLayout>
	<div class="ed">
		<!-- Hero -->
		<section class="ed-hero">
			<div class="ed-shell">
				<p class="ed-kicker eyebrow">About</p>
				<h1 class="ed-h1">Why I Take Photos</h1>
			</div>
			<div class="ed-shell ed-shell--media">
				<img
					src="/images/jay-anisha-williamsburg_jay-dixit-photos_lighter.jpg"
					alt="Jay Dixit"
					class="ed-hero-img"
				/>
			</div>
		</section>

		<!-- Lead / bio -->
		<section class="ed-section">
			<div class="ed-shell">
				<div class="ed-lead">
					<p>
						I&rsquo;m a red carpet photographer for Wikipedia and the first photographer of the
						WikiPortraits initiative founded by Jennifer 8. Lee and Kevin Payravi. I&rsquo;ve
						covered the Nobel Prizes in Stockholm and Oslo, Sundance, SXSW, the Toronto
						International Film Festival, the New York Film Festival, and cultural events in New
						York, San Francisco, and Toronto.
					</p>
					<p>
						I&rsquo;m also a writer, writing professor, and AI educator. I taught storytelling at
						Yale. My work has appeared in The New York Times, Rolling Stone, The Washington Post,
						Wired, Harvard Business Review, and Psychology Today, where I was a senior editor. Most
						recently I worked at OpenAI, where I led the writing community.
					</p>
				</div>

				<div class="ed-essay">
					<p>As a writer, I relate to the world through words, stories, and ideas.</p>
					<p>But writing is static: It&rsquo;s sitting at a desk typing sentences on a screen.</p>
					<p>
						Photography, on the other hand, is embodied, visceral, spontaneous. After a day of
						staring at my screen until the words swim, I love how different it feels to grab my
						camera and start moving.
					</p>
					<p>
						With photography, particularly red carpet photography, I find myself huddling in the
						photo pit, crouching to get a better angle, literally running after a movie star calling
						her name, desperately trying to get her to turn around and look at my lens so I can get
						the shot.
					</p>
					<p>
						It&rsquo;s physical and chaotic and exhausting. Sometimes it almost feels like being a
						sniper, braced and still, peering through a long lens, waiting and breathing, finger on
						the shutter ready to fire the second the movie star looks your way.
					</p>
					<p>
						Like writing, photography is all craft and strategy. It&rsquo;s about making decisions,
						working hard to make it good. But I feel like I&rsquo;m using an entirely different part
						of my brain.
					</p>
					<p>
						It&rsquo;s also immediate gratification. If I write an article for a magazine, I miiight
						get an email weeks later when it&rsquo;s finally published. More likely I never hear
						about it again. But when I take a photo of someone, I can show it to them then and
						there. And if I&rsquo;m lucky they might even light up and say, &ldquo;Oh my god, I love
						it, wow you totally captured my personality!&rdquo;
					</p>
					<p>
						It&rsquo;s making someone feel seen, showing them the thing in the same moment the thing
						is created. That never happens with writing.
					</p>
				</div>

				<div class="ed-actions">
					<a href="/before-after" class="ed-btn ed-btn--solid">View My Work</a>
					<a href="/contact" class="ed-btn ed-btn--ghost">Get In Touch</a>
				</div>
			</div>
		</section>

		<!-- Photography -->
		<section id="photography" class="ed-section ed-section--tight">
			<div class="ed-shell ed-shell--wide">
				<header class="ed-block-head">
					<p class="ed-kicker eyebrow">Photography</p>
					<h2 class="ed-h2">Where I Shoot</h2>
					<p class="ed-block-intro">
						Red carpet photography for Wikipedia, shot at film festivals, Nobel ceremonies, and
						cultural events around the world.
					</p>
				</header>

				<div class="ed-cards">
					<a href="/gallery" class="ed-card">
						<h3 class="ed-card-title">Wikipedia Press</h3>
						<p class="ed-card-desc">Contributing high-quality portraits to improve Wikipedia.</p>
					</a>
					<a href="/gallery/events/nobel" class="ed-card">
						<h3 class="ed-card-title">Nobel Prizes</h3>
						<p class="ed-card-desc">Documenting laureates in Stockholm and Oslo.</p>
					</a>
					<a href="/gallery/red-carpet" class="ed-card">
						<h3 class="ed-card-title">Film Festivals</h3>
						<p class="ed-card-desc">Red carpet coverage at Sundance, SXSW, and TIFF.</p>
					</a>
					<a href="/blog/wikiportraits-story" class="ed-card">
						<h3 class="ed-card-title">WikiPortraits</h3>
						<p class="ed-card-desc">
							Contributing portraits that improve Wikipedia&rsquo;s celebrity articles.
						</p>
					</a>
				</div>
			</div>
		</section>

		<RecognitionSection />

		<!-- Philosophy quote -->
		<section class="ed-section ed-quote-section">
			<div class="ed-shell ed-shell--narrow">
				<div class="ed-quote">
					<div class="ed-quote-rule" aria-hidden="true"></div>
					<div>
						<blockquote class="ed-quote-text">
							&ldquo;The feeling I&rsquo;m chasing is that moment when I show someone a photo I just
							took and they say, &lsquo;Oh my God, I love this picture of me, you really captured
							who I am!&rsquo;&rdquo;
						</blockquote>
						<div class="ed-quote-cite">
							<span class="ed-quote-dash" aria-hidden="true"></span>
							<cite>Jay Dixit</cite>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Contact CTA -->
		<section class="ed-section">
			<div class="ed-shell ed-shell--narrow ed-center">
				<p class="ed-cta-text">
					Most people land here looking for my photos. But I also teach AI workshops, write, and do
					consulting. If you want to talk about photography, writing, or what AI can actually do for
					your team, I&rsquo;d love to hear from you.
				</p>
				<p class="ed-cta-route">
					My AI work lives at
					<a href="https://socraticai.co/" target="_blank" rel="noopener noreferrer"
						>socraticai.co</a
					>.
				</p>
				<div class="ed-actions ed-actions--center">
					<a href="/contact" class="ed-btn ed-btn--solid">Get In Touch</a>
					<a href="/gallery" class="ed-btn ed-btn--ghost">View Portfolio</a>
				</div>
			</div>
		</section>
	</div>
</MainLayout>

<style>
	.ed {
		background: var(--paper);
	}

	.ed-shell {
		max-width: 48rem;
		margin: 0 auto;
		padding: 0 2.5rem;
	}

	.ed-shell--media {
		max-width: 60rem;
	}

	.ed-shell--wide {
		max-width: 74rem;
	}

	.ed-shell--narrow {
		max-width: 46rem;
	}

	.ed-center {
		text-align: center;
	}

	/* Hero */
	.ed-hero {
		padding: var(--nav-clearance) 0 0;
	}

	.ed-kicker {
		margin: 0 0 1.3rem;
	}

	.ed-h1 {
		margin: 0 0 2.75rem;
		font-family: var(--serif);
		font-weight: 300;
		font-size: clamp(3rem, 6.5vw, 5rem);
		line-height: 1.02;
		letter-spacing: -0.015em;
		color: #161310;
	}

	.ed-hero-img {
		display: block;
		width: 100%;
		height: auto;
	}

	/* Sections */
	.ed-section {
		padding: 5.5rem 0;
	}

	.ed-section--tight {
		padding-top: 4rem;
	}

	/* Lead */
	.ed-lead {
		display: grid;
		gap: 1.5rem;
		padding-bottom: 3rem;
		border-bottom: 1px solid var(--hairline);
		margin-bottom: 3rem;
	}

	.ed-lead p {
		margin: 0;
		font-family: var(--serif);
		font-weight: 300;
		font-size: 1.5rem;
		line-height: 1.5;
		letter-spacing: -0.01em;
		color: #2a2620;
	}

	/* Essay */
	.ed-essay {
		display: grid;
		gap: 1.5rem;
	}

	.ed-essay p {
		margin: 0;
		font-family: var(--serif);
		font-weight: 300;
		font-size: 1.5rem;
		line-height: 1.5;
		color: #3a352e;
	}

	/* Buttons */
	.ed-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.875rem;
		margin-top: 3rem;
	}

	.ed-actions--center {
		justify-content: center;
		margin-top: 2.5rem;
	}

	.ed-btn {
		display: inline-flex;
		align-items: center;
		padding: 0.85rem 1.7rem;
		font-family: var(--sans);
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		text-decoration: none;
		border-radius: 2px;
		transition:
			background-color 0.25s ease,
			color 0.25s ease,
			border-color 0.25s ease;
	}

	.ed-btn--solid {
		background: var(--ink);
		color: #faf9f6;
		border: 1px solid var(--ink);
	}

	.ed-btn--solid:hover {
		background: #000;
	}

	.ed-btn--ghost {
		background: transparent;
		color: var(--ink);
		border: 1px solid #cfc8bb;
	}

	.ed-btn--ghost:hover {
		border-color: var(--ink);
	}

	/* Block headers */
	.ed-block-head {
		max-width: 40rem;
		margin: 0 auto 3.25rem;
		text-align: center;
	}

	.ed-h2 {
		margin: 0;
		font-family: var(--serif);
		font-weight: 400;
		font-size: clamp(2rem, 4vw, 3rem);
		line-height: 1.08;
		letter-spacing: -0.015em;
		color: #161310;
	}

	.ed-block-intro {
		margin: 1.25rem auto 0;
		font-family: var(--sans);
		font-size: 1.05rem;
		line-height: 1.6;
		color: #5c554c;
	}

	.ed-block-head .ed-block-intro {
		max-width: 36rem;
	}

	/* Category cards */
	.ed-cards {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.25rem;
	}

	.ed-card {
		display: block;
		padding: 1.75rem;
		border: 1px solid var(--hairline);
		background: #fff;
		text-decoration: none;
		transition:
			border-color 0.25s ease,
			transform 0.25s ease;
	}

	.ed-card:hover {
		border-color: var(--ink);
		transform: translateY(-3px);
	}

	.ed-card-title {
		margin: 0 0 0.6rem;
		font-family: var(--serif);
		font-weight: 400;
		font-size: 1.3rem;
		line-height: 1.1;
		color: #161310;
	}

	.ed-card-desc {
		margin: 0;
		font-family: var(--sans);
		font-size: 0.88rem;
		line-height: 1.5;
		color: #6e675c;
	}

	/* Philosophy quote */
	.ed-quote-section {
		background: var(--paper-deep);
		border-top: 1px solid var(--hairline);
		border-bottom: 1px solid var(--hairline);
		padding: 7rem 0;
	}

	.ed-quote {
		display: flex;
		gap: 3rem;
		align-items: flex-start;
	}

	.ed-quote-rule {
		flex-shrink: 0;
		width: 1px;
		height: 16rem;
		background: #cfc6b3;
		margin-top: 0.5rem;
	}

	.ed-quote-text {
		margin: 0 0 2rem;
		font-family: var(--serif);
		font-weight: 300;
		font-style: italic;
		font-size: clamp(1.75rem, 3.6vw, 2.9rem);
		line-height: 1.25;
		letter-spacing: -0.015em;
		color: #1c1813;
	}

	.ed-quote-cite {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.ed-quote-dash {
		width: 2rem;
		height: 1px;
		background: #a89e8a;
	}

	.ed-quote-cite cite {
		font-family: var(--sans);
		font-style: normal;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: #6e675c;
	}

	/* Contact CTA */
	.ed-cta-text {
		margin: 0;
		font-family: var(--serif);
		font-weight: 300;
		font-size: clamp(1.6rem, 3.2vw, 2.25rem);
		line-height: 1.35;
		letter-spacing: -0.01em;
		color: #2a2620;
	}

	.ed-cta-route {
		margin: 1.4rem 0 0;
		font-family: var(--sans);
		font-size: 1rem;
		line-height: 1.6;
		color: #5c554c;
	}

	.ed-cta-route a {
		color: var(--ink);
		font-weight: 600;
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.24em;
	}

	/* Responsive */
	@media (max-width: 900px) {
		.ed-cards {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 767px) {
		.ed-shell,
		.ed-shell--wide,
		.ed-shell--narrow,
		.ed-shell--media {
			padding: 0 1.5rem;
		}

		.ed-lead p {
			font-size: 1.3rem;
		}

		.ed-essay p {
			font-size: 1.3rem;
		}

		.ed-quote {
			gap: 1.5rem;
		}

		.ed-quote-rule {
			display: none;
		}

		.ed-cards {
			grid-template-columns: 1fr;
		}
	}
</style>
