---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro:assets';
import MainLayout from '../../layouts/MainLayout.astro';
import siteConfig from '../../../site.config.mts';

type GallerySourcePhoto = {
	metadata: ImageMetadata;
	filename: string;
};

type GalleryEntry = {
	name: string;
	displayName: string;
	sampleImage: ImageMetadata;
	sampleFilename: string;
	url: string;
	category: string;
};

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
	'../../gallery/photos/**/*.{jpg,jpeg,png,gif}',
	{ eager: true },
);

// Positions belong to specific photographs, not folders that may get a new cover.
const coverFocalPoints: Record<string, string> = {
	'events/nobel/john-hopfield_nobel-physics_2024.jpg': '50% 0%',
	'events/nobel-prizes-2024/anti-nuclear-campaigners_nobel-peace-prize-torchlight-procession-oslo_2024.jpg':
		'50% 50%',
	'events/sxsw-2026/jack-johnson_sxsw_2026_01.jpg': '50% 50%',
	'portraits/studio/dave-franco_sundance_2025.jpg': '50% 0%',
	'red-carpet/sundance/conan-obrien_sundance_2024.jpg': '50% 28%',
	'red-carpet/sxsw/judd-apatow_sxsw_2024.jpg': '50% 0%',
	'red-carpet/tiff/jason-bateman-jude-law-09836_tiff_2025.jpg': '40% 50%',
};

function formatWord(word: string) {
	const normalized = word.toLowerCase();
	const acronymMap: Record<string, string> = {
		sxsw: 'SXSW',
		tiff: 'TIFF',
		nyff: 'NYFF',
		ucb: 'UCB',
		wikiportraits: 'WikiPortraits',
	};

	if (acronymMap[normalized]) return acronymMap[normalized];
	return normalized.charAt(0).toUpperCase() + normalized.slice(1);
}

function formatPhrase(slug: string) {
	return slug
		.split(/[\s-]+/)
		.filter(Boolean)
		.map(formatWord)
		.join(' ');
}

const grouped = new Map<string, GallerySourcePhoto[]>();

Object.entries(imageModules).forEach(([key, module]) => {
	const relativePath = key.replace('../../gallery/photos/', '');
	const segments = relativePath.split('/');
	const filename = segments.pop();
	const folder = segments.join('/');
	if (!folder || !filename) return;

	if (!grouped.has(folder)) {
		grouped.set(folder, []);
	}

	grouped.get(folder)?.push({ metadata: module.default, filename });
});

const galleryEntries = await Promise.all(
	Array.from(grouped.entries()).map(async ([folder, images]) => {
		const sample = images[0];
		if (!sample) return null;

		const leafFolder = folder.split('/').at(-1) ?? folder;
		const entry: GalleryEntry = {
			name: folder,
			displayName: formatPhrase(leafFolder),
			sampleImage: sample.metadata,
			sampleFilename: sample.filename,
			url: `/gallery/${folder}`,
			category: folder.split('/')[0] ?? 'other',
		};

		return entry;
	}),
);

const galleries = galleryEntries.filter((entry): entry is GalleryEntry => entry !== null);

const categorizedGalleries = galleries.reduce<Record<string, GalleryEntry[]>>((acc, gallery) => {
	const category = gallery.category;
	if (!acc[category]) acc[category] = [];
	acc[category].push(gallery);
	return acc;
}, {});

const siteUrl = Astro.site?.origin ?? siteConfig.siteUrl ?? 'https://photos.jaydixit.com';
const canonicalUrl = new URL('/gallery/', siteUrl).toString();
const pageDescription = 'Browse photography galleries by theme and event.';
const galleryIndexStructuredData = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: `Photo Galleries — ${siteConfig.owner}`,
	description: pageDescription,
	url: canonicalUrl,
	hasPart: galleries.map((gallery) => ({
		'@type': 'ImageGallery',
		name: gallery.displayName,
		url: new URL(gallery.url, siteUrl).toString(),
	})),
};
---

<MainLayout
	title="Photo Galleries"
	description={pageDescription}
	canonical={canonicalUrl}
	structuredData={galleryIndexStructuredData}
>
	<div class="gallery-index pt-(--nav-clearance)">
		<header class="gallery-index-header">
			<p class="gallery-kicker">Collections</p>
			<h1>Photo Galleries</h1>
			<p>Browse my photography collections organized by theme and event</p>
		</header>

		{
			Object.keys(categorizedGalleries).length > 0 ? (
				<div id="gallery-directory" class="gallery-directory">
					{Object.entries(categorizedGalleries).map(
						([category, categoryGalleries], categoryIndex) => (
							<section class="gallery-category" aria-labelledby={`gallery-category-${category}`}>
								<h2 id={`gallery-category-${category}`}>{formatPhrase(category)}</h2>

								<div class="gallery-cover-grid">
									{categoryGalleries.map((gallery, galleryIndex) => (
										<article class="gallery-cover">
											<a
												class="gallery-cover-photo"
												style={`--cover-position: ${coverFocalPoints[`${gallery.name}/${gallery.sampleFilename}`] ?? '50% 50%'}`}
												href={gallery.url}
												aria-label={`View the ${gallery.displayName} gallery`}
												data-gallery-cover-photo
											>
												<Image
													src={gallery.sampleImage}
													alt={gallery.displayName}
													width={960}
													widths={[480, 720, 960, 1440]}
													sizes="(max-width: 700px) calc(100vw - 2rem), (max-width: 1670px) 45vw, 744px"
													loading={categoryIndex === 0 && galleryIndex < 2 ? 'eager' : 'lazy'}
													fetchpriority={
														categoryIndex === 0 && galleryIndex < 2 ? 'high' : undefined
													}
												/>
											</a>

											<h3>
												<a href={gallery.url}>{gallery.displayName}</a>
											</h3>
										</article>
									))}
								</div>
							</section>
						),
					)}
				</div>
			) : (
				<div class="gallery-empty">
					<h2>No galleries found</h2>
					<p>New galleries coming soon.</p>
				</div>
			)
		}
	</div>
</MainLayout>

<style>
	:global(body) {
		background: var(--paper);
		color: var(--ink);
	}

	.gallery-index {
		padding-top: var(--portfolio-header-clearance);
		min-height: 100vh;
		padding-bottom: clamp(5rem, 10vw, 9rem);
		background:
			radial-gradient(circle at 8% 12%, rgb(150 119 63 / 7%), transparent 32rem), var(--paper);
	}

	.gallery-index-header,
	.gallery-directory,
	.gallery-empty {
		width: min(100% - clamp(2rem, 8vw, 9rem), 96rem);
		margin-inline: auto;
	}

	.gallery-index-header {
		padding: clamp(1.5rem, 3vw, 3rem) 0 2rem;
		border-bottom: 1px solid var(--ink);
	}

	.gallery-kicker {
		margin: 0 0 1rem;
		color: var(--accent);
		font-family: var(--sans);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.gallery-index-header h1 {
		max-width: 12ch;
		margin: 0;
		font-family: var(--serif);
		font-size: clamp(3.75rem, 6.5vw, 6.5rem);
		font-weight: 400;
		letter-spacing: -0.06em;
		line-height: 0.82;
	}

	.gallery-index-header > p:last-child {
		max-width: 40rem;
		margin: clamp(1.5rem, 3vw, 2.5rem) 0 0;
		color: rgb(26 23 20 / 68%);
		font-family: var(--serif);
		font-size: clamp(1.15rem, 1.7vw, 1.5rem);
		font-weight: 300;
		line-height: 1.35;
	}

	.gallery-category {
		padding-top: clamp(1.75rem, 3vw, 2.5rem);
	}

	.gallery-category > h2 {
		margin: 0 0 1.2rem;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid var(--hairline);
		color: rgb(26 23 20 / 62%);
		font-family: var(--sans);
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.15em;
		text-transform: uppercase;
	}

	.gallery-cover-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(2.25rem, 5vw, 5.5rem) clamp(1.5rem, 3vw, 3rem);
	}

	.gallery-cover {
		min-width: 0;
	}

	.gallery-cover-photo {
		display: block;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		background: var(--paper-deep);
		transition: box-shadow 180ms ease;
	}

	.gallery-cover-photo img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: var(--cover-position, 50% 50%);
	}

	.gallery-cover-photo:hover,
	.gallery-cover-photo:focus-visible {
		box-shadow: 0 0 0 2px var(--accent);
	}

	.gallery-cover h3 {
		margin: 0;
		border-bottom: 1px solid var(--hairline);
	}

	.gallery-cover h3 a {
		display: block;
		padding: 1rem 0 0.85rem;
		color: var(--ink);
		font-family: var(--serif);
		font-size: clamp(1.45rem, 2.4vw, 2.2rem);
		font-weight: 400;
		letter-spacing: -0.025em;
		line-height: 1.05;
		text-decoration: none;
		transition: color 180ms ease;
	}

	.gallery-cover h3 a:hover,
	.gallery-cover h3 a:focus-visible {
		color: var(--accent);
	}

	.gallery-empty {
		padding-block: 6rem;
		text-align: center;
	}

	.gallery-empty h2 {
		font-family: var(--serif);
		font-weight: 400;
	}

	.gallery-empty p {
		color: rgb(26 23 20 / 62%);
	}

	@media (max-width: 700px) {
		.gallery-index-header,
		.gallery-directory,
		.gallery-empty {
			width: min(100% - 2rem, 96rem);
		}

		.gallery-index-header h1 {
			font-size: clamp(3.25rem, 14vw, 5rem);
		}

		.gallery-cover-grid {
			grid-template-columns: 1fr;
		}

		.gallery-cover-photo {
			aspect-ratio: auto;
		}

		.gallery-cover-photo img {
			height: auto;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.gallery-cover-photo,
		.gallery-cover h3 a {
			transition: none;
		}
	}
</style>
